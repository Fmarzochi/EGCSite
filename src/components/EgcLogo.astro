---
export interface Props {
  size?: number;
  class?: string;
  variant?: 'green' | 'white' | 'dark' | 'gradient';
}

const { size = 28, class: className = '', variant = 'white' } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 28 28" class={className} aria-hidden="true">
  {variant === 'gradient' ? (
    <>
      <defs>
        <linearGradient id="egcLogoLeaf" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#B9FFD9" />
          <stop offset="0.5" stop-color="#3DF59A" />
          <stop offset="1" stop-color="#0A8F4E" />
        </linearGradient>
      </defs>
      <g fill="url(#egcLogoLeaf)">
        <circle cx="14" cy="8" r="5.5" />
        <circle cx="20" cy="14" r="5.5" />
        <circle cx="14" cy="20" r="5.5" />
        <circle cx="8" cy="14" r="5.5" />
      </g>
      <circle cx="14" cy="14" r="1.6" fill="#07311D" />
    </>
  ) : (
    <>
      <g fill={variant === 'green' ? '#10B866' : variant === 'dark' ? '#0C0F0E' : '#F3F6F4'}>
        <circle cx="14" cy="8" r="5.5" />
        <circle cx="20" cy="14" r="5.5" />
        <circle cx="14" cy="20" r="5.5" />
        <circle cx="8" cy="14" r="5.5" />
      </g>
      <circle cx="14" cy="14" r="1.6" fill={variant === 'dark' ? '#F3F6F4' : '#0C0F0E'} />
    </>
  )}
</svg>
