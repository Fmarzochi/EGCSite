---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getBase } from '../utils/base.ts';
import { fetchContributors, buildFallback, getChampionHistory, BADGE_DEFS, TIER_CONFIG, highlights, type Contributor } from '../data/contributors.ts';

const base = getBase();
const profileHref = (login: string) => Object.hasOwn(highlights, login) ? `${base}contributors/${encodeURIComponent(login)}` : `https://github.com/${encodeURIComponent(login)}`;
const external = (login: string) => !Object.hasOwn(highlights, login);
const target = (login: string) => external(login) ? '_blank' : undefined;
const rel = (login: string) => external(login) ? 'noopener noreferrer' : undefined;
const areas = (c: Contributor) => c.badges.map(key => BADGE_DEFS[key]?.label).filter(Boolean).join(', ');
const initials = (name: string) => {
  const words = name.match(/[\p{L}\p{N}]+/gu) ?? [];
  return ((words[0]?.[0] ?? '?') + (words[1]?.[0] ?? words[0]?.[1] ?? '')).toUpperCase();
};
let contributors: Contributor[];
try {
  const result = await fetchContributors(import.meta.env.GITHUB_TOKEN);
  contributors = result.contributors;
} catch {
  contributors = buildFallback();
}
const pastChampions = getChampionHistory();
const rankedContributors = [...contributors].sort((a, b) => b.commits - a.commits || b.additions - a.additions);
const podium = rankedContributors.slice(0, 3);
const podiumRank = (login: string) => rankedContributors.findIndex(c => c.login === login) + 1;
const medal = (rank: number) => rank === 1 ? 'Gold' : rank === 2 ? 'Silver' : 'Bronze';
const position = (rank: number) => `${rank}${rank === 1 ? 'st' : rank === 2 ? 'nd' : 'rd'} place`;
const totalCommits = contributors.reduce((sum, c) => sum + c.commits, 0);
const totalAdditions = contributors.reduce((sum, c) => sum + c.additions, 0);
const totalPrs = contributors.reduce((sum, c) => sum + c.prs, 0);
const allPrsKnown = contributors.every(c => Object.hasOwn(highlights, c.login));
const tiers = Object.entries(TIER_CONFIG) as [keyof typeof TIER_CONFIG, typeof TIER_CONFIG[keyof typeof TIER_CONFIG]][];
const PAGE_SIZE = 10;
---
<Base title="Hall of Fame · EGC" description="The developers who shaped EGC. Every commit, every bug fix, every translation, permanently recognized.">
  <Navbar />
  <main id="main-content" class="hall">
    <p id="hype-status" class="sr-only" role="status" aria-live="polite"></p>
    <div class="wrap intro hall-hero">
      <div class="hall-star" aria-hidden="true">★</div>
      <div class="kicker">The people behind the project</div>
      <h1>Built by people.<br /><span>Remembered by EGC.</span></h1>
      <p class="lead">A permanent place for the contributors who turn ideas into working software — one issue, review, and pull request at a time.</p>
      <div class="stats" role="list">
        <div class="stat" role="listitem"><b>{contributors.length}</b><span>Contributors</span></div>
        <div class="stat" role="listitem"><b>{totalCommits || '—'}</b><span>Commits</span></div>
        <div class="stat" role="listitem"><b>{totalAdditions > 0 ? `+${totalAdditions.toLocaleString('en-US')}` : '—'}</b><span>Lines added</span></div>
        <div class="stat" role="listitem"><b>{allPrsKnown ? totalPrs : '—'}</b><span>Pull requests merged</span></div>
      </div>
    </div>
    {podium.length > 0 && <section class="wrap podium-section" aria-labelledby="podium-title">
      <div class="sec-head"><div><div class="kicker">Recognition</div><h2 id="podium-title">Top contributors</h2></div><p>Ranked by merged commits, then lines added.</p></div>
      <div class="podium">{podium.map(c => {
        const rank = podiumRank(c.login);
        return <div class={`podium-entry podium-${medal(rank).toLowerCase()}`} data-rank={rank}><article class="podium-person" aria-label={`${position(rank)}: ${c.name}, ${medal(rank)} medal`}>
          <div class="podium-medal" aria-hidden="true">{rank}</div>
          <p class="podium-rank">{position(rank)} <span aria-hidden="true">·</span> {medal(rank)}</p>
          <span class="av podium-avatar" data-i={initials(c.name)}><img src={c.avatar} alt="" width="80" height="80" loading="lazy" /></span>
          <h3 class="podium-name"><a class="podium-link" href={profileHref(c.login)} target={target(c.login)} rel={rel(c.login)}><span class="sr-only">{position(rank)}, {medal(rank)} medal: </span>{c.name}<span class="sr-only">, view contributor profile{external(c.login) ? ' on GitHub (opens in new tab)' : ''}</span></a></h3>
          <span class="podium-handle">@{c.login}</span>
          <span class={`podium-tier t-${c.tier}`}>{TIER_CONFIG[c.tier].label}</span>
          {c.badges.length > 0 && <div class="podium-badges" aria-label="Specialty badges">{c.badges.map(key => BADGE_DEFS[key] && <span class="podium-badge">{BADGE_DEFS[key].icon} {BADGE_DEFS[key].label}</span>)}</div>}
          <span class="podium-profile-cue" aria-hidden="true">View contributor profile ↗</span>
          <div class="podium-bottom"><span class="podium-commits"><strong>{c.commits}</strong> commits</span><button type="button" class="hype-btn" data-hype={c.login} data-name={c.name} aria-label={`Hype ${c.name}`} title="Hype this contributor (1 hype a day)">Hype <span class="hype-count" aria-hidden="true">—</span></button></div>
        </article><div class="podium-step" aria-hidden="true">{rank}</div></div>;
      })}</div>
    </section>}
    <section class="wrap" aria-labelledby="all-title">
      <div class="sec-head"><div><div class="kicker">All contributors</div><h2 id="all-title">Everyone who shipped</h2></div><p id="count" role="status" aria-live="polite">{contributors.length} of {contributors.length} contributors</p></div>
      <div class="tools">
        <label class="sr-only" for="contributor-search">Search contributors by name, login or area</label>
        <input class="search" id="contributor-search" type="search" placeholder="Search by name, handle or area" aria-controls="contributor-rows" />
        <div class="seg" role="group" aria-label="Filter by tier" id="tier-filter">
          <button type="button" data-tier="all" aria-pressed="true">All</button>
          {tiers.map(([key]) => <button type="button" data-tier={key} aria-pressed="false">{key === 'core' ? 'Core' : key[0].toUpperCase() + key.slice(1)}</button>)}
        </div>
        <div class="mobile-sort">
          <label for="mobile-sort-key">Sort by</label>
          <select id="mobile-sort-key" aria-controls="contributor-rows">
            <option value="commits">Commits</option>
            <option value="prs">PRs</option>
            <option value="additions">Lines</option>
          </select>
          <button type="button" id="mobile-sort-direction" aria-controls="contributor-rows" aria-label="Currently descending; switch to ascending">Descending ↓</button>
          <span id="mobile-sort-status" class="sr-only" role="status"></span>
        </div>
      </div>
      <table>
        <thead><tr>
          <th scope="col">#</th><th scope="col">Contributor</th><th scope="col">Tier</th><th scope="col">Areas</th>
          <th scope="col" class="num" data-key="commits" aria-sort="descending"><button type="button">Commits</button></th>
          <th scope="col" class="num" data-key="prs"><button type="button">PRs</button></th>
          <th scope="col" class="num" data-key="additions"><button type="button">Lines</button></th>
        </tr></thead>
        <tbody id="contributor-rows">
          {rankedContributors.map((c, index) => <tr data-index={index} data-tier={c.tier} data-name={c.name.toLocaleLowerCase()} data-login={c.login.toLocaleLowerCase()} data-areas={areas(c).toLocaleLowerCase()} data-commits={c.commits} data-prs={Object.hasOwn(highlights, c.login) ? c.prs : ''} data-additions={c.additions}>
            <td class="rk">{String(index + 1).padStart(2, '0')}</td>
            <td><div class="who">
              <a class="who-link" href={profileHref(c.login)} target={target(c.login)} rel={rel(c.login)}>
                <span class="av row-avatar" data-i={initials(c.name)}><img src={c.avatar} alt="" width="36" height="36" loading="lazy" /></span>
                <span class="who-text"><b>{c.name}</b><span class="handle">@{c.login}</span>{external(c.login) && <span class="sr-only">Opens GitHub in a new tab.</span>}</span>
              </a>
              <button type="button" class="hype-btn" data-hype={c.login} data-name={c.name} aria-label={`Hype ${c.name}`} title="Hype this contributor (1 hype a day)">Hype <span class="hype-count" aria-hidden="true">—</span></button>
            </div></td>
            <td><span class={`tier t-${c.tier}`}>{TIER_CONFIG[c.tier].label}</span></td>
            <td class="areas">{areas(c) || '—'}</td>
            <td class="num" data-label="Commits">{c.commits}</td><td class="num" data-label="PRs">{Object.hasOwn(highlights, c.login) ? c.prs : '—'}</td><td class="num" data-label="Lines">+{c.additions.toLocaleString('en-US')}</td>
          </tr>)}
          <tr id="empty-row" hidden><td colspan="7" class="empty">No contributor matches this search.</td></tr>
        </tbody>
      </table>
      <nav class="contributor-pagination" id="contributor-pagination" data-page-size={PAGE_SIZE} aria-label="Contributor pagination" hidden>
        <button type="button" id="page-previous" aria-controls="contributor-rows" disabled>Previous</button>
        <div class="pagination-pages">{Array.from({ length: Math.ceil(contributors.length / PAGE_SIZE) }, (_, index) => <button type="button" data-page={index + 1} aria-label={`Page ${index + 1}`} aria-controls="contributor-rows">{index + 1}</button>)}</div>
        <button type="button" id="page-next" aria-controls="contributor-rows">Next</button>
      </nav>
      <div class="legend">{tiers.map(([key, config]) => <div><b class={`tier t-${key}`}>{config.label}</b><p>{key === 'community' ? 'Fewer than two commits.' : `${config.minCommits} or more commits.`}</p></div>)}</div>
    </section>
    {pastChampions.length > 0 && <section class="wrap past" aria-labelledby="past-title">
      <div class="sec-head"><div><div class="kicker">A living archive</div><h2 id="past-title">Past champions</h2></div><p>Recognition remains discoverable beyond the current month.</p></div>
      <div class="champs">{pastChampions.map(h => (
        <a class="champ" href={profileHref(h.login)} target={target(h.login)} rel={rel(h.login)} aria-label={`View ${h.name}, ${h.month}${external(h.login) ? ' on GitHub (opens in new tab)' : ''}`} aria-describedby={`recognition-${h.login}-${h.month.replace(/\W/g, '-')}`}>
          <span class="av champ-avatar" data-i={initials(h.name)}><img src={`https://github.com/${encodeURIComponent(h.login)}.png`} alt="" width="56" height="56" loading="lazy" /></span>
          <span><span class="m">{h.month}</span><b>{h.name}</b><span class="champ-reason" id={`recognition-${h.login}-${h.month.replace(/\W/g, '-')}`}>{h.reason}</span></span>
        </a>
      ))}</div>
    </section>}
    <section class="wrap"><div class="cta"><h2>Your name belongs on this page.</h2><div><p>Pick an open issue, ship the fix, and you are in the Hall of Fame for good.</p><div class="cta-actions"><a class="btn btn-light" href="https://github.com/Fmarzochi/EGC/issues" target="_blank" rel="noopener noreferrer">Browse open issues <span class="sr-only">(opens in new tab)</span></a><a class="btn btn-line" href="https://github.com/Fmarzochi/EGC/blob/main/.github/CONTRIBUTING.md" target="_blank" rel="noopener noreferrer">Contributing guide <span class="sr-only">(opens in new tab)</span></a></div></div></div></section>
    <section class="wrap sponsor-section" aria-labelledby="sponsor-title">
      <div class="sec-head"><div><div class="kicker">Sponsors</div><h2 id="sponsor-title">Keeping EGC moving</h2></div><div class="sponsor-actions"><a class="btn btn-primary" href="https://github.com/sponsors/Fmarzochi" target="_blank" rel="noopener noreferrer">GitHub Sponsors <span class="sr-only">(opens in new tab)</span></a><a class="btn btn-ghost" href="https://www.paypal.com/donate/?business=fmarzochi%40gmail.com&currency_code=USD" target="_blank" rel="noopener noreferrer">PayPal <span class="sr-only">(opens in new tab)</span></a></div></div>
      <div class="sponsors"><div><h3>Tool partners</h3><a href="https://www.pincushion.io/" target="_blank" rel="noopener noreferrer">Pincushion <span class="sr-only">(opens in new tab)</span></a></div><div><h3>Backers</h3><a href="https://github.com/chizormaangel-commits" target="_blank" rel="noopener noreferrer">@chizormaangel-commits <span class="sr-only">(opens in new tab)</span></a></div><div><h3>Monthly sponsors</h3><p>Open. <a href="https://github.com/sponsors/Fmarzochi" target="_blank" rel="noopener noreferrer">Become the first. <span class="sr-only">(opens in new tab)</span></a></p></div></div>
    </section>
  </main>
  <Footer />

  <style>

.hall{
  --ground:#0C0F0E; --surface:#141816; --soft:#1B2420; --line:#1E2421; --line-strong:#6B7770;
  --ink:#F3F6F4; --muted:#A3ADA7; --subtle:#8C9690;
  --signal:#3DF59A; --action:#10B866; --deep:#0B7A44; --forest:#052818; --on-green:#04200F;
  --sans:"Plus Jakarta Sans","Helvetica Neue",Arial,sans-serif; --mono:"JetBrains Mono",ui-monospace,Menlo,monospace;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--ground);color:var(--ink);font-family:var(--sans);font-size:16px;line-height:1.6;-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}
a:focus-visible,button:focus-visible,input:focus-visible,summary:focus-visible{outline:2px solid var(--signal);outline-offset:2px;border-radius:6px}
.wrap{max-width:1180px;margin:0 auto;padding:0 32px}
.skip{position:absolute;left:-9999px}.skip:focus{left:16px;top:16px;background:var(--ink);color:var(--ground);padding:8px 12px;z-index:10}

.av{position:relative;display:inline-flex;align-items:center;justify-content:center;flex:none;overflow:hidden;background:var(--soft);color:var(--muted);font-weight:700;letter-spacing:-.02em;font-family:var(--sans)}
.av::before{content:attr(data-i)}
span.av img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;border:0;border-radius:0;background:transparent}
/* nav */
header.nav{border-bottom:1px solid var(--line)}
header.nav .wrap{display:flex;align-items:center;justify-content:space-between;gap:24px;height:72px}
.brand{display:flex;align-items:center;gap:10px;font-weight:800;font-size:20px;letter-spacing:-.02em}
.links{display:flex;gap:28px;font-size:14px;font-weight:500;color:var(--muted)}
.links a:hover{color:var(--ink)}
.links a[aria-current]{color:var(--ink)}
.btn{display:inline-flex;align-items:center;gap:10px;min-height:44px;padding:0 20px;border-radius:999px;font-weight:700;font-size:14px;white-space:nowrap}
.btn-primary{background:var(--action);color:var(--on-green)}
.btn-ghost{border:1px solid var(--line-strong);color:var(--ink);font-weight:600}
.btn-ghost:hover{border-color:var(--ink)}

/* intro */
.intro{padding:96px 0 64px}
.kicker{font-size:13px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--signal)}
.intro h1{margin:16px 0 0;font-weight:800;font-size:clamp(44px,6.4vw,84px);line-height:1;letter-spacing:-.045em;max-width:13ch}
.intro-grid{display:grid;grid-template-columns:1.2fr 1fr;gap:64px;align-items:end}
.intro p.lead{margin:0;font-size:19px;color:var(--muted);max-width:44ch}
.stats{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--line);border-bottom:1px solid var(--line);margin-top:64px}
.stat{padding:28px 0 28px 24px;border-left:1px solid var(--line)}
.stat:first-child{border-left:0;padding-left:0}
.stat b{display:block;font-size:40px;font-weight:800;letter-spacing:-.03em;line-height:1.1;font-variant-numeric:tabular-nums}
.stat span{font-size:14px;color:var(--subtle)}

/* section heads */
section.wrap{padding-top:88px;padding-bottom:0}
main > section.wrap:last-of-type{padding-bottom:88px}
.sec-head{display:flex;justify-content:space-between;align-items:end;gap:24px;margin-bottom:32px;flex-wrap:wrap}
.sec-head h2{margin:8px 0 0;font-size:clamp(28px,3.4vw,40px);font-weight:800;letter-spacing:-.035em;line-height:1.1}
.sec-head p{margin:0;color:var(--muted);max-width:46ch}

/* spotlight */
.spot{display:grid;grid-template-columns:320px 1fr;border-radius:32px;overflow:hidden;background:var(--surface)}
.spot-side{background:radial-gradient(120% 90% at 30% 0%,#12B566 0%,#08633A 45%,var(--forest) 100%);padding:40px;display:flex;flex-direction:column;gap:28px}
.spot-side img{width:120px;height:120px;border-radius:24px;object-fit:cover;background:var(--forest);border:3px solid rgba(243,246,244,.9)}
.spot-side .month{font-size:13px;font-weight:700;letter-spacing:.08em;text-transform:uppercase}
.spot-side h3{margin:6px 0 0;font-size:34px;font-weight:800;letter-spacing:-.03em;line-height:1.05}
.spot-side .handle{font-family:var(--mono);font-size:14px;opacity:.85}
.facts{margin:auto 0 0;padding:0;list-style:none;display:grid;grid-template-columns:1fr 1fr;gap:16px}
.facts b{display:block;font-size:24px;font-weight:800;letter-spacing:-.02em}
.facts span{font-size:13px;opacity:.85}
.spot-main{padding:44px 48px;display:flex;flex-direction:column;gap:24px}
.spot-main .summary{margin:0;font-size:21px;line-height:1.5;font-weight:500;max-width:52ch}
.role{display:inline-flex;align-self:flex-start;gap:8px;align-items:center;padding:6px 14px;border-radius:999px;border:1px solid var(--line-strong);font-size:13px;font-weight:600;color:var(--ink)}
.role i{width:8px;height:8px;border-radius:99px;background:var(--signal)}
.prs{display:flex;flex-wrap:wrap;gap:8px}
.prs a{font-family:var(--mono);font-size:13px;padding:6px 12px;border-radius:10px;background:var(--soft);color:var(--muted)}
.prs a:hover{color:var(--signal)}
details{border-top:1px solid var(--line);padding-top:20px}
summary{cursor:pointer;font-weight:700;font-size:15px;color:var(--signal);list-style:none;display:inline-flex;gap:8px;align-items:center}
summary::-webkit-details-marker{display:none}
summary::after{content:"+";font-size:18px;line-height:1}
details[open] summary::after{content:"−"}
details .story{margin-top:16px;color:var(--muted);font-size:15px;line-height:1.75;max-height:420px;overflow:auto;padding-right:12px}
.spot-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:auto}

/* champions */
.champs{display:grid;grid-template-columns:repeat(2,1fr);gap:20px;margin-top:20px}
.champ{display:grid;grid-template-columns:56px 1fr;gap:18px;align-items:start;padding:24px;border-radius:24px;border:1px solid var(--line)}
.champ:hover{border-color:var(--line-strong)}
.champ img{width:56px;height:56px;border-radius:16px;background:var(--soft)}
.champ .m{font-size:13px;color:var(--subtle)}
.champ b{display:block;font-size:18px;font-weight:700}
.champ p{margin:6px 0 0;font-size:14px;color:var(--muted);line-height:1.55}

/* maintainers */
.core{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.core a{display:flex;flex-direction:column;gap:14px;padding:28px;border-radius:28px;background:var(--surface);min-height:250px}
.core a:hover{background:var(--soft)}
.core img{width:64px;height:64px;border-radius:18px;background:var(--soft)}
.core .rank{font-family:var(--mono);font-size:13px;color:var(--subtle)}
.core b{font-size:20px;font-weight:700;line-height:1.2}
.core .h{font-family:var(--mono);font-size:13px;color:var(--subtle)}
.core .c{margin-top:auto;font-size:15px}
.core .c strong{font-size:28px;font-weight:800;letter-spacing:-.02em;display:block;line-height:1.1}

/* table */
.tools{display:flex;gap:12px;flex-wrap:wrap;align-items:center;margin-bottom:20px}
.search{flex:1 1 260px;min-height:44px;padding:0 16px;border-radius:999px;border:1px solid var(--line-strong);background:transparent;color:var(--ink);font:inherit;font-size:15px}
.search::placeholder{color:var(--subtle)}
.seg{display:flex;flex-wrap:wrap;max-width:100%;gap:4px;padding:4px;border-radius:999px;background:var(--surface)}
.seg button{min-height:36px;padding:0 16px;border:0;border-radius:999px;background:none;color:var(--muted);font:inherit;font-size:14px;font-weight:600;cursor:pointer}
.seg button[aria-pressed="true"]{background:var(--ink);color:var(--ground)}
.mobile-sort{display:none;align-items:center;gap:8px;flex-wrap:wrap;font-size:14px;font-weight:600;color:var(--muted)}
.mobile-sort select,.mobile-sort button{min-height:44px;border:1px solid var(--line-strong);border-radius:8px;background:var(--surface);color:var(--ink);font:inherit;padding:0 10px}
.mobile-sort button{cursor:pointer}
table{width:100%;border-collapse:collapse;font-size:15px}
thead th{text-align:left;font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--subtle);padding:12px 12px;border-bottom:1px solid var(--line-strong);white-space:nowrap}
thead th.num,td.num{text-align:right;font-variant-numeric:tabular-nums}
thead th button{all:unset;cursor:pointer}
thead th button:hover{color:var(--ink)}
thead th[aria-sort] button::after{content:" ↓"}
thead th[aria-sort="ascending"] button::after{content:" ↑"}
tbody td{padding:14px 12px;border-bottom:1px solid var(--line);vertical-align:middle}
tbody tr:hover td{background:rgba(255,255,255,.02)}
.who{display:flex;align-items:center;gap:14px;min-width:220px}
.who img{width:36px;height:36px;border-radius:10px;background:var(--soft);flex:none}
.who b{display:block;font-weight:600;line-height:1.3}
.who span{font-family:var(--mono);font-size:12px;color:var(--subtle)}
.tier{font-size:13px;font-weight:600;white-space:nowrap}
.tier::before{content:"";display:inline-block;width:8px;height:8px;border-radius:99px;margin-right:8px;vertical-align:1px}
.t-core::before{background:var(--signal)}.t-gold::before{background:#E9C46A}.t-silver::before{background:#A3ADA7}.t-community::before{background:transparent;border:1px solid var(--line-strong)}
td.areas{color:var(--muted);font-size:14px}
td.rk{font-family:var(--mono);font-size:13px;color:var(--subtle);width:48px}
.empty{padding:40px;text-align:center;color:var(--muted)}
.legend{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;margin-top:40px;padding-top:28px;border-top:1px solid var(--line)}
.legend b{display:block;font-size:15px}
.legend p{margin:4px 0 0;font-size:14px;color:var(--muted)}
.contributor-pagination{display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:8px;margin-top:26px}
.contributor-pagination[hidden],.pagination-pages button[hidden]{display:none}
.pagination-pages{display:flex;justify-content:center;flex-wrap:wrap;gap:6px}
.contributor-pagination button{min-width:44px;min-height:44px;padding:0 12px;border:1px solid var(--line-strong);border-radius:8px;background:var(--surface);color:var(--ink);font:600 14px var(--sans);cursor:pointer}
.contributor-pagination button:hover:not(:disabled){border-color:var(--signal)}
.contributor-pagination button[aria-current="page"]{border-color:var(--signal);font-weight:800;text-decoration:underline;text-underline-offset:4px}
.contributor-pagination button:disabled{opacity:.48;cursor:not-allowed}

/* cta */
.cta{border-radius:36px;background:radial-gradient(70% 120% at 80% 0%,#12B566 0%,#08633A 40%,var(--forest) 100%);padding:64px;display:grid;grid-template-columns:1.3fr 1fr;gap:40px;align-items:end}
.cta h2{margin:0;font-size:clamp(32px,4.4vw,56px);font-weight:800;letter-spacing:-.045em;line-height:1}
.cta p{margin:0 0 20px;font-size:17px;max-width:38ch}
.cta .btn-light{background:var(--ink);color:var(--on-green)}
.cta .btn-line{border:1px solid rgba(243,246,244,.6);color:var(--ink);font-weight:600}

/* sponsors + footer */
.sponsors{display:grid;grid-template-columns:repeat(3,1fr);gap:0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.sponsors div{padding:28px 24px 28px 0}
.sponsors div+div{padding-left:24px;border-left:1px solid var(--line)}
.sponsors h3{margin:0 0 8px;font-size:13px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--subtle)}
.sponsors a{color:var(--ink);font-weight:600}.sponsors a:hover{color:var(--signal)}
.sponsors p{margin:0;color:var(--muted);font-size:15px}
footer{padding:40px 0 56px;color:var(--subtle);font-size:14px}
footer .wrap{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap}
footer a:hover{color:var(--ink)}

@media (max-width:900px){
  .mobile-sort{display:flex;width:100%}
  .links{display:none}
  .intro-grid,.spot,.cta{grid-template-columns:1fr}
  .stats{grid-template-columns:repeat(2,1fr)}
  .stat:nth-child(3){border-left:0;padding-left:0}
  .stat:nth-child(n+3){border-top:1px solid var(--line)}
  .champs,.core,.legend,.sponsors{grid-template-columns:1fr 1fr}
  .spot-main{padding:32px}
  .cta{padding:40px}
  thead{display:none}
  table,tbody,tr,td{display:block;width:100%}
  tbody tr{display:grid;grid-template-columns:auto auto auto 1fr;gap:6px 18px;padding:16px 0;border-bottom:1px solid var(--line)}
  tbody td:nth-child(2){grid-column:1/4}
  tbody td:nth-child(3){grid-column:4;justify-self:end;align-self:center}
  tbody td{border:0;padding:0}
  td.rk{display:none}
  td.areas{grid-column:1/-1}
  td.num{text-align:left;font-size:13px;color:var(--muted)}
  td.num::before{content:attr(data-label) " "}
}
@media (max-width:560px){
  .seg{border-radius:20px}.seg button{padding:0 12px}
  .wrap{padding:0 16px}
  .champs,.core,.legend,.sponsors{grid-template-columns:1fr}
  .sponsors div+div{padding-left:0;border-left:0;border-top:1px solid var(--line)}
  .facts{grid-template-columns:1fr 1fr}
}

