---
import { getBase } from '../utils/base.ts';
import Icon from './Icon.astro';
const base = getBase();

const docsLinks = [
  { href: `${base}get-started`, label: 'Get Started' },
  { href: `${base}features`, label: 'Features' },
  { href: `${base}docs/memory`, label: 'Memory' },
  { href: `${base}docs/guardian`, label: 'Guardian' },
  { href: `${base}docs/mcp`, label: 'MCP Servers' },
  { href: `${base}docs/architecture`, label: 'Architecture' },
  { href: `${base}integrations`, label: 'Integrations' },
];

const projectLinks = [
  { href: 'https://github.com/Fmarzochi/EGC', label: 'GitHub', ariaLabel: 'GitHub (opens in new tab)', external: true },
  { href: 'https://discord.gg/FmXbgUmdmM', label: 'Discord', ariaLabel: 'Discord (opens in new tab)', external: true },
  { href: 'https://huggingface.co/spaces/fmarzochi/EGC', label: 'Hugging Face', ariaLabel: 'Hugging Face Space (opens in new tab)', external: true },
  { href: 'https://github.com/Fmarzochi/EGC/releases', label: 'Releases', ariaLabel: 'Releases (opens in new tab)', external: true },
  { href: 'https://github.com/Fmarzochi/EGC/issues', label: 'Issues', ariaLabel: 'Issues (opens in new tab)', external: true },
  { href: 'https://github.com/Fmarzochi/EGC/blob/main/.github/CONTRIBUTING.md', label: 'Contributing', ariaLabel: 'Contributing (opens in new tab)', external: true },
  { href: 'https://github.com/Fmarzochi/EGC/blob/main/docs/VISION.md', label: 'Vision', ariaLabel: 'Vision (opens in new tab)', external: true },
  { href: 'https://github.com/Fmarzochi/EGC/blob/main/.github/SECURITY.md', label: 'Security', ariaLabel: 'Security policy (opens in new tab)', external: true },
  { href: `${base}rss.xml`, label: 'RSS Feed', ariaLabel: 'RSS feed for EGC releases', external: false },
];

const securityLinks = [
  { href: 'https://securityscorecards.dev/viewer/?uri=github.com/Fmarzochi/EGC', label: 'OpenSSF Scorecard', ariaLabel: 'OpenSSF Scorecard (opens in new tab)' },
  { href: 'https://www.bestpractices.dev/projects/13099', label: 'OpenSSF Best Practices', ariaLabel: 'OpenSSF Best Practices (opens in new tab)' },
  { href: 'https://sonarcloud.io/project/overview?id=Fmarzochi_EGC', label: 'SonarCloud', ariaLabel: 'SonarCloud quality gate (opens in new tab)' },
  { href: 'https://github.com/Fmarzochi/EGC/actions/workflows/codeql.yml', label: 'CodeQL', ariaLabel: 'CodeQL analysis (opens in new tab)' },
  { href: 'https://github.com/Fmarzochi/EGC/actions/workflows/dependency-review.yml', label: 'Dependency Review', ariaLabel: 'Dependency Review workflow (opens in new tab)' },
  { href: 'https://github.com/Fmarzochi/EGC/security', label: 'Security Advisories', ariaLabel: 'Security Advisories (opens in new tab)' },
];

const linkClass = 'inline-flex items-center min-h-[36px] py-1 text-sm text-[#8E9E96] hover:text-[#3DF69B] transition-colors duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#3DF69B] rounded-sm';
---

<footer class="border-t border-[rgba(226,240,233,0.09)] bg-[#0A0D0C] mt-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 sm:py-16">

    <!-- Footer grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 sm:gap-12 mb-12">

      <!-- Brand column -->
      <div class="sm:col-span-2 lg:col-span-1">
        <a href={base} class="inline-flex items-center gap-2.5 mb-4 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#3DF69B] rounded-md">
          <svg class="shrink-0" viewBox="0 0 480 480" width="24" height="24" aria-hidden="true" focusable="false">
            <defs>
              <linearGradient id="m-ft-p" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#B4F8D6"/>
                <stop offset=".46" stop-color="#4FF3A3"/>
                <stop offset="1" stop-color="#17A862"/>
              </linearGradient>
              <filter id="m-ft-e" x="-20%" y="-20%" width="140%" height="140%">
                <feDropShadow dx="0" dy="0" stdDeviation="7" flood-color="#04361F" flood-opacity=".42"/>
              </filter>
              <clipPath id="m-ft-q">
                <rect x="0" y="0" width="240" height="240"/>
              </clipPath>
            </defs>
            <g filter="url(#m-ft-e)">
              <circle cx="240" cy="130" r="100" fill="url(#m-ft-p)"/>
              <circle cx="350" cy="240" r="100" fill="url(#m-ft-p)"/>
              <circle cx="240" cy="350" r="100" fill="url(#m-ft-p)"/>
              <circle cx="130" cy="240" r="100" fill="url(#m-ft-p)"/>
              <g clip-path="url(#m-ft-q)"><circle cx="240" cy="130" r="100" fill="url(#m-ft-p)"/></g>
            </g>
            <circle cx="240" cy="240" r="29" fill="#05231A"/>
          </svg>
          <span class="font-bold text-base tracking-tight text-[#F4F6F5]">EGC</span>
        </a>
        <p class="text-xs text-[#8E9E96] leading-relaxed max-w-xs mb-4">
          Extended Global Context.<br/>Your project remembers across sessions, branches and tools.
        </p>
        <div class="flex items-center gap-3">
          <a
            href="https://github.com/Fmarzochi/EGC"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub repository"
            class="text-[#8E9E96] hover:text-[#3DF69B] transition-colors"
          >
            <Icon name="github" size={18} />
          </a>
          <a
            href="https://discord.gg/FmXbgUmdmM"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Discord server"
            class="text-[#8E9E96] hover:text-[#3DF69B] transition-colors"
          >
            <Icon name="discord" size={18} />
          </a>
        </div>
      </div>

      <!-- Docs column -->
      <div>
        <h3 class="font-mono text-xs font-semibold uppercase tracking-wider text-[#3DF69B] mb-4">Documentation</h3>
        <ul class="space-y-1">
          {docsLinks.map(link => (
            <li><a href={link.href} class={linkClass}>{link.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Project column -->
      <div>
        <h3 class="font-mono text-xs font-semibold uppercase tracking-wider text-[#3DF69B] mb-4">Project</h3>
        <ul class="space-y-1">
          {projectLinks.map(link => (
            <li>
              <a
                href={link.href}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener noreferrer' : undefined}
                aria-label={link.ariaLabel}
                class={linkClass}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Security column -->
      <div>
        <h3 class="font-mono text-xs font-semibold uppercase tracking-wider text-[#3DF69B] mb-4">Security</h3>
        <ul class="space-y-1">
          {securityLinks.map(link => (
            <li>
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={link.ariaLabel}
                class={linkClass}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

    </div>

    <!-- Bottom sub-footer bar -->
    <div class="pt-8 border-t border-[rgba(226,240,233,0.09)] flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[#8E9E96]">
      <div>
        &copy; {new Date().getFullYear()} EGC Contributors. Apache 2.0 Licensed.
      </div>
      <div class="flex items-center gap-6">
        <a href={`${base}privacy`} class="text-[#8E9E96] hover:text-[#3DF69B] transition-colors">Privacy Policy</a>
        <span>•</span>
        <a href="https://github.com/Fmarzochi/EGC" target="_blank" rel="noopener noreferrer" class="text-[#8E9E96] hover:text-[#3DF69B] transition-colors">Open Source</a>
        <span>•</span>
        <span>Local-first</span>
      </div>
    </div>

  </div>
</footer>
