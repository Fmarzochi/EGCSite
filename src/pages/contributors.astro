---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getBase } from '../utils/base.ts';
import { formatContribution } from '../utils/format-contributor.ts';
import {
  fetchContributors,
  buildFallback,
  getChampionHistory,
  BADGE_DEFS,
  TIER_CONFIG,
  type MonthlyChampion,
  type Contributor,
} from '../data/contributors.ts';

const base = getBase();

let contributors: Contributor[];
let monthlyChampion: MonthlyChampion | null = null;
try {
  const result = await fetchContributors(import.meta.env.GITHUB_TOKEN);
  contributors = result.contributors;
  monthlyChampion = result.champion ?? getChampionHistory()[0] ?? null;
} catch {
  contributors = buildFallback();
  monthlyChampion = getChampionHistory()[0] ?? null;
}

const topThree = contributors.slice(0, 3);
const rest = contributors.slice(3);

const totalCommits = contributors.reduce((s, c) => s + c.commits, 0);
const totalAdditions = contributors.reduce((s, c) => s + c.additions, 0);
const totalPrs = contributors.reduce((s, c) => s + c.prs, 0);

const champion = monthlyChampion
  ? (contributors.find(c => c.login === monthlyChampion!.login) ?? null)
  : null;

const championFormatted = monthlyChampion ? formatContribution(monthlyChampion.reason) : null;

// Past champions, most recent first. The current month's champion (rendered above in its own
// spotlight card) is excluded here so it isn't shown twice while it's still the reigning title.
const pastChampions = getChampionHistory().filter(h => h.month !== monthlyChampion?.month);

// Desktop podium order: 2nd left, 1st center, 3rd right
const podiumOrder = [topThree[1], topThree[0], topThree[2]].filter(Boolean) as Contributor[];
const podiumMeta = [
  { rank: 2, label: '#02 · SILVER', badge: 'bg-slate-400 text-slate-900', pedestalH: 'h-20', isWinner: false },
  { rank: 1, label: '★ #01 · GOLD', badge: 'bg-yellow-400 text-gray-900', pedestalH: 'h-36', isWinner: true },
  { rank: 3, label: '#03 · BRONZE', badge: 'bg-amber-600 text-white',     pedestalH: 'h-12', isWinner: false },
];
---

<Base
  title="Hall of Fame · EGC"
  description="The developers who shaped EGC. Every commit, every bug fix, every translation, permanently recognized."
>
  <Navbar />

  <main id="main-content" class="hall max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">

    <!-- Hero -->
    <div class="hallHero">
      <div class="star" aria-hidden="true">★</div>
      <div class="eyebrow mb-2">THE PEOPLE BEHIND THE PROJECT</div>
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-[#F4F6F5] mb-4">
        Built by people.<br />
        <span class="text-[#3DF69B]">Remembered by EGC.</span>
      </h1>
      <p class="text-base sm:text-lg text-[#8E9E96] max-w-xl mx-auto mb-10 leading-relaxed">
        A permanent place for the contributors who turn ideas into working software — one issue, review, and pull request at a time.
      </p>

      <div class="stats">
        <div class="stat text-center">
          <strong>{contributors.length}</strong>
          <small>Contributors</small>
        </div>
        <div class="stat text-center">
          <strong>{totalCommits || '--'}</strong>
          <small>Commits</small>
        </div>
        <div class="stat text-center">
          <strong>{totalAdditions > 0 ? `+${totalAdditions.toLocaleString('en')}` : '--'}</strong>
          <small>Lines added</small>
        </div>
        <div class="stat text-center">
          <strong>{totalPrs}</strong>
          <small>PRs merged</small>
        </div>
      </div>
    </div>

    <!-- Contributor of the Month -->
    {champion && championFormatted && (
      <section class="spotlight relative mb-14" aria-label="Contributor of the month">
        <div>
          <div class="tag mb-3">✦ CONTRIBUTOR OF THE MONTH · {monthlyChampion!.month}</div>
          <div class="profile">
            <div class="relative shrink-0">
              <img
                src={champion.avatar}
                alt={champion.name}
                width="64"
                height="64"
                class="rounded-2xl ring-2 ring-yellow-400/60 shadow-lg shadow-yellow-500/10 object-cover"
                loading="lazy"
              />
              <span class="absolute -bottom-1 -right-1 text-base leading-none">🏅</span>
            </div>
            <div class="min-w-0">
              <strong class="text-xl font-bold text-white truncate block">{champion.name}</strong>
              <small class="text-xs text-gray-400">@{champion.login} · Monthly champion</small>
            </div>
          </div>

          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-white mb-2">
            More than commits.<br /><span class="text-[#3DF69B]">Real impact.</span>
          </h2>
          <p class="text-sm text-[#8E9E96] leading-relaxed mb-4">
            A dedicated editorial space recognizing the contributor whose work elevated the EGC ecosystem this month.
          </p>

          {/* Stats metric badges */}
          {championFormatted.stats && (
            <div class="flex flex-wrap items-center gap-2 mb-5">
              <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-semibold bg-yellow-400/10 text-yellow-300 border border-yellow-400/25">
                <span>⚡</span>
                <span>{championFormatted.stats.commits} commit{championFormatted.stats.commits !== 1 ? 's' : ''}</span>
              </span>
              {championFormatted.stats.additions !== undefined && (
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/25">
                  <span>📈</span>
                  <span>+{championFormatted.stats.additions.toLocaleString('en')} lines</span>
                </span>
              )}
              {championFormatted.stats.period && (
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-medium bg-white/5 text-gray-400 border border-white/10">
                  <span>🗓️</span>
                  <span>{championFormatted.stats.period}</span>
                </span>
              )}
            </div>
          )}

          <div class="actions">
            <button
              type="button"
              data-hype={champion.login}
              title="Hype this contributor (1 vote a day)"
              aria-label={`Hype ${champion.name}`}
              class="hype-btn inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-sm font-bold bg-[#18B669] hover:bg-[#3DF69B] text-[#04200F] transition-all duration-150 active:scale-95 shadow-md shadow-[#18B669]/20"
            >
              🔥 <span>Hype</span> <span class="hype-count tabular-nums ml-1"></span>
            </button>
            <a
              href={`${base}contributors/${champion.login}`}
              class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-sm font-semibold bg-[#111614] hover:bg-[#151D19] text-[#c1ecd1] border border-[rgba(226,240,233,0.14)] hover:border-[#3DF69B]/40 transition-all duration-150"
            >
              View profile &rarr;
            </a>
          </div>
        </div>

        <div id="reason" class="quote">
          <span class="tag">WHY THIS CONTRIBUTION MATTERS</span>
          <p class="mt-2 mb-3"><strong class="text-white text-sm font-bold">Contribution highlights</strong></p>

          {championFormatted.isStructured ? (
            <ul class="space-y-2 text-sm text-[#bdc8bb] leading-relaxed">
              {championFormatted.items.map(item => (
                <li class="flex items-start gap-2">
                  <span class="text-yellow-400 mt-1 select-none shrink-0 text-xs">✦</span>
                  <span class="leading-snug">{item}</span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="text-sm text-[#bdc8bb] leading-relaxed">{championFormatted.cleanText}</p>
          )}

          <div class="mt-4 pt-3 border-t border-[rgba(226,240,233,0.08)] text-xs text-[#829587]">
            Readable summaries · preserved facts · no generated achievements
          </div>
        </div>
      </section>
    )}

    <!-- Podium -->
    {topThree.length >= 3 && (
      <section class="mb-14">
        <div class="sectionhead">
          <div>
            <div class="eyebrow">RECOGNITION</div>
            <h2>Top contributors</h2>
            <p>A clearer podium with consistent spacing and accessible ranking.</p>
          </div>
        </div>

        <!-- Desktop podium (2nd, 1st, 3rd) -->
        <div class="podium hidden sm:grid">
          {podiumOrder.map((c, idx) => {
            const meta = podiumMeta[idx];
            const tier = TIER_CONFIG[c.tier];
            const isWinner = meta.isWinner;
            return (
              <div class={`box person relative group ${isWinner ? 'winner' : ''}`}>
                <button
                  type="button"
                  data-hype={c.login}
                  title="Hype this contributor (1 vote a day)"
                  aria-label={`Hype ${c.name}`}
                  class="hype-btn absolute top-3 right-3 z-10 inline-flex items-center gap-1 h-7 px-2 rounded-full text-xs font-semibold backdrop-blur-md bg-white/10 border border-white/15 text-gray-300 hover:text-orange-400 hover:border-orange-400/40 motion-safe:hover:scale-105 motion-safe:active:scale-95 transition-all duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-400"
                >
                  🔥<span class="hype-count tabular-nums"></span>
                </button>
                <div class="rank">{meta.label}</div>
                <div class="face relative overflow-hidden my-3">
                  <img
                    src={c.avatar}
                    alt={c.name}
                    width="60"
                    height="60"
                    class="w-full h-full object-cover rounded-full"
                    loading="lazy"
                  />
                </div>
                <a href={`${base}contributors/${c.login}`} class="text-white font-bold text-sm hover:text-[#3DF69B] transition-colors truncate max-w-full">
                  {c.name}
                </a>
                <small class="text-xs text-[#8E9E96] mb-2">@{c.login}</small>
                <span class={`inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-semibold border ${tier.color} mb-2`}>
                  {tier.icon} {tier.label}
                </span>
                <div class="flex flex-wrap justify-center gap-1 mb-2">
                  {c.badges.slice(0, 2).map(key => {
                    const b = BADGE_DEFS[key];
                    return b ? <span class="text-sm" title={b.label}>{b.icon}</span> : null;
                  })}
                </div>
                <div class="mt-auto pt-2 text-xs font-mono font-bold text-[#3DF69B]">
                  {c.commits > 0 ? `${c.commits} commit${c.commits !== 1 ? 's' : ''}` : `${c.prs} PR${c.prs !== 1 ? 's' : ''}`}
                </div>
              </div>
            );
          })}
        </div>

        <!-- Mobile podium list -->
        <div class="sm:hidden flex flex-col gap-3">
          {topThree.map((c, i) => {
            const rankLabel = ['★ #01 · GOLD', '#02 · SILVER', '#03 · BRONZE'][i];
            const isWinner = i === 0;
            const tier = TIER_CONFIG[c.tier];
            return (
              <div class={`box p-4 relative ${isWinner ? 'winner' : ''}`}>
                <button
                  type="button"
                  data-hype={c.login}
                  title="Hype this contributor (1 vote a day)"
                  aria-label={`Hype ${c.name}`}
                  class="hype-btn absolute top-3 right-3 z-10 inline-flex items-center gap-1 h-7 px-2 rounded-full text-xs font-semibold backdrop-blur-md bg-white/10 border border-white/15 text-gray-300 hover:text-orange-400 hover:border-orange-400/40 motion-safe:hover:scale-105 motion-safe:active:scale-95 transition-all duration-150"
                >
                  🔥<span class="hype-count tabular-nums"></span>
                </button>
                <div class="rank mb-2 text-xs">{rankLabel}</div>
                <div class="flex items-center gap-3">
                  <img
                    src={c.avatar}
                    alt={c.name}
                    width="48"
                    height="48"
                    class="rounded-full ring-2 ring-gray-700 shrink-0"
                    loading="lazy"
                  />
                  <div class="min-w-0 flex-1 pr-12">
                    <a href={`${base}contributors/${c.login}`} class="font-bold text-white text-sm hover:text-[#3DF69B] truncate block">
                      {c.name}
                    </a>
                    <p class="text-xs text-gray-500 mb-1">@{c.login}</p>
                    <span class={`inline-flex items-center gap-1 px-1.5 py-0.5 rounded-full text-[11px] font-semibold border ${tier.color}`}>
                      {tier.icon} {tier.label}
                    </span>
                  </div>
                </div>
                <div class="mt-3 pt-2 border-t border-[rgba(226,240,233,0.06)] flex justify-between items-center text-xs">
                  <span class="text-gray-400">Contribution</span>
                  <span class="font-mono font-bold text-[#3DF69B]">
                    {c.commits > 0 ? `${c.commits} commits` : `${c.prs} PRs`}
                  </span>
                </div>
              </div>
            );
          })}
        </div>
      </section>
    )}

    <!-- All Contributors with Search Filter -->
    <section class="mb-14">
      <div class="sectionhead">
        <div>
          <div class="eyebrow">COMMUNITY</div>
          <h2>Every contribution counts.</h2>
          <p>Find contributors without losing the visual rhythm of the page.</p>
        </div>
        <input
          class="search"
          id="personsearch"
          placeholder="Search contributors..."
          aria-label="Search contributors"
        />
      </div>

      <div id="people" class="people">
        {rest.map(c => {
          const tier = TIER_CONFIG[c.tier];
          return (
            <div
              class="box mini person-card group hover-lift relative"
              data-search={`${c.name.toLowerCase()} ${c.login.toLowerCase()}`}
            >
              <img
                src={c.avatar}
                alt={c.name}
                width="38"
                height="38"
                class="face rounded-full object-cover shrink-0 ring-1 ring-gray-700 group-hover:ring-[#3DF69B] transition-all"
                loading="lazy"
              />
              <div class="min-w-0 flex-1">
                <a
                  href={`${base}contributors/${c.login}`}
                  class="font-semibold text-white text-xs sm:text-sm hover:text-[#3DF69B] transition-colors truncate block"
                >
                  {c.name}
                </a>
                <small class="text-[11px] text-gray-400 truncate block">@{c.login}</small>
                <div class="flex items-center gap-1 mt-1 flex-wrap">
                  <span class={`inline-flex items-center gap-0.5 px-1.5 py-0.2 rounded-full text-[10px] font-semibold border ${tier.color}`}>
                    {tier.icon}
                  </span>
                  {c.badges.slice(0, 2).map(key => {
                    const b = BADGE_DEFS[key];
                    return b ? <span class="text-xs" title={b.label}>{b.icon}</span> : null;
                  })}
                </div>
              </div>
              <div class="shrink-0 flex flex-col items-end gap-1.5">
                <button
                  type="button"
                  data-hype={c.login}
                  title="Hype this contributor (1 vote a day)"
                  aria-label={`Hype ${c.name}`}
                  class="hype-btn inline-flex items-center gap-1 h-6 px-1.5 rounded-full text-[11px] font-semibold backdrop-blur-md bg-white/10 border border-white/15 text-gray-300 hover:text-orange-400 hover:border-orange-400/40 motion-safe:hover:scale-105 motion-safe:active:scale-95 transition-all duration-150"
                >
                  🔥<span class="hype-count tabular-nums"></span>
                </button>
                <span class="commits font-mono text-[11px] text-[#3DF69B] font-bold">
                  {c.commits > 0 ? `${c.commits}c` : `${c.prs}pr`}
                </span>
              </div>
            </div>
          );
        })}
      </div>

      <!-- Empty state when search yields no matches -->
      <div id="no-search-results" class="hidden text-center py-12 text-[#8E9E96]">
        <p class="text-sm">No contributors found matching your search.</p>
      </div>

      <!-- Tier legend -->
      <div class="mt-8 rounded-xl p-4 glass">
        <p class="font-mono text-xs font-semibold uppercase tracking-[0.14em] text-[#8E9E96] mb-3">Tiers</p>
        <div class="flex flex-wrap gap-2 sm:gap-3">
          {(Object.entries(TIER_CONFIG) as [string, typeof TIER_CONFIG[keyof typeof TIER_CONFIG]][]).map(([, t]) => (
            <span class={`inline-flex items-center gap-1 sm:gap-1.5 px-2 sm:px-3 py-1 rounded-full text-xs font-semibold border ${t.color}`}>
              {t.icon} <span class="hidden sm:inline">{t.label}</span><span class="sm:hidden">{t.label.split(' ')[0]}</span>
              <span class="opacity-50 hidden sm:inline">({t.minCommits}+ commits)</span>
            </span>
          ))}
        </div>
      </div>
    </section>

    <!-- Past Champions of the Month -->
    {pastChampions.length > 0 && (
      <section class="mb-14">
        <div class="sectionhead">
          <div>
            <div class="eyebrow">A LIVING ARCHIVE</div>
            <h2>Past champions</h2>
            <p>Recognition remains discoverable beyond the current month.</p>
          </div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
          {pastChampions.map(h => (
            <a
              href={`${base}contributors/${h.login}`}
              class="box mini group hover-lift p-3 flex items-center gap-3 transition-all"
              title={h.reason}
            >
              <img
                src={`https://github.com/${h.login}.png`}
                alt={h.name}
                width="36"
                height="36"
                class="rounded-full ring-1 ring-yellow-400/50 shrink-0"
                loading="lazy"
              />
              <div class="min-w-0 flex-1">
                <span class="text-xs font-semibold text-gray-200 group-hover:text-white truncate block">{h.name}</span>
                <span class="text-[11px] text-gray-500 font-mono">@{h.login}</span>
              </div>
              <span class="tag text-[10px] shrink-0">{h.month}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- CTA -->
    <section class="mb-16">
      <div class="rounded-2xl p-6 sm:p-8 text-center glass hover-glow">
        <p class="text-sm text-gray-400 mb-4">
          Want your name on this page? Find an open issue and ship a fix.
        </p>
        <a
          href="https://github.com/Fmarzochi/EGC/issues"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-2.5 rounded-full bg-[#18B669] hover:bg-[#3DF69B] text-[#04200F] text-sm font-bold transition-all duration-200 active:scale-95 shadow-md shadow-[#18B669]/20"
        >
          Browse open issues
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        </a>
      </div>
    </section>

    <!-- Sponsors -->
    <section class="pb-20">
      <div class="relative rounded-2xl p-6 sm:p-10 glass hover-glow overflow-hidden">
        <div class="absolute inset-0 pointer-events-none -z-10" aria-hidden="true">
          <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[400px] h-[300px] bg-pink-500/10 rounded-full blur-[80px] mix-blend-screen"></div>
        </div>

        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mb-10">
          <div class="text-center sm:text-left">
            <div class="flex items-center justify-center sm:justify-start gap-2 mb-1">
              <svg class="w-5 h-5 text-pink-500 animate-heartbeat" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 21.593c-.317.177-.834.177-1.151 0C9.774 20.57 3 16.259 3 9.5 3 6.462 5.462 4 8.5 4c1.4 0 2.672.536 3.5 1.393C12.828 4.536 14.1 4 15.5 4 18.538 4 21 6.462 21 9.5c0 6.759-6.774 11.07-9 12.093z"/>
              </svg>
              <h2 class="text-lg font-bold text-white">Sponsors</h2>
            </div>
            <p class="text-xs text-gray-500 max-w-xs">EGC is free and open source. Sponsors keep it alive and moving forward.</p>
          </div>
          <div class="flex flex-col sm:flex-row gap-2 w-full sm:w-auto">
            <a
              href="https://github.com/sponsors/Fmarzochi"
              target="_blank"
              rel="noopener noreferrer"
              class="group inline-flex items-center justify-center gap-2 min-h-[40px] px-5 py-2 rounded-full border border-[rgba(226,240,233,0.12)] bg-[#111614] text-[#F4F6F5] text-sm font-semibold hover:border-pink-500/50 hover:text-pink-400 active:scale-95 transition-all duration-200"
            >
              <svg class="w-4 h-4 text-pink-500/70 group-hover:text-pink-400 transition-colors animate-heartbeat" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21.593c-.317.177-.834.177-1.151 0C9.774 20.57 3 16.259 3 9.5 3 6.462 5.462 4 8.5 4c1.4 0 2.672.536 3.5 1.393C12.828 4.536 14.1 4 15.5 4 18.538 4 21 6.462 21 9.5c0 6.759-6.774 11.07-9 12.093z"/></svg>
              GitHub Sponsors
            </a>
            <a
              href="https://www.paypal.com/donate/?business=fmarzochi%40gmail.com&currency_code=USD"
              target="_blank"
              rel="noopener noreferrer"
              class="group inline-flex items-center justify-center gap-2 min-h-[40px] px-5 py-2 rounded-full border border-[rgba(226,240,233,0.12)] bg-[#111614] text-[#F4F6F5] text-sm font-semibold hover:border-blue-500/50 hover:text-blue-400 active:scale-95 transition-all duration-200"
            >
              <svg class="w-4 h-4 text-blue-500/70 group-hover:text-blue-400 transition-colors" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M7.076 21.337H2.47a.641.641 0 0 1-.633-.74L4.944.901C5.026.382 5.474 0 5.998 0h7.46c2.57 0 4.578.543 5.69 1.81 1.01 1.15 1.304 2.42 1.012 4.287-.023.143-.047.288-.077.437-.983 5.05-4.349 6.797-8.647 6.797h-2.19c-.524 0-.968.382-1.05.9l-1.12 7.106zm14.146-14.42a3.35 3.35 0 0 0-.607-.541c-.013.076-.026.175-.041.254-.93 4.778-4.005 7.201-9.138 7.201h-2.19a.563.563 0 0 0-.556.479l-1.187 7.527h-.506l-.24 1.516a.56.56 0 0 0 .554.647h3.882c.46 0 .85-.334.922-.788.06-.26.76-4.852.816-5.09a.932.932 0 0 1 .923-.788h.58c3.76 0 6.705-1.528 7.565-5.946.36-1.847.174-3.388-.777-4.471z"/></svg>
              PayPal
            </a>
          </div>
        </div>

        <div class="mb-8">
          <p class="text-xs font-semibold uppercase tracking-widest text-gray-500 mb-2">Tool Partners</p>
          <p class="text-xs text-gray-600 italic mb-4">Be the first tool partner.</p>
          <div class="flex flex-wrap gap-3">
            <a
              href="https://www.pincushion.io/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Pincushion, AI feedback tool (opens in new tab)"
