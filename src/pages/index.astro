---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { getBase } from '../utils/base.ts';
import Icon from '../components/Icon.astro';
const base = getBase();
---

<Base title="EGC - Extended Global Context" description="Keep useful project context available across coding sessions and supported tools, with local memory designed for developer workflows.">
  <Navbar />

  <main id="main-content">
    <!-- Hero -->
    <section class="relative border-b border-white/[0.08] bg-[#090a0c] pt-10 pb-12 sm:pt-14 sm:pb-14 lg:pt-16 lg:pb-16 xl:pt-16 xl:pb-14">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-8 xl:gap-10 items-start">

          <!-- Primary Editorial Column -->
          <div class="lg:col-span-7 flex flex-col justify-center">
            <!-- Eyebrow / Technical Specification -->
            <div class="flex flex-wrap items-center gap-2.5 mb-5 sm:mb-6">
              <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-sm border border-emerald-500/30 bg-emerald-500/10 text-emerald-400 font-mono text-[11px] uppercase tracking-wider font-medium">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                EXTENDED GLOBAL CONTEXT
              </span>
              <a
                href="https://github.com/Fmarzochi/EGC/releases"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="See release notes (opens in new tab)"
                class="inline-flex items-center gap-1 font-mono text-[11px] text-zinc-400 hover:text-zinc-200 transition-colors uppercase tracking-wider"
              >
                <span class="text-zinc-600">//</span>
                <span>v1.1.22</span>
                <span class="underline underline-offset-2">NOTES</span>
              </a>
            </div>

            <!-- Headline -->
            <h1 class="text-3xl sm:text-5xl lg:text-6xl xl:text-7xl font-extrabold tracking-tight text-white leading-[1.02] uppercase">
              CONTEXT SHOULDN'T RESET.
            </h1>

            <!-- Conservative Supporting Copy -->
            <p class="mt-5 sm:mt-6 text-base sm:text-lg xl:text-lg text-zinc-300 leading-relaxed max-w-xl xl:max-w-2xl text-pretty">
              Keep useful project context available across coding sessions and supported tools, with local memory designed for developer workflows.
            </p>

            <!-- Actions Row: CTAs -->
            <div class="mt-8 flex flex-wrap items-center gap-3">
              <button
                id="open-install-modal"
                type="button"
                class="inline-flex items-center justify-center gap-2 min-h-[44px] px-5 py-2.5 rounded-sm bg-emerald-500 hover:bg-emerald-400 text-black font-semibold text-sm transition-colors focus:outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-400 active:scale-[0.98]"
              >
                Install EGC
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
                </svg>
              </button>
              <a
                href="https://github.com/Fmarzochi/EGC"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="View EGC on GitHub (opens in new tab)"
                class="inline-flex items-center justify-center gap-2 min-h-[44px] px-4 py-2.5 rounded-sm border border-white/15 bg-white/[0.03] text-zinc-200 hover:text-white hover:bg-white/[0.08] hover:border-white/30 text-sm font-medium transition-colors focus:outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-400 active:scale-[0.98]"
              >
                <Icon name="github" size={16} />
                GitHub
              </a>
            </div>

            <!-- Install Command Interaction Block -->
            <div class="mt-6 max-w-md xl:max-w-lg">
              <div
                id="copy-install-cmd"
                role="button"
                tabindex="0"
                aria-label="Copy install commands"
                class="group flex items-center justify-between gap-3 px-3.5 py-2.5 rounded-sm border border-white/[0.12] bg-[#121316] hover:border-emerald-500/50 hover:bg-[#16171b] transition-all cursor-pointer select-none focus:outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-400"
              >
                <div class="flex items-center gap-2.5 min-w-0 font-mono text-xs">
                  <span class="text-emerald-400 font-bold select-none">$</span>
                  <span class="text-zinc-200 select-all truncate">npm install -g @egchq/egc</span>
                </div>
                <div class="flex items-center gap-1.5 shrink-0 text-zinc-400 group-hover:text-emerald-400 transition-colors">
                  <svg id="copy-icon" class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                  </svg>
                  <span id="copy-label" class="text-[11px] font-mono uppercase tracking-wider">copy</span>
                </div>
              </div>
              <div class="mt-1.5 flex items-center gap-2 font-mono text-[11px] text-zinc-500 px-1">
                <span class="text-zinc-600">//</span>
                <span>followed by: <code class="text-zinc-400 font-mono">egc install</code></span>
              </div>
            </div>
          </div>

          <!-- Secondary Engineering Column: Architectural State Schematic -->
          <div class="lg:col-span-5 w-full">
            <div class="rounded-sm border border-white/[0.12] bg-[#0d0e12] overflow-hidden shadow-2xl">
              <!-- Schematic Header -->
              <div class="flex flex-wrap items-center justify-between gap-2 px-4 py-2.5 border-b border-white/[0.08] bg-[#131418]">
                <div class="flex items-center gap-2 font-mono text-[11px] uppercase tracking-wider text-zinc-300">
                  <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                  <span>CONTEXT ARCHITECTURE</span>
                </div>
                <span class="font-mono text-[10px] text-zinc-500 uppercase tracking-widest">SPEC: PERSISTENCE</span>
              </div>

              <!-- Schematic Content -->
              <div class="p-4 sm:p-5 xl:p-6">
                <div class="font-mono text-[10px] uppercase tracking-widest text-zinc-500 mb-2.5">
                  // CORE CONTEXT
                </div>
                <div class="grid grid-cols-1 min-[350px]:grid-cols-2 gap-2 font-mono text-xs">
                  <div class="p-2.5 xl:p-3 rounded-sm border border-white/[0.06] bg-white/[0.02]">
                    <div class="text-[10px] text-zinc-500 uppercase tracking-wider">01 // PROJECT</div>
                    <div class="text-zinc-200 font-semibold mt-1">Repository Root</div>
                    <div class="text-[11px] text-zinc-400 mt-0.5 leading-snug break-words">Local workspace root</div>
                  </div>
                  <div class="p-2.5 xl:p-3 rounded-sm border border-white/[0.06] bg-white/[0.02]">
                    <div class="text-[10px] text-zinc-500 uppercase tracking-wider">02 // BRANCH</div>
                    <div class="text-zinc-200 font-semibold mt-1">Git Context</div>
                    <div class="text-[11px] text-zinc-400 mt-0.5 leading-snug break-words">Branch-aware state</div>
                  </div>
                  <div class="p-2.5 xl:p-3 rounded-sm border border-white/[0.06] bg-white/[0.02]">
                    <div class="text-[10px] text-zinc-500 uppercase tracking-wider">03 // MEMORY</div>
                    <div class="text-zinc-200 font-semibold mt-1">egc-memory</div>
                    <div class="text-[11px] text-zinc-400 mt-0.5 leading-snug break-words">Local MCP server</div>
                  </div>
                  <div class="p-2.5 xl:p-3 rounded-sm border border-white/[0.06] bg-white/[0.02]">
                    <div class="text-[10px] text-zinc-500 uppercase tracking-wider">04 // STATE</div>
                    <div class="text-zinc-200 font-semibold mt-1">Decisions &amp; Stack</div>
                    <div class="text-[11px] text-zinc-400 mt-0.5 leading-snug break-words">Encrypted local store</div>
                  </div>
                </div>

                <!-- Verified CLI Setup Sequence -->
                <div class="mt-4 pt-4 border-t border-white/[0.08]">
                  <div class="font-mono text-[10px] uppercase tracking-widest text-zinc-500 mb-2">
                    // SETUP WORKFLOW
                  </div>
                  <div class="space-y-1.5 xl:space-y-2 font-mono text-xs text-zinc-300 bg-[#08090b] p-3 xl:p-3.5 rounded-sm border border-white/[0.06]">
                    <div class="flex items-center gap-2">
                      <span class="text-emerald-400 select-none">$</span>
                      <span>npm install -g @egchq/egc</span>
                    </div>
                    <div class="flex items-center gap-2">
                      <span class="text-emerald-400 select-none">$</span>
                      <span>egc install</span>
                    </div>
                    <div class="flex items-center gap-2">
                      <span class="text-emerald-400 select-none">$</span>
                      <span>egc doctor</span>
                    </div>
                  </div>
                </div>

                <!-- MCP Servers Architecture Listing -->
                <div class="mt-3 pt-3 border-t border-white/[0.08]">
                  <div class="font-mono text-[10px] uppercase tracking-widest text-zinc-500 mb-2">
                    MCP SERVERS
                  </div>
                  <div class="grid grid-cols-1 min-[350px]:grid-cols-2 gap-2 font-mono text-[11px]">
                    <div class="px-2.5 py-1.5 xl:py-2 rounded-sm bg-white/[0.02] border border-white/[0.04] text-zinc-300">
                      egc-memory
                    </div>
                    <div class="px-2.5 py-1.5 xl:py-2 rounded-sm bg-white/[0.02] border border-white/[0.04] text-zinc-300">
                      egc-guardian
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Section 01: The Problem -->
    <section class="relative border-b border-white/[0.08] bg-[#090a0c] py-12 sm:py-16 lg:py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 xl:gap-16 items-start">

          <!-- Editorial Column -->
          <div class="lg:col-span-5 flex flex-col justify-center">
            <div class="flex items-center gap-2 mb-4">
              <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-sm border border-emerald-500/30 bg-emerald-500/10 text-emerald-400 font-mono text-[11px] uppercase tracking-wider font-medium">
                01 // THE PROBLEM
              </span>
            </div>

            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white leading-[1.05] uppercase">
              PROJECT CONTEXT<br class="hidden sm:inline" /> GETS FRAGMENTED.
            </h2>

            <div class="mt-5 sm:mt-6 space-y-3.5 text-base sm:text-lg text-zinc-300 leading-relaxed text-pretty">
              <p>
                Modern engineering work can span multiple sessions, supported tools, and Git branches.
              </p>
              <p class="text-sm sm:text-base text-zinc-400 leading-relaxed">
                Without a persistent local reference, useful project decisions and working context can remain isolated inside those boundaries.
              </p>
            </div>
          </div>

          <!-- Problem Concepts Visualization -->
          <div class="lg:col-span-7 w-full pt-2 lg:pt-3">
            <div class="border-t lg:border-t-0 lg:border-l border-white/[0.08] pt-6 lg:pt-0 lg:pl-8 xl:pl-12">

              <!-- 3 Concepts: Vertical on mobile, 3-column on tablet/desktop -->
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 sm:gap-4 lg:gap-6">
                <!-- Concept 01: Session -->
                <div class="pb-5 sm:pb-0 border-b sm:border-b-0 sm:border-r border-white/[0.08] sm:pr-4 lg:pr-6">
                  <div class="font-mono text-[10px] text-zinc-500 uppercase tracking-wider">
                    01 // SESSION
                  </div>
                  <div class="text-zinc-200 font-mono text-sm font-semibold mt-1 uppercase">
                    SESSION
                  </div>
                  <div class="text-xs text-zinc-400 mt-1.5 leading-relaxed break-words">
                    Working context can remain scoped to a session.
                  </div>
                </div>

                <!-- Concept 02: Tool -->
                <div class="pb-5 sm:pb-0 border-b sm:border-b-0 sm:border-r border-white/[0.08] sm:pr-4 lg:pr-6">
                  <div class="font-mono text-[10px] text-zinc-500 uppercase tracking-wider">
                    02 // TOOL
                  </div>
                  <div class="text-zinc-200 font-mono text-sm font-semibold mt-1 uppercase">
                    TOOL
                  </div>
                  <div class="text-xs text-zinc-400 mt-1.5 leading-relaxed break-words">
                    Supported tools expose different context mechanisms.
                  </div>
                </div>

                <!-- Concept 03: Branch -->
                <div>
                  <div class="font-mono text-[10px] text-zinc-500 uppercase tracking-wider">
                    03 // BRANCH
                  </div>
                  <div class="text-zinc-200 font-mono text-sm font-semibold mt-1 uppercase">
                    BRANCH
                  </div>
                  <div class="text-xs text-zinc-400 mt-1.5 leading-relaxed break-words">
                    Working state can differ across Git branches.
                  </div>
                </div>
              </div>

              <!-- Concluding Row: Project Context Bridge -->
              <div class="pt-5 border-t border-white/[0.08] mt-6">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1.5 sm:gap-4 font-mono">
                  <div class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 select-none"></span>
                    <span class="text-xs font-semibold text-zinc-200 uppercase tracking-wider">PROJECT CONTEXT</span>
                  </div>
                  <div class="text-xs text-zinc-400">
                    A persistent local reference connects the workflow.
                  </div>
                </div>
              </div>

            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Section 02: Product Workflow -->
    <section class="relative border-b border-white/[0.08] bg-[#0c0d10] py-12 sm:py-16 lg:py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

        <!-- Section Header / Editorial -->
        <div class="max-w-3xl mb-10 sm:mb-12">
          <div class="flex items-center gap-2 mb-4">
            <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-sm border border-emerald-500/30 bg-emerald-500/10 text-emerald-400 font-mono text-[11px] uppercase tracking-wider font-medium">
              02 // PRODUCT WORKFLOW
            </span>
          </div>

          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white leading-[1.05] uppercase">
            PROJECT CONTEXT,<br class="hidden sm:inline" /> AVAILABLE WHEN THE WORK CONTINUES.
          </h2>

          <p class="mt-4 sm:mt-5 text-base sm:text-lg text-zinc-300 leading-relaxed text-pretty">
            EGC establishes local, branch-aware project state that supported integrations can retrieve across engineering sessions. Decisions recorded in one workflow become retrievable context when work resumes on the repository.
          </p>
        </div>

        <!-- Engineering Workflow Viewport Frame -->
        <div class="w-full rounded-sm border border-white/[0.12] bg-[#0d0e12] overflow-hidden shadow-2xl">
          <!-- Viewport Header / Spec Meta -->
          <div class="flex flex-wrap items-center justify-between gap-2 px-4 py-2.5 border-b border-white/[0.08] bg-[#131418]">
            <div class="flex items-center gap-2 font-mono text-[11px] uppercase tracking-wider text-zinc-300">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              <span>WORKFLOW VIEWPORT // PERSISTENCE PIPELINE</span>
            </div>
            <span class="font-mono text-[10px] text-zinc-500 uppercase tracking-widest">SPEC: CONTEXT RETRIEVAL</span>
          </div>

          <!-- Viewport Stage Sequence -->
          <div class="p-4 sm:p-6 lg:p-8">
            <div class="grid grid-cols-1 lg:grid-cols-11 gap-4 lg:gap-2 items-stretch">

              <!-- Stage 01: Session A -->
              <div class="lg:col-span-3 flex flex-col justify-between p-4 rounded-sm border border-white/[0.06] bg-[#090a0c]">
                <div>
                  <div class="flex items-center justify-between font-mono text-[10px] text-zinc-500 uppercase tracking-wider mb-2">
                    <span>STAGE 01</span>
                    <span class="text-emerald-400/80 font-mono">ORIGIN</span>
                  </div>
                  <h3 class="text-zinc-100 font-mono text-sm font-bold uppercase tracking-wider">
                    SESSION A
                  </h3>
                  <div class="text-[11px] font-mono text-zinc-400 mt-0.5">
                    Active Development
                  </div>
                  <ul class="mt-3.5 space-y-1.5 font-mono text-xs text-zinc-400">
                    <li class="flex items-start gap-2">
                      <span class="text-zinc-600 select-none">//</span>
                      <span>Project decisions</span>
                    </li>
                    <li class="flex items-start gap-2">
                      <span class="text-zinc-600 select-none">//</span>
                      <span>Architecture constraints</span>
                    </li>
                    <li class="flex items-start gap-2">
                      <span class="text-zinc-600 select-none">//</span>
                      <span>Working context formulated</span>
                    </li>
                  </ul>
                </div>
                <div class="mt-4 pt-3 border-t border-white/[0.06] font-mono text-[10px] text-zinc-500 uppercase tracking-wider">
                  ACTION // RECORD DECISIONS
                </div>
              </div>

              <!-- Transition Connector 1: PERSIST -->
              <div class="lg:col-span-1 flex flex-col items-center justify-center py-2 lg:py-0">
                <div class="flex lg:flex-col items-center justify-center gap-1.5 text-center">
                  <span class="font-mono text-[10px] font-semibold uppercase tracking-wider text-emerald-400 px-2 py-0.5 rounded-sm bg-emerald-500/10 border border-emerald-500/20">
                    PERSIST
                  </span>
                  <svg class="w-4 h-4 text-emerald-400 hidden lg:block" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                  </svg>
                  <svg class="w-4 h-4 text-emerald-400 lg:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
                  </svg>
                </div>
              </div>

              <!-- Stage 02: Local Project State (Center Anchor) -->
              <div class="lg:col-span-3 flex flex-col justify-between p-4 rounded-sm border border-emerald-500/30 bg-[#090a0c] relative">
                <div>
                  <div class="flex items-center justify-between font-mono text-[10px] text-emerald-400 uppercase tracking-wider mb-2">
                    <span>STAGE 02</span>
                    <span class="font-semibold">LOCAL REPOSITORY STATE</span>
                  </div>
                  <h3 class="text-white font-mono text-sm font-bold uppercase tracking-wider">
                    PROJECT STATE
                  </h3>
                  <div class="text-[11px] font-mono text-zinc-300 mt-0.5">
                    Branch-Aware Local Persistence
                  </div>
                  <ul class="mt-3.5 space-y-1.5 font-mono text-xs text-zinc-300">
                    <li class="flex items-start gap-2">
                      <span class="text-emerald-500 select-none">&bull;</span>
                      <span>Scoped to workspace root</span>
                    </li>
                    <li class="flex items-start gap-2">
                      <span class="text-emerald-500 select-none">&bull;</span>
                      <span>Branch-aware state</span>
                    </li>
                    <li class="flex items-start gap-2">
                      <span class="text-emerald-500 select-none">&bull;</span>
                      <span>Encrypted local store (AES-256)</span>
                    </li>
                  </ul>
                </div>
                <div class="mt-4 pt-3 border-t border-emerald-500/20 flex flex-wrap items-center gap-1.5">
                  <span class="font-mono text-[10px] px-1.5 py-0.5 rounded-sm bg-white/[0.04] text-zinc-400">LOCAL MEMORY</span>
                  <span class="font-mono text-[10px] px-1.5 py-0.5 rounded-sm bg-white/[0.04] text-zinc-400">BRANCH-AWARE</span>
                </div>
              </div>

              <!-- Transition Connector 2: RETRIEVE -->
              <div class="lg:col-span-1 flex flex-col items-center justify-center py-2 lg:py-0">
                <div class="flex lg:flex-col items-center justify-center gap-1.5 text-center">
                  <span class="font-mono text-[10px] font-semibold uppercase tracking-wider text-emerald-400 px-2 py-0.5 rounded-sm bg-emerald-500/10 border border-emerald-500/20">
                    RETRIEVE
                  </span>
                  <svg class="w-4 h-4 text-emerald-400 hidden lg:block" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                  </svg>
                  <svg class="w-4 h-4 text-emerald-400 lg:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
                  </svg>
                </div>
              </div>

              <!-- Stage 03: Session B -->
              <div class="lg:col-span-3 flex flex-col justify-between p-4 rounded-sm border border-white/[0.06] bg-[#090a0c]">
                <div>
                  <div class="flex items-center justify-between font-mono text-[10px] text-zinc-500 uppercase tracking-wider mb-2">
                    <span>STAGE 03</span>
                    <span class="text-zinc-400 font-mono">CONTINUATION</span>
                  </div>
                  <h3 class="text-zinc-100 font-mono text-sm font-bold uppercase tracking-wider">
                    SESSION B
                  </h3>
                  <div class="text-[11px] font-mono text-zinc-400 mt-0.5">
                    Subsequent Task or Tool
                  </div>
                  <ul class="mt-3.5 space-y-1.5 font-mono text-xs text-zinc-400">
                    <li class="flex items-start gap-2">
                      <span class="text-zinc-600 select-none">//</span>
                      <span>Context requested via MCP</span>
                    </li>
                    <li class="flex items-start gap-2">
                      <span class="text-zinc-600 select-none">//</span>
                      <span>Branch context retrieved</span>
                    </li>
                    <li class="flex items-start gap-2">
                      <span class="text-zinc-600 select-none">//</span>
                      <span>Prior project state available</span>
                    </li>
                  </ul>
                </div>
                <div class="mt-4 pt-3 border-t border-white/[0.06] font-mono text-[10px] text-zinc-500 uppercase tracking-wider">
                  PROTOCOL // MCP GET_STATE
                </div>
              </div>

            </div>
          </div>

          <!-- Viewport Footer Spec Strip -->
          <div class="px-4 py-2.5 border-t border-white/[0.08] bg-[#111216] flex flex-wrap items-center justify-between gap-2 font-mono text-[10px] text-zinc-400">
            <div class="flex items-center gap-2">
              <span class="text-zinc-600">//</span>
              <span>ARCHITECTURE: PERSISTENCE PIPELINE FOR SUPPORTED INTEGRATIONS</span>
            </div>
            <div class="flex items-center gap-3 text-zinc-500">
