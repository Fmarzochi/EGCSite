{
  "ci": {
    "collect": {
      "staticDistDir": "./lhci-site",
      "url": [
        "http://localhost/EGCSite/",
        "http://localhost/EGCSite/features/",
        "http://localhost/EGCSite/get-started/",
        "http://localhost/EGCSite/integrations/",
        "http://localhost/EGCSite/integrations/claude-code/",
        "http://localhost/EGCSite/docs/architecture/",
        "http://localhost/EGCSite/contributors/",
        "http://localhost/EGCSite/privacy/"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.5, "aggregationMethod": "median-run" }],
        "categories:accessibility": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "categories:best-practices": ["error", { "minScore": 0.75, "aggregationMethod": "median-run" }],
        "categories:seo": ["error", { "minScore": 0.95, "aggregationMethod": "median-run" }]
      }
    }
  }
}
