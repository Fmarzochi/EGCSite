    </div>
    <div>
      <figure class="lanes rv" data-lanes>
        <figcaption class="sr-only" data-i18n="ben.figcap">Comparação ilustrativa: sem o EGC, o contexto disponível para a IA volta a zero a cada nova sessão; com o EGC, ele é restaurado e se acumula entre as sessões.</figcaption>
        <svg width="0" height="0" aria-hidden="true" style="position:absolute">
          <defs>
            <linearGradient id="gradWithout" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="rgba(244,246,245,.16)"/><stop offset="1" stop-color="rgba(244,246,245,0)"/></linearGradient>
            <linearGradient id="gradWith" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="rgba(61,246,155,.32)"/><stop offset="1" stop-color="rgba(61,246,155,0)"/></linearGradient>
          </defs>
        </svg>
        <div class="lanes__cols" aria-hidden="true"><span data-i18n="ben.col0">contexto</span><span data-i18n="ben.col1">sessão 1</span><span data-i18n="ben.col2">sessão 2</span><span data-i18n="ben.col3">sessão 3</span></div>
        <div class="lane lane--without" aria-hidden="true">
          <div class="lane__name"><b data-i18n="ben.without">Sem EGC</b><small data-i18n="ben.withoutSub">zera a cada sessão</small></div>
          <div class="lane__plot">
            <svg viewBox="0 0 300 100" preserveAspectRatio="none"><defs><clipPath id="clipWithout"><rect class="lane-clip" x="0" y="-10" width="300" height="120"/></clipPath></defs>
