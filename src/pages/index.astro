---
import Base from '../layouts/Base.astro';
import { getBase } from '../utils/base.ts';
const base = getBase();
---

<Base
  title="EGC — Context That Never Resets"
  description="Your project remembers. So you don't have to. EGC keeps your project's useful context available across tools, sessions and workflows."
>
  <div style="font-family: 'Plus Jakarta Sans', 'Helvetica Neue', sans-serif; color: #F3F6F4; background: #0C0F0E; min-height: 100vh">

    <!-- HERO CARD -->
    <section id="top" style="position: relative; overflow: hidden; border-radius: 0 0 56px 56px; background: radial-gradient(70% 90% at 55% 20%, #12B566 0%, #08633A 36%, #052818 70%, #0C0F0E 100%)">

      <header style="position: relative; z-index: 2; max-width: 1240px; margin: 0 auto; padding: 1.75rem 2rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap">
        <a href="#top" style="display: flex; align-items: center; gap: 10px; color: #F3F6F4; text-decoration: none">
          <svg width="28" height="28" viewBox="0 0 28 28" fill="#F3F6F4" aria-hidden="true">
            <circle cx="14" cy="8" r="5.5"></circle>
            <circle cx="20" cy="14" r="5.5"></circle>
            <circle cx="14" cy="20" r="5.5"></circle>
            <circle cx="8" cy="14" r="5.5"></circle>
          </svg>
          <span style="font-weight: 800; font-size: 24px; letter-spacing: -0.03em">EGC</span>
        </a>
        <div style="display: flex; align-items: center; gap: 1.75rem; flex-wrap: wrap">
          <nav style="display: flex; gap: 1.75rem; font-size: 15px; font-weight: 500">
            <a href={`${base}features`} style="color: #F3F6F4; text-decoration: none">Features</a>
            <a href="#integrations" style="color: #F3F6F4; text-decoration: none">Integrations</a>
            <a href="#features" style="color: #F3F6F4; text-decoration: none">Pricing</a>
            <a href={`${base}docs/memory`} style="color: #F3F6F4; text-decoration: none">Docs</a>
          </nav>
          <button
            type="button"
            class="open-install-trigger"
            style="display: inline-flex; align-items: center; gap: 14px; min-height: 48px; padding: 0 6px 0 22px; border-radius: 999px; background: #FFFFFF; color: #06210F; font-weight: 700; font-size: 15px; border: none; cursor: pointer"
          >
            Get EGC
            <span style="display: inline-flex; width: 36px; height: 36px; border-radius: 999px; background: #10B866; align-items: center; justify-content: center">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2.6" stroke-linecap="round" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6"></path>
              </svg>
            </span>
          </button>
        </div>
      </header>

      <!-- Clover visual -->
      <div aria-hidden="true" style="position: absolute; left: 50%; top: 90px; width: 560px; height: 560px; margin-left: -150px; z-index: 0; pointer-events: none">
        <svg class="egc-orbit" width="560" height="560" viewBox="0 0 560 560" fill="none" stroke="rgba(255,255,255,0.14)" stroke-width="1" style="position: absolute; inset: 0">
          <circle cx="280" cy="280" r="270" stroke-dasharray="4 10"></circle>
          <circle cx="280" cy="280" r="200"></circle>
        </svg>
        <svg class="egc-clover" width="360" height="360" viewBox="0 0 28 28" style="position: absolute; left: 100px; top: 100px">
          <defs>
            <linearGradient id="egcLeaf" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#B9FFD9"></stop>
              <stop offset="50%" stop-color="#3DF59A"></stop>
              <stop offset="100%" stop-color="#0A8F4E"></stop>
            </linearGradient>
          </defs>
          <g fill="url(#egcLeaf)">
            <circle cx="14" cy="8" r="5.5"></circle>
            <circle cx="20" cy="14" r="5.5"></circle>
            <circle cx="14" cy="20" r="5.5"></circle>
            <circle cx="8" cy="14" r="5.5"></circle>
          </g>
          <circle cx="14" cy="14" r="1.6" fill="#07311D"></circle>
        </svg>
      </div>

      <div style="position: relative; z-index: 1; max-width: 1240px; margin: 0 auto; padding: 5rem 2rem 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 3rem; align-items: center; min-height: 460px">
        <div>
          <div style="font-size: 1.5rem; font-weight: 500; margin-bottom: 1.25rem">Hey, meet EGC</div>
          <h1 style="margin: 0; font-weight: 800; font-size: clamp(3.2rem, 7.5vw, 6.4rem); line-height: 0.98; letter-spacing: -0.045em">Context<br>That Never<br>Resets</h1>
        </div>
        <div style="justify-self: end; max-width: 330px; display: flex; flex-direction: column; gap: 1rem">
          <div style="font-size: 1.6rem; font-weight: 700; line-height: 1.25">Your project remembers. So you don't have to.</div>
          <p style="margin: 0; font-size: 1.05rem; line-height: 1.6; color: rgba(243,246,244,0.82)">EGC keeps your project's useful context available across tools, sessions and workflows.</p>
          <div style="display: flex; gap: 10px; flex-wrap: wrap; margin-top: 0.5rem">
            <button
              type="button"
              class="open-install-trigger"
              style="display: inline-flex; align-items: center; min-height: 48px; padding: 0 22px; border-radius: 999px; background: #F3F6F4; color: #06210F; font-weight: 700; font-size: 15px; border: none; cursor: pointer"
            >
              Install EGC
            </button>
            <a
              href="https://github.com/Fmarzochi/EGC"
              target="_blank"
              rel="noopener noreferrer"
              style="display: inline-flex; align-items: center; min-height: 48px; padding: 0 22px; border-radius: 999px; border: 1px solid rgba(255,255,255,0.4); color: #F3F6F4; font-weight: 600; font-size: 15px; text-decoration: none"
            >
              View on GitHub
            </a>
          </div>
        </div>
      </div>

      <div style="position: relative; z-index: 1; max-width: 1240px; margin: 0 auto; padding: 4.5rem 2rem 3.5rem; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.5rem">
        <div><div style="font-weight: 700; font-size: 15px"><span style="color: #3DF59A">#</span>01</div><div style="margin-top: 0.75rem; font-size: 1.05rem">Persistent Context</div></div>
        <div><div style="font-weight: 700; font-size: 15px"><span style="color: #3DF59A">#</span>02</div><div style="margin-top: 0.75rem; font-size: 1.05rem">Workflows &amp; Tools</div></div>
        <div><div style="font-weight: 700; font-size: 15px"><span style="color: #3DF59A">#</span>03</div><div style="margin-top: 0.75rem; font-size: 1.05rem">Project Decisions</div></div>
        <div><div style="font-weight: 700; font-size: 15px"><span style="color: #3DF59A">#</span>04</div><div style="margin-top: 0.75rem; font-size: 1.05rem">Real Dev Environment</div></div>
      </div>
    </section>

    <!-- WORKS WITH -->
    <section id="integrations" style="border-radius: 0 0 56px 56px; background: #141816">
      <div style="max-width: 1240px; margin: 0 auto; padding: 3.5rem 2rem; display: flex; align-items: center; justify-content: space-between; gap: 2rem; flex-wrap: wrap">
        <div style="font-weight: 600; font-size: 15px; line-height: 1.4; max-width: 14ch">Works with the tools you already use</div>
        <div style="display: flex; gap: 2.75rem; flex-wrap: wrap; align-items: center; font-weight: 700; font-size: 1.5rem; color: #8C9690">
          <span>VS Code</span><span>JetBrains</span><span>Terminal</span><span>GitHub CLI</span><span>CI / CD</span>
        </div>
      </div>
    </section>

    <!-- APPROACH / HOW IT WORKS -->
    <section id="features" style="max-width: 1240px; margin: 0 auto; padding: 8rem 2rem 4rem; display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 3rem; align-items: start">
      <div>
        <div style="color: #3DF59A; font-weight: 700; font-size: 1.4rem">How it works</div>
        <h2 style="margin: 1rem 0 0; font-weight: 800; font-size: clamp(2.4rem, 4.6vw, 3.8rem); line-height: 1.06; letter-spacing: -0.035em">New Session<br>Same Project<br>Zero Restart</h2>
      </div>
      <div style="display: flex; flex-direction: column; gap: 2.5rem; padding-top: 2.75rem">
        <p style="margin: 0; font-size: 1.6rem; line-height: 1.4; font-weight: 500; max-width: 24ch">EGC preserves and restores project context, so you keep moving without repeating setup.</p>
        <div style="display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap">
          <span style="color: #8C9690; font-size: 15px; max-width: 16ch; line-height: 1.4">Open source + commercial license</span>
          <button
            type="button"
            class="open-install-trigger"
            style="display: inline-flex; align-items: center; gap: 14px; min-height: 48px; padding: 0 6px 0 22px; border-radius: 999px; background: #10B866; color: #04200F; font-weight: 700; font-size: 15px; border: none; cursor: pointer"
          >
            Install EGC
            <span style="display: inline-flex; width: 36px; height: 36px; border-radius: 999px; background: #04200F; align-items: center; justify-content: center">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#3DF59A" stroke-width="2.6" stroke-linecap="round" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6"></path>
              </svg>
            </span>
          </button>
        </div>
      </div>
    </section>

    <!-- SESSION CARDS -->
    <section aria-label="Context across sessions" style="max-width: 1240px; margin: 0 auto; padding: 1rem 2rem 7rem; display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px">
      <div style="border-radius: 32px; padding: 2rem; min-height: 22rem; background: linear-gradient(170deg, #1B3A2A, #111614 60%); display: flex; flex-direction: column; gap: 1rem">
        <span style="align-self: flex-start; padding: 6px 14px; border-radius: 999px; background: rgba(255,255,255,0.08); font-size: 13px; font-weight: 600">Session 01 · VS Code</span>
        <div style="margin-top: auto; font-size: 1.6rem; font-weight: 700; line-height: 1.2">You work on a feature.</div>
        <div style="color: #A3ADA7; line-height: 1.55">Edited 12 files on <span style="font-family: 'JetBrains Mono', monospace; font-size: 14px">feature/auth</span>. Decisions get made along the way.</div>
      </div>
      <div style="border-radius: 32px; padding: 2rem; min-height: 22rem; background: radial-gradient(90% 80% at 50% 0%, #19D47A, #0B6B3C 60%, #0A3A22); display: flex; flex-direction: column; gap: 1rem">
        <span style="align-self: flex-start; padding: 6px 14px; border-radius: 999px; background: rgba(0,0,0,0.22); font-size: 13px; font-weight: 600">EGC keeps the context</span>
        <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-top: auto">
          <span style="padding: 8px 14px; border-radius: 999px; background: rgba(255,255,255,0.16); font-size: 14px; font-weight: 500">Project structure</span>
          <span style="padding: 8px 14px; border-radius: 999px; background: rgba(255,255,255,0.16); font-size: 14px; font-weight: 500">Key decisions</span>
          <span style="padding: 8px 14px; border-radius: 999px; background: rgba(255,255,255,0.16); font-size: 14px; font-weight: 500">Technical context</span>
          <span style="padding: 8px 14px; border-radius: 999px; background: rgba(255,255,255,0.16); font-size: 14px; font-weight: 500">Conventions</span>
          <span style="padding: 8px 14px; border-radius: 999px; background: rgba(255,255,255,0.16); font-size: 14px; font-weight: 500">Recent changes</span>
          <span style="padding: 8px 14px; border-radius: 999px; background: rgba(255,255,255,0.16); font-size: 14px; font-weight: 500">Workflows</span>
        </div>
        <div style="font-size: 1.6rem; font-weight: 700; line-height: 1.2">Kept with the project.</div>
      </div>
      <div style="border-radius: 32px; padding: 2rem; min-height: 22rem; background: linear-gradient(170deg, #1B3A2A, #111614 60%); display: flex; flex-direction: column; gap: 1rem">
        <span style="align-self: flex-start; padding: 6px 14px; border-radius: 999px; background: rgba(255,255,255,0.08); font-size: 13px; font-weight: 600">Session 02 · Terminal</span>
        <div style="margin-top: auto; font-family: 'JetBrains Mono', monospace; font-size: 14px; color: #3DF59A">&gt; egc restore — context ready</div>
        <div style="font-size: 1.6rem; font-weight: 700; line-height: 1.2">You pick up right where you left off.</div>
        <div style="color: #A3ADA7; line-height: 1.55">No repeated setup. Focus on what matters.</div>
      </div>
    </section>

    <!-- BEFORE / AFTER -->
    <section style="border-radius: 56px; background: #F3F6F4; color: #0C0F0E; margin: 0 1rem">
      <div style="max-width: 1240px; margin: 0 auto; padding: 6rem 2rem; display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 3rem">
        <div>
          <div style="color: #0B8F4E; font-weight: 700; font-size: 1.4rem">Before &amp; after</div>
          <h2 style="margin: 1rem 0 0; font-weight: 800; font-size: clamp(2.2rem, 4vw, 3.4rem); line-height: 1.06; letter-spacing: -0.035em">Why start over every time?</h2>
        </div>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 14px">
          <div style="padding: 1.75rem; border-radius: 28px; background: #E1E7E3; display: flex; flex-direction: column; gap: 14px">
            <span style="font-weight: 800; font-size: 1.2rem">Without EGC</span>
            <span style="color: #48534C">Repeating context in every session</span>
            <span style="color: #48534C">Losing important decisions</span>
            <span style="color: #48534C">Re-explaining project structure</span>
            <span style="color: #48534C">Slower workflows between tools</span>
          </div>
          <div style="padding: 1.75rem; border-radius: 28px; background: #0B7A44; color: #FFFFFF; display: flex; flex-direction: column; gap: 14px">
            <span style="font-weight: 800; font-size: 1.2rem">With EGC</span>
            <span>Context restored in every new session</span>
            <span>Decisions kept with the project</span>
            <span>Structure and conventions already known</span>
            <span>Switch tools, keep going</span>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section id="install" style="max-width: 1240px; margin: 0 auto; padding: 8rem 2rem 4rem; text-align: center; display: flex; flex-direction: column; align-items: center">
      <h2 style="margin: 0; font-weight: 800; font-size: clamp(2.6rem, 6vw, 5rem); line-height: 1; letter-spacing: -0.045em; max-width: 14ch">
        Stop rebuilding context <span style="color: #3DF59A">from zero.</span>
      </h2>
      <p style="margin: 1.5rem 0 0; font-size: 1.2rem; color: #A3ADA7">Windows · macOS · Linux — v1.1.0</p>
      <button
        type="button"
        class="open-install-trigger"
        style="margin-top: 2rem; display: inline-flex; align-items: center; gap: 14px; min-height: 56px; padding: 0 8px 0 28px; border-radius: 999px; background: #10B866; color: #04200F; font-weight: 700; font-size: 17px; border: none; cursor: pointer"
      >
        Install EGC
        <span style="display: inline-flex; width: 42px; height: 42px; border-radius: 999px; background: #04200F; align-items: center; justify-content: center">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#3DF59A" stroke-width="2.6" stroke-linecap="round" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </span>
      </button>
    </section>

    <footer style="max-width: 1240px; margin: 0 auto; padding: 2rem 2rem 3rem; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem; font-size: 13px; color: #8C9690; border-top: 1px solid #1E2421">
      <span>EGC — Extended Global Context</span>
      <span>MIT Licensed • Open Source</span>
    </footer>

  </div>

  <!-- MULTI-PLATFORM INSTALL MODAL -->
  <div
    id="install-modal"
    class="fixed inset-0 z-50 flex items-end sm:items-center justify-center p-0 sm:p-4 opacity-0 pointer-events-none invisible transition-all duration-200"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-headline"
  >
    <div id="install-modal-backdrop" class="fixed inset-0 bg-black/80 backdrop-blur-sm transition-opacity"></div>

    <div
      id="install-modal-panel"
      class="relative w-full sm:max-w-lg bg-[#141816] rounded-t-2xl sm:rounded-2xl border border-white/10 shadow-2xl overflow-hidden transition-all transform translate-y-full sm:translate-y-0 sm:scale-95"
    >
      <div class="flex items-center justify-between px-5 py-4 border-b border-white/10">
        <div class="flex items-center gap-2.5">
          <span class="w-2 h-2 rounded-full bg-[#10B866]"></span>
          <span id="modal-headline" class="font-bold text-sm text-[#F3F6F4]">Install EGC</span>
        </div>
        <button
          id="close-install-modal"
          type="button"
          aria-label="Close modal"
          class="text-[#A3ADA7] hover:text-[#F3F6F4] p-1 rounded-md transition-colors focus:outline-none"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <!-- Tabs -->
      <div class="flex border-b border-white/10 bg-[#0C0F0E]" role="tablist">
        <button
          type="button"
          role="tab"
          aria-selected="true"
          data-modal-tab="quick"
          class="modal-tab active px-4 py-2.5 text-xs font-mono font-medium text-[#F3F6F4] border-b-2 border-[#10B866] transition-colors"
        >
          Quick (npm)
        </button>
        <button
          type="button"
          role="tab"
          aria-selected="false"
          data-modal-tab="unix"
          class="modal-tab px-4 py-2.5 text-xs font-mono font-medium text-[#A3ADA7] hover:text-[#F3F6F4] border-b-2 border-transparent transition-colors"
        >
          macOS / Linux
        </button>
        <button
          type="button"
          role="tab"
          aria-selected="false"
          data-modal-tab="windows"
          class="modal-tab px-4 py-2.5 text-xs font-mono font-medium text-[#A3ADA7] hover:text-[#F3F6F4] border-b-2 border-transparent transition-colors"
        >
          Windows
        </button>
      </div>

      <!-- Panels -->
      <div id="modal-panel-quick" class="modal-panel p-5">
        <p class="text-xs text-[#A3ADA7] mb-3">Install globally via npm and initialize in your project:</p>
        <pre class="bg-[#0C0F0E] p-4 rounded-lg text-xs font-mono text-[#F3F6F4] overflow-x-auto border border-white/5"><code><span class="text-[#3DF59A]">$</span> npm install -g @egchq/egc
<span class="text-[#3DF59A]">$</span> egc init</code></pre>
      </div>

      <div id="modal-panel-unix" class="modal-panel hidden p-5">
        <p class="text-xs text-[#A3ADA7] mb-3">Install via automated shell script:</p>
        <pre class="bg-[#0C0F0E] p-4 rounded-lg text-xs font-mono text-[#F3F6F4] overflow-x-auto border border-white/5"><code><span class="text-[#3DF59A]">$</span> git clone https://github.com/Fmarzochi/EGC.git
<span class="text-[#3DF59A]">$</span> cd EGC &amp;&amp; ./scripts/install.sh</code></pre>
      </div>

      <div id="modal-panel-windows" class="modal-panel hidden p-5">
        <p class="text-xs text-[#A3ADA7] mb-3">Install via PowerShell (Node 20+ required):</p>
        <pre class="bg-[#0C0F0E] p-4 rounded-lg text-xs font-mono text-[#F3F6F4] overflow-x-auto border border-white/5"><code><span class="text-[#3DF59A]">PS&gt;</span> git clone https://github.com/Fmarzochi/EGC.git
<span class="text-[#3DF59A]">PS&gt;</span> cd EGC; .\scripts\install.ps1</code></pre>
      </div>

      <div class="px-5 py-3 border-t border-white/10 flex items-center justify-between text-xs">
        <span class="text-[#A3ADA7]">Works with Claude Code, Cursor, Codex &amp; more</span>
        <a href={`${base}docs/memory`} class="text-[#3DF59A] hover:underline font-medium">Documentation &rarr;</a>
      </div>
    </div>
  </div>

  <script>
    // Modal logic
    const modal = document.getElementById('install-modal');
    const panel = document.getElementById('install-modal-panel');
    const backdrop = document.getElementById('install-modal-backdrop');
    const openBtns = document.querySelectorAll('.open-install-trigger');
    const closeBtn = document.getElementById('close-install-modal');

    function openModal() {
      modal?.classList.remove('opacity-0', 'pointer-events-none', 'invisible');
      modal?.classList.add('opacity-100', 'pointer-events-auto', 'visible');
      panel?.classList.remove('translate-y-full', 'sm:scale-95');
      panel?.classList.add('translate-y-0', 'sm:scale-100');
      document.body.classList.add('overflow-hidden');
      closeBtn?.focus();
    }

    function closeModal() {
      modal?.classList.add('opacity-0', 'pointer-events-none', 'invisible');
      modal?.classList.remove('opacity-100', 'pointer-events-auto', 'visible');
      panel?.classList.add('translate-y-full', 'sm:scale-95');
      panel?.classList.remove('translate-y-0', 'sm:scale-100');
      document.body.classList.remove('overflow-hidden');
    }

    openBtns.forEach(btn => btn.addEventListener('click', openModal));
    closeBtn?.addEventListener('click', closeModal);
    backdrop?.addEventListener('click', closeModal);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && !modal.classList.contains('invisible')) {
        closeModal();
      }
    });

    document.querySelectorAll('.modal-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        const target = (tab as HTMLElement).dataset.modalTab;
        document.querySelectorAll('.modal-tab').forEach(t => {
          t.classList.remove('active', 'border-[#10B866]', 'text-[#F3F6F4]');
          t.classList.add('border-transparent', 'text-[#A3ADA7]');
        });
        document.querySelectorAll('.modal-panel').forEach(p => p.classList.add('hidden'));

        tab.classList.add('active', 'border-[#10B866]', 'text-[#F3F6F4]');
        tab.classList.remove('border-transparent', 'text-[#A3ADA7]');
        document.getElementById(`modal-panel-${target}`)?.classList.remove('hidden');
      });
    });
  </script>
</Base>
