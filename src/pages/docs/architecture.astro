---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { getBase } from '../../utils/base.ts';
const base = getBase();
---

<DocsLayout title="Architecture" description="How EGC works internally: two MCP servers, local SQLite, encrypted Markdown state files, one install command." current="architecture">

  <div class="pb-2 mb-8 border-b border-gray-200 dark:border-gray-800">
    <p class="text-xs font-semibold uppercase tracking-widest text-egc-600 dark:text-egc-400 mb-2">Reference</p>
    <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white mb-3">Architecture</h1>
    <p class="text-gray-600 dark:text-gray-400">Two MCP servers, local SQLite, encrypted Markdown state files, one install command. No cloud, no daemon, no config server.</p>
  </div>

  <!-- Diagram -->
  <section class="mb-10">
    <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Overview</h2>
    <figure class="architecture-figure">
      <p class="architecture-scroll-hint" id="architecture-scroll-hint">Scroll the diagram horizontally, or focus it and use the arrow keys.</p>
      <div class="architecture-scroll" role="region" aria-label="EGC architecture diagram" aria-describedby="architecture-scroll-hint architecture-diagram-caption" tabindex="0">
        <img src={`${base}architecture.svg`} alt="AI coding tools read the memory protocol from tool instruction files. Where MCP is registered, tools connect over stdio to egc-memory and egc-guardian. egc-memory reads and writes encrypted branch-scoped Markdown state and a local SQLite decision and session store." width="880" height="560" />
      </div>
      <figcaption id="architecture-diagram-caption">Tools use the installed memory protocol. Where registered, they also connect to the two local MCP servers over stdio. <a href={`${base}architecture.svg`} target="_blank" rel="noopener noreferrer">Open the full-size diagram (new tab)</a> to zoom.</figcaption>
    </figure>
  </section>

  <!-- Layers -->
  <section class="mb-10">
    <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Layers</h2>
    <div class="editorial-list">
      {[
        {
          n: '1',
          title: 'AI Tool Layer',
          desc: 'Claude Code, Cursor, Codex, Antigravity CLI, OpenCode, Devin Desktop, Amp, VS Code Copilot, Zed, Kiro, Trae, CodeBuddy, Junie, Goose, OpenHands, Aider, Warp, Cline, and Qwen Code: 19 managed install targets. Each tool reads state at session start and writes at session end: through the MCP servers where they are registered, and through the propagated context files everywhere else. The cognitive bootstrap injected by the installer writes this protocol into each tool\'s global instruction file.',
        },
        {
          n: '2',
          title: 'MCP Transport (stdio)',
          desc: 'Both servers communicate over stdio. The tool spawns them as child processes. No ports, no network, no daemon. Starts in under 100ms.',
        },
        {
          n: '3',
          title: 'egc-memory',
          desc: 'Handles all memory operations. Reads and writes Markdown state files scoped per project and git branch. Persists decisions to SQLite with BM25 full-text search. Runs the session bus so parallel sessions announce presence, claim paths, and hand work off without collisions.',
        },
        {
          n: '4',
          title: 'egc-guardian',
          desc: 'Validates commands and file writes before execution, scans untrusted content for prompt-injection patterns (validate_content, advisory only) and provides context utilities (reduce_context, orchestrate_task, auto_learn). Enforcement is wired at the harness level too: prompt routing and pre-tool hooks run on every session, and the Token Crusher compresses shell output before it reaches the model, with savings tracked in a local ledger (egc gain).',
        },
        {
          n: '5',
          title: 'Local Storage (~/.egc/)',
          desc: 'State files are Markdown, one per project branch, encrypted at rest with AES-256-GCM and integrity-checked with HMAC-SHA256. SQLite stores structured decision history for querying, and the crusher ledger records every token saving. Everything is local and never leaves your machine.',
        },
        {
          n: '6',
          title: 'Dashboard (localhost:7890)',
          desc: 'Real-time mission control launched right after install: live tool calls, token usage, provider comparison, session replay, and export to CSV/JSON. IDE hook emitters stream events from Cursor, Kiro, OpenCode, and CodeBuddy.',
        },
      ].map(step => (
        <div class="flex gap-4">
          <div class="shrink-0 w-7 text-egc-400 font-mono text-sm font-bold">{step.n.padStart(2, '0')}</div>
          <div>
            <h3 class="font-semibold text-gray-900 dark:text-white text-base mb-1">{step.title}</h3>
            <p class="text-sm text-gray-600 dark:text-gray-400">{step.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Design notes -->
  <section class="mb-10">
    <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Design notes</h2>
    <div class="rounded-xl border border-amber-200 dark:border-amber-900/50 bg-amber-50 dark:bg-amber-950/20 p-6">
      <h3 class="font-semibold text-amber-900 dark:text-amber-400 mb-2">Architectural consolidation</h3>
      <p class="text-sm text-amber-800 dark:text-amber-300 leading-relaxed">Earlier versions of EGC explored distributed runtime concepts: FederationManager, ReplayEngine, cognitive orchestration layers, multi-provider dispatching. Those experiments were real explorations, not deception. They helped define what the project actually needed to be.</p>
      <p class="text-sm text-amber-800 dark:text-amber-300 leading-relaxed mt-3">The current runtime reflects that consolidation. Two MCP servers, local SQLite, encrypted Markdown state files, one install command. The branch <code class="text-xs bg-amber-100 dark:bg-amber-900/30 px-1.5 py-0.5 rounded font-mono">legacy-runtime</code> preserves the full historical architecture for anyone who wants to study the evolution.</p>
    </div>
  </section>

</DocsLayout>
