---
import { getBase } from "../utils/base.ts";
const base = getBase();
---
<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title data-i18n="meta.title">EGC — Contexto que nunca zera · memória persistente para ferramentas de IA</title>
<meta name="description" data-i18n-attr="content:meta.desc" content="O EGC é um runtime local e open source que dá às 21 ferramentas de IA para programação da sua máquina a mesma memória do projeto, em toda sessão.">
<meta name="theme-color" content="#06221A">
<meta property="og:type" content="website">
<meta property="og:title" data-i18n-attr="content:meta.title" content="EGC — Contexto que nunca zera · memória persistente para ferramentas de IA">
<meta property="og:description" data-i18n-attr="content:meta.desc" content="O EGC é um runtime local e open source que dá às 21 ferramentas de IA para programação da sua máquina a mesma memória do projeto, em toda sessão.">
<meta property="og:image" content="https://fmarzochi.github.io/EGCSite/og.png">
<link rel="canonical" href="https://fmarzochi.github.io/EGCSite/">
<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`}>
<link rel="alternate" type="application/rss+xml" title="EGC Releases" href={`${base}rss.xml`}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:site" content="@MarzochiFelipe">
<meta name="twitter:title" content="EGC — Contexto que nunca zera">
<meta name="twitter:description" content="O EGC é um runtime local e open source que dá às 21 ferramentas de IA para programação da sua máquina a mesma memória do projeto, em toda sessão.">
<meta name="twitter:image" content="https://fmarzochi.github.io/EGCSite/og.png">
<script data-goatcounter="https://egc.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap">
<script is:inline>
  (function () {
    var d = document.documentElement; d.classList.add('js');
    try { var l = localStorage.getItem('egc-lang'); if (l === 'en' || l === 'pt') d.setAttribute('data-lang-init', l); } catch { /* ignore */ }
  })();
</script>
<style is:inline>/* ==========================================================================
   EGC — Home refinada · design system
   Grid      12 col · conteúdo máx. 1360px · gutter 16 / 24 / 40
   Espaço    escala 4pt (--s-1 … --s-10) · seções clamp(88–160px)
   Tipo      Plus Jakarta Sans (display/texto) · JetBrains Mono (voz do sistema)
   Paleta    grafite + verde profundo + menta, amostrada dos mockups da marca
   Movimento uma família de curvas, três durações; reduced‑motion = estático
   ========================================================================== */
:root {
  --ink-950: #0A0D0C; --ink-900: #0D100F; --ink-850: #111614; --ink-800: #161C19; --ink-700: #1F2723;
  --line: rgba(226, 240, 233, .09); --line-strong: rgba(226, 240, 233, .16);
  --green-950: #06221A; --green-900: #082C1D; --green-800: #0A3D27; --green-700: #0E7A48; --green-600: #12A35F; --green-500: #18B669;
  --mint-400: #3DF69B; --mint-300: #72F7B6; --mint-200: #B4F8D6;
  --coral: #FF9A86;
  --paper: #F4F6F5; --paper-2: #E2E7E4; --paper-ink: #0D100F;
  --text: #F4F6F5; --text-2: rgba(244, 246, 245, .7); --text-3: rgba(244, 246, 245, .5);
  --f-sans: 'Plus Jakarta Sans', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  --f-mono: 'JetBrains Mono', ui-monospace, 'SFMono-Regular', Consolas, monospace;
  --s-1: 4px; --s-2: 8px; --s-3: 12px; --s-4: 16px; --s-5: 24px; --s-6: 32px; --s-7: 48px; --s-8: 64px; --s-9: 96px; --s-10: 144px;
  --section-y: clamp(88px, 10vw, 160px);
  --max: 1360px; --gutter: 16px;
  --ease-out: cubic-bezier(.16, 1, .3, 1); --ease-in-out: cubic-bezier(.65, 0, .35, 1);
  --d-fast: 180ms; --d-base: 420ms; --d-slow: 900ms;
  --radius-lg: 24px; --radius-md: 16px; --radius-sm: 10px;
  --hdr-h: 76px;
  color-scheme: dark;
}
@media (min-width: 640px) { :root { --gutter: 24px; } }
@media (min-width: 1024px) { :root { --gutter: 40px; } }

*, *::before, *::after { box-sizing: border-box; }
html { overflow-x: clip; scroll-behavior: smooth; scroll-padding-top: calc(var(--hdr-h) + 8px); -webkit-text-size-adjust: 100%; text-size-adjust: 100%; background: var(--ink-950); }
body {
  margin: 0; overflow-x: clip; background: var(--ink-950); color: var(--text);
  font-family: var(--f-sans); font-size: 17px; line-height: 1.6;
  -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility;
}
img, svg { max-width: 100%; }
[hidden] { display: none !important; }
img { display: block; }
h1, h2, h3, p, ul, ol, figure { margin: 0; }
ul, ol { padding: 0; list-style: none; }
button { font: inherit; color: inherit; }
::selection { background: var(--mint-400); color: var(--ink-950); }
a { color: inherit; text-decoration: none; }
:focus-visible { outline: 2px solid var(--mint-400); outline-offset: 3px; border-radius: 6px; }
.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
.skip-link {
  position: fixed; top: 12px; left: 12px; z-index: 300; padding: 10px 16px; border-radius: 999px;
  background: var(--mint-400); color: var(--ink-950); font-weight: 700;
  transform: translateY(-160%); transition: transform var(--d-fast) var(--ease-out);
}
.skip-link:focus { transform: none; }
.wrap { width: 100%; max-width: calc(var(--max) + var(--gutter) * 2); margin-inline: auto; padding-inline: var(--gutter); }
.grain::after {
  content: ''; position: absolute; inset: 0; pointer-events: none; z-index: 0; opacity: .06; mix-blend-mode: overlay;
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
}

/* ---------- type ---------------------------------------------------------- */
.eyebrow { display: inline-flex; align-items: center; gap: var(--s-3); font: 500 12px/1.4 var(--f-mono); letter-spacing: .14em; text-transform: uppercase; color: var(--text-3); }
.eyebrow b { color: var(--mint-400); font-weight: 500; }
.eyebrow::before { content: ''; width: 24px; height: 1px; background: currentColor; opacity: .6; }
.h-section { font-weight: 800; font-size: clamp(38px, 5.4vw, 84px); line-height: .98; letter-spacing: -.045em; margin-top: var(--s-5); text-wrap: balance; }
.h-section em { font-style: normal; color: var(--mint-400); }
.lede { font-size: clamp(17px, 1.3vw, 19px); line-height: 1.6; color: var(--text-2); max-width: 36em; text-wrap: pretty; }
code { font-family: var(--f-mono); font-size: .88em; padding: .1em .4em; border-radius: 6px; background: rgba(61, 246, 155, .08); color: var(--mint-300); }
.mono { font-family: var(--f-mono); }

/* ---------- buttons -------------------------------------------------------- */
.btn {
  --bg: var(--mint-400); --fg: var(--ink-950);
  position: relative; display: inline-flex; align-items: center; justify-content: center; gap: var(--s-3);
  min-height: 52px; padding: 6px 6px 6px 24px; border: 0; border-radius: 999px;
  background: var(--bg); color: var(--fg); font: 700 16px/1 var(--f-sans); letter-spacing: -.01em;
  cursor: pointer; white-space: nowrap;
  transition: transform var(--d-fast) var(--ease-out), background-color var(--d-fast), box-shadow var(--d-base) var(--ease-out);
}
.btn__icon { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--ink-950); color: var(--mint-400); transition: transform var(--d-base) var(--ease-out); }
.btn:hover { background: var(--mint-300); box-shadow: 0 10px 40px -10px rgba(61, 246, 155, .5); }
.btn:hover .btn__icon { transform: translateX(3px); }
.btn:active { transform: scale(.97); }
.btn:focus-visible { outline-offset: 4px; border-radius: 999px; }
.btn--ghost { --bg: transparent; --fg: var(--text); padding: 6px 8px 6px 22px; box-shadow: inset 0 0 0 1px var(--line-strong); }
.btn--ghost .btn__icon { background: rgba(244, 246, 245, .08); color: var(--text); }
.btn--ghost:hover { background: rgba(244, 246, 245, .06); box-shadow: inset 0 0 0 1px rgba(244, 246, 245, .34); }
.btn--ghost:hover .btn__icon { transform: translateY(2px); }
.btn--sm { min-height: 44px; padding: 4px 4px 4px 18px; font-size: 14px; }
.btn--sm .btn__icon { width: 36px; height: 36px; }
.btn--plain { padding: 6px 22px; }
.link-arrow {
  display: inline-flex; align-items: center; gap: var(--s-2); min-height: 44px; font-weight: 600; font-size: 15px; color: var(--mint-400);
  background: linear-gradient(currentColor, currentColor) 0 calc(100% - 10px) / 0 1px no-repeat; transition: background-size var(--d-base) var(--ease-out);
}
.link-arrow:hover { background-size: 100% 1px; }
.link-arrow svg { transition: transform var(--d-base) var(--ease-out); }
.link-arrow:hover svg { transform: translateX(4px); }

/* command pill + copy */
.cmd {
  display: inline-flex; align-items: center; gap: var(--s-3); max-width: 100%; min-width: 0;
  min-height: 44px; padding: 4px 4px 4px 16px; border-radius: 999px;
  background: rgba(13, 16, 15, .6); box-shadow: inset 0 0 0 1px var(--line);
  font: 500 13px/1.2 var(--f-mono); color: var(--text-2);
}
.cmd__prompt { color: var(--mint-400); user-select: none; }
.cmd__text { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
.copy-btn {
  flex: none; position: relative; display: inline-flex; align-items: center; gap: 6px; height: 36px; padding: 0 12px; border: 0; border-radius: 999px;
  background: rgba(244, 246, 245, .07); color: var(--text-2); font: 500 12px/1 var(--f-mono); cursor: pointer;
  transition: background-color var(--d-fast), color var(--d-fast);
}
.copy-btn:hover { background: rgba(244, 246, 245, .13); color: var(--text); }
.copy-btn[data-state='done'] { background: rgba(61, 246, 155, .16); color: var(--mint-400); }
.copy-btn[data-state='error'] { background: rgba(255, 154, 134, .14); color: var(--coral); }
.copy-btn .i-done { display: none; }
.copy-btn[data-state='done'] .i-copy { display: none; }
.copy-btn[data-state='done'] .i-done { display: inline; animation: pop .45s var(--ease-out); }
@keyframes pop { 0% { transform: scale(.2) rotate(-30deg); } 70% { transform: scale(1.25); } 100% { transform: none; } }

/* language switch */
.lang { display: inline-flex; align-items: center; padding: 3px; border-radius: 999px; box-shadow: inset 0 0 0 1px var(--line-strong); }
.lang button {
  min-width: 40px; height: 36px; padding: 0 10px; border: 0; border-radius: 999px; background: transparent; color: var(--text-3);
  font: 600 12px/1 var(--f-mono); letter-spacing: .06em; cursor: pointer; transition: background-color var(--d-fast), color var(--d-fast);
}
.lang button:hover { color: var(--text); }
.lang button[aria-pressed='true'] { background: var(--text); color: var(--ink-950); }
.lang__sep { width: 1px; height: 14px; background: var(--line-strong); margin: 0 1px; }

/* ==========================================================================
   Header
   ========================================================================== */
.hdr { position: fixed; inset: 0 0 auto 0; z-index: 100; padding-top: env(safe-area-inset-top, 0px); transition: background-color var(--d-base), box-shadow var(--d-base); }
.hdr[data-scrolled='true'] { background: rgba(10, 13, 12, .8); backdrop-filter: blur(16px) saturate(140%); -webkit-backdrop-filter: blur(16px) saturate(140%); box-shadow: 0 1px 0 var(--line); }
.hdr__bar { display: flex; align-items: center; justify-content: space-between; height: var(--hdr-h); gap: var(--s-4); }
.brand { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; font-weight: 800; font-size: 22px; letter-spacing: -.03em; }
.brand .egc-mark { width: 30px; height: 30px; transition: transform var(--d-slow) var(--ease-out); }
.brand:hover .egc-mark { transform: rotate(90deg); }
.nav { display: none; }
.nav a { position: relative; display: inline-flex; align-items: center; min-height: 44px; padding: 0 12px; font-size: 15px; font-weight: 500; color: var(--text-2); transition: color var(--d-fast); }
.nav a::after { content: ''; position: absolute; left: 12px; right: 12px; bottom: 8px; height: 1px; background: var(--mint-400); transform: scaleX(0); transform-origin: left; transition: transform var(--d-base) var(--ease-out); }
.nav a:hover, .nav a[aria-current='true'] { color: var(--text); }
.nav a:hover::after, .nav a[aria-current='true']::after { transform: scaleX(1); }
.hdr__actions { display: flex; align-items: center; gap: var(--s-2); }
.hdr__gh { display: none; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 50%; color: var(--text-2); transition: color var(--d-fast), background-color var(--d-fast); }
.hdr__gh:hover { color: var(--text); background: rgba(244, 246, 245, .07); }
.hdr__cta, .hdr .lang { display: none; }
.burger { display: flex; flex-direction: column; align-items: center; justify-content: center; width: 48px; height: 48px; border: 0; border-radius: 50%; background: rgba(244, 246, 245, .07); cursor: pointer; }
.burger span { display: block; width: 18px; height: 1.5px; background: currentColor; transition: transform var(--d-base) var(--ease-out); }
.burger span + span { margin-top: 5px; }
.burger[aria-expanded='true'] span:first-child { transform: translateY(3.25px) rotate(45deg); }
.burger[aria-expanded='true'] span:last-child { transform: translateY(-3.25px) rotate(-45deg); }
.mnav {
  position: fixed; inset: 0; z-index: 90; padding: calc(var(--hdr-h) + 24px + env(safe-area-inset-top, 0px)) var(--gutter) calc(var(--s-7) + env(safe-area-inset-bottom, 0px));
  background: var(--ink-950); display: flex; flex-direction: column; gap: var(--s-6); overflow-y: auto;
  visibility: hidden; opacity: 0; transition: opacity var(--d-base) var(--ease-out), visibility 0s linear var(--d-base);
}
.mnav[data-open='true'] { visibility: visible; opacity: 1; transition-delay: 0s; }
.mnav ul { border-top: 1px solid var(--line); }
.mnav li { border-bottom: 1px solid var(--line); }
.mnav li a { display: flex; align-items: center; justify-content: space-between; min-height: 60px; font-size: 26px; font-weight: 700; letter-spacing: -.03em; }
.mnav li a span { font: 500 12px var(--f-mono); color: var(--text-3); }
.mnav[data-open='true'] li { animation: rise .5s var(--ease-out) both; }
.mnav[data-open='true'] li:nth-child(2) { animation-delay: .04s; } .mnav[data-open='true'] li:nth-child(3) { animation-delay: .08s; }
.mnav[data-open='true'] li:nth-child(4) { animation-delay: .12s; } .mnav[data-open='true'] li:nth-child(5) { animation-delay: .16s; } .mnav[data-open='true'] li:nth-child(6) { animation-delay: .2s; }
.mnav__row { display: flex; align-items: center; justify-content: space-between; gap: var(--s-4); font: 500 12px var(--f-mono); color: var(--text-3); letter-spacing: .1em; text-transform: uppercase; }
.mnav .btn { align-self: stretch; }
@media (min-width: 1100px) {
  .nav { display: flex; align-items: center; }
  .hdr__gh, .hdr__cta, .hdr .lang { display: inline-flex; }
  .burger, .mnav { display: none; }
}
@media (min-width: 640px) and (max-width: 1099px) { .hdr .lang { display: inline-flex; } }

/* ==========================================================================
   Hero
   ========================================================================== */
.hero {
  position: relative; isolation: isolate; overflow: hidden; min-height: min(100svh, 980px);
  padding-top: calc(var(--hdr-h) + 40px); display: flex; flex-direction: column;
  background:
    radial-gradient(55% 70% at 80% 42%, rgba(18, 163, 95, .5) 0%, rgba(14, 122, 72, .2) 40%, rgba(10, 13, 12, 0) 70%),
    radial-gradient(40% 50% at 8% 0%, rgba(14, 122, 72, .2), rgba(10, 13, 12, 0) 70%),
    linear-gradient(180deg, var(--green-950) 0%, var(--ink-950) 85%);
}
.hero__glow {
  position: absolute; z-index: -1; pointer-events: none; width: min(1100px, 120vw); aspect-ratio: 1; right: -18vw; top: 50%;
  translate: calc(var(--mx, 0) * 34px) calc(-50% + var(--my, 0) * 26px);
  background: radial-gradient(closest-side, rgba(61, 246, 155, .24), rgba(24, 182, 105, .08) 52%, transparent 72%);
}
.hero__main { --fs: clamp(68px, 14.2vw, 224px); position: relative; flex: 1; display: flex; flex-direction: column; justify-content: center; padding-bottom: var(--s-8); }
.hero__eyebrow { position: relative; z-index: 4; color: var(--text-2); }
.hero__title { position: relative; margin-top: var(--s-5); font-weight: 800; letter-spacing: -.055em; line-height: .86; }
.hero__l1 { position: relative; z-index: 1; display: block; width: max-content; max-width: 100%; font-size: var(--fs); translate: calc(var(--mx, 0) * -8px) calc(var(--my, 0) * -5px); }
.hero__l2 { position: relative; z-index: 4; display: block; margin-top: .16em; font-size: clamp(38px, 6.2vw, 98px); letter-spacing: -.045em; line-height: .95; }
.hero__l2 em { font-style: normal; color: var(--mint-400); }
.hero__stage {
  position: absolute; z-index: 2; pointer-events: none; width: min(46vw, 700px); aspect-ratio: 1; top: 50%; translate: 0 -50%;
  right: -5vw;
}
.hero__stage-inner { position: absolute; inset: 0; translate: calc(var(--mx, 0) * 18px) calc(var(--my, 0) * 14px); }
.hero__mark { position: absolute; inset: 15%; filter: drop-shadow(0 40px 60px rgba(2, 30, 18, .55)); }
.hero__mark .egc-mark { width: 100%; height: 100%; }
.hero__orbits { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; translate: calc(var(--mx, 0) * 30px) calc(var(--my, 0) * 22px); }
.hero__orbits circle { fill: none; stroke: rgba(180, 248, 214, .2); stroke-width: 1; vector-effect: non-scaling-stroke; }
.hero__orbits .o-dash { stroke-dasharray: 2 9; stroke: rgba(180, 248, 214, .28); }
.hero__cap { position: absolute; left: 50%; bottom: 2%; translate: -50% 0; white-space: nowrap; font: 500 12px/1 var(--f-mono); color: var(--text-3); letter-spacing: .08em; }
.hero__cap b { color: var(--mint-400); font-weight: 500; }
.hero__foot { position: relative; z-index: 4; margin-top: clamp(28px, 3.2vw, 48px); display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s-6); max-width: 620px; }
.hero__foot > * { min-width: 0; }
.hero__copy { max-width: 31em; font-size: clamp(17px, 1.3vw, 19px); line-height: 1.6; color: var(--text-2); text-wrap: pretty; }
.hero__copy strong { color: var(--text); font-weight: 600; }
.hero__actions { display: flex; flex-wrap: wrap; gap: var(--s-3); }
.hero__sub { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-3) var(--s-5); }
.hero__meta { display: flex; flex-wrap: wrap; gap: 4px 16px; font: 500 12px/1.4 var(--f-mono); color: var(--text-3); }
.hero__meta li { display: inline-flex; align-items: center; }
.hero__meta li + li::before { content: ''; width: 3px; height: 3px; border-radius: 50%; background: currentColor; margin-right: 16px; }
.hero__meta a { color: var(--text-2); text-decoration: underline; text-decoration-color: var(--line-strong); text-underline-offset: 3px; }
.hero__meta a:hover { color: var(--mint-400); }
@media (min-width: 1024px) {
  .hero__stage { right: auto; left: calc(var(--gutter) + var(--l1w, calc(4.6 * var(--fs))) - .25 * min(46vw, 700px)); }
}
@media (min-width: 768px) and (max-width: 1023px) {
  .hero__stage { width: 56vw; right: -14vw; translate: 0 -66%; }
}
@media (max-width: 767px) {
  .hero { padding-top: calc(var(--hdr-h) + 8px); min-height: 0; }
  .hero__main { justify-content: flex-start; padding-bottom: var(--s-7); }
  .hero__stage { position: relative; right: auto; top: auto; translate: none; width: 74vw; max-width: 360px; margin: 0 -12vw 0 auto; }
  .hero__cap { display: none; }
  .hero__glow { right: -50vw; top: 20%; }
  .hero__eyebrow { order: -1; }
  .hero__title { margin-top: -4vw; }
  .hero__l1 { font-size: clamp(52px, 18vw, 120px); }
  .hero__l2 { font-size: clamp(34px, 10.4vw, 62px); }
  .hero__actions { display: grid; grid-template-columns: 1fr; }
  .hero__actions .btn { width: 100%; }
  .hero__sub .cmd { width: 100%; }
}

/* ==========================================================================
   Sections
   ========================================================================== */
.sec { position: relative; padding-block: var(--section-y); isolation: isolate; }
.sec__head { display: grid; gap: var(--s-5); margin-bottom: clamp(40px, 5vw, 80px); }
@media (min-width: 1024px) { .sec__head--split { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); align-items: end; column-gap: var(--s-8); } }

/* ---------- benefit -------------------------------------------------------- */
.ben { background: linear-gradient(180deg, var(--ink-950), var(--ink-900)); }
.ben__grid { display: grid; gap: var(--s-7); }
.ben__voices { margin-top: var(--s-6); display: grid; gap: 10px; }
.ben__voices li { font: 500 14px/1.5 var(--f-mono); color: rgba(244, 246, 245, .42); }
.ben__voices li span { color: var(--text-3); margin-right: 6px; }
.ben__voices li s { text-decoration-color: rgba(255, 154, 134, .6); }
.lanes { position: relative; border-radius: var(--radius-lg); overflow: hidden; background: linear-gradient(180deg, var(--ink-850), var(--ink-900)); box-shadow: inset 0 0 0 1px var(--line), 0 40px 80px -40px rgba(0, 0, 0, .8); }
.lanes__cols { display: grid; grid-template-columns: 120px repeat(3, minmax(0, 1fr)); border-bottom: 1px solid var(--line); font: 500 12px/1 var(--f-mono); color: var(--text-3); }
.lanes__cols > * { padding: 16px; }
.lanes__cols > * + * { border-left: 1px dashed var(--line); }
.lane { display: grid; grid-template-columns: 120px minmax(0, 1fr); }
.lane + .lane { border-top: 1px solid var(--line); }
.lane__name { padding: 20px 16px; display: flex; flex-direction: column; gap: 6px; }
.lane__name b { font-size: 16px; font-weight: 700; }
.lane__name small { font: 500 11px/1.4 var(--f-mono); color: var(--text-3); }
.lane__plot { position: relative; height: 150px; border-left: 1px solid var(--line); }
.lane__plot svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
.lane__plot .gridline { stroke: var(--line); stroke-dasharray: 3 5; vector-effect: non-scaling-stroke; }
.lane__plot .path { fill: none; stroke-width: 2; vector-effect: non-scaling-stroke; stroke-linejoin: round; }
.lane--without .path { stroke: rgba(244, 246, 245, .5); }
.lane--without .area { fill: url(#gradWithout); }
.lane--with .path { stroke: var(--mint-400); }
.lane--with .area { fill: url(#gradWith); }
.lane__tag { position: absolute; right: 12px; top: 12px; font: 500 11px/1 var(--f-mono); padding: 6px 9px; border-radius: 999px; background: rgba(244, 246, 245, .06); color: var(--text-3); }
.lane--with .lane__tag { background: rgba(61, 246, 155, .12); color: var(--mint-400); }
.lanes__foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; padding: 14px 16px; border-top: 1px solid var(--line); font: 500 12px var(--f-mono); color: var(--text-3); }
.lanes__foot .ok { color: var(--mint-400); }
.compare { display: grid; gap: var(--s-3); margin-top: var(--s-4); }
.compare__col { padding: 22px 22px 20px; border-radius: var(--radius-md); }
.compare__col h3 { margin-bottom: 10px; font-size: 16px; font-weight: 700; }
.compare__col ul { display: grid; gap: 6px; font-size: 15px; line-height: 1.45; }
.compare__col li { display: flex; gap: 10px; }
.compare__col li::before { content: ''; flex: none; width: 6px; height: 6px; margin-top: .55em; border-radius: 50%; background: currentColor; opacity: .5; }
.compare__col--without { background: var(--paper-2); color: #3D4642; }
.compare__col--without h3 { color: var(--paper-ink); }
.compare__col--with { background: linear-gradient(135deg, #0F7A45, #0B5E36); color: rgba(244, 246, 245, .9); }
.compare__col--with h3 { color: #fff; }
@media (min-width: 640px) { .compare { grid-template-columns: 1fr 1fr; } }
@media (min-width: 1024px) { .ben__grid { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); column-gap: var(--s-8); align-items: center; } }
@media (max-width: 639px) {
  .lanes__cols, .lane { grid-template-columns: 88px minmax(0, 1fr); }
  .lanes__cols > :nth-child(n+3) { display: none; }
  .lane__plot { height: 120px; }
  .lane__name { padding: 14px 12px; }
}

/* ---------- demo ----------------------------------------------------------- */
.demo-sec { background: var(--ink-900); border-top: 1px solid var(--line); }
.demo-sec::before { content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none; background: radial-gradient(60% 50% at 50% 60%, rgba(14, 122, 72, .22), transparent 70%); }
.demo { border-radius: var(--radius-lg); background: linear-gradient(180deg, var(--ink-850), var(--ink-950)); box-shadow: inset 0 0 0 1px var(--line-strong), 0 60px 120px -50px rgba(0, 0, 0, .9); overflow: hidden; }
.demo__top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--s-3); padding: 14px 16px 14px 20px; border-bottom: 1px solid var(--line); }
.demo__badge { display: inline-flex; align-items: center; gap: 10px; flex-wrap: wrap; }
.demo__badge b { display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px; border-radius: 999px; background: rgba(61, 246, 155, .1); color: var(--mint-400); font: 500 12px/1 var(--f-mono); letter-spacing: .04em; }
.demo__badge b::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
.demo__badge small { font-size: 13px; color: var(--text-3); }
.demo__ctrls { display: flex; gap: 6px; }
.ctrl {
  display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 16px; border: 0; border-radius: 999px; cursor: pointer;
  background: rgba(244, 246, 245, .07); color: var(--text); font: 600 14px/1 var(--f-sans); transition: background-color var(--d-fast), transform var(--d-fast);
}
.ctrl:hover { background: rgba(244, 246, 245, .14); }
.ctrl:active { transform: scale(.96); }
.ctrl--main { background: var(--mint-400); color: var(--ink-950); }
.ctrl--main:hover { background: var(--mint-300); }
.ctrl .i-pause { display: none; }
.ctrl[data-playing='true'] .i-pause { display: inline; }
.ctrl[data-playing='true'] .i-play { display: none; }

.demo__stage { position: relative; display: grid; gap: var(--s-4); padding: clamp(16px, 3vw, 40px); align-items: center; }
@media (min-width: 900px) { .demo__stage { grid-template-columns: minmax(0, 1fr) 200px minmax(0, 1fr); gap: 0; } }
.win { position: relative; border-radius: var(--radius-md); background: var(--ink-950); box-shadow: inset 0 0 0 1px var(--line-strong), 0 30px 60px -30px rgba(0, 0, 0, .9); overflow: hidden; min-height: 300px; transition: opacity .7s var(--ease-out), filter .7s var(--ease-out), transform .7s var(--ease-out), box-shadow .7s; }
.win__bar { display: flex; align-items: center; gap: 6px; padding: 12px 14px; border-bottom: 1px solid var(--line); font: 500 12px var(--f-mono); color: var(--text-3); }
.win__bar i { width: 9px; height: 9px; border-radius: 50%; background: rgba(244, 246, 245, .14); }
.win__bar span { margin-left: 6px; }
.win__body { padding: 16px; display: grid; gap: 10px; font-size: 14px; line-height: 1.5; }
.msg { max-width: 92%; padding: 10px 12px; border-radius: 12px; }
.msg--u { justify-self: end; background: rgba(244, 246, 245, .08); }
.msg--ai { background: rgba(61, 246, 155, .07); color: var(--text-2); box-shadow: inset 0 0 0 1px rgba(61, 246, 155, .12); }
.sys { font: 500 12px/1.5 var(--f-mono); color: var(--mint-400); }
.sys--dim { color: var(--text-3); }
.dcard { display: grid; gap: 4px; padding: 12px 14px; border-radius: 12px; background: linear-gradient(135deg, rgba(18, 163, 95, .28), rgba(10, 61, 39, .5)); box-shadow: inset 0 0 0 1px rgba(61, 246, 155, .35); }
.dcard small { font: 500 11px var(--f-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--mint-300); }
.dcard b { font: 600 14px var(--f-mono); color: #fff; }
.win__closed { position: absolute; inset: 44px 0 0; display: grid; place-items: center; background: rgba(10, 13, 12, .72); backdrop-filter: blur(2px); font: 500 13px var(--f-mono); color: var(--text-2); }
.win__closed span { padding: 8px 14px; border-radius: 999px; box-shadow: inset 0 0 0 1px var(--line-strong); }
.win__wait { font: 500 13px var(--f-mono); color: var(--text-3); padding: 24px 0; text-align: center; }
.progress { height: 4px; border-radius: 4px; background: rgba(244, 246, 245, .08); overflow: hidden; }
.progress i { display: block; height: 100%; width: 0; background: linear-gradient(90deg, var(--green-600), var(--mint-400)); }
.core { position: relative; display: grid; justify-items: center; gap: 8px; padding: var(--s-4) 0; text-align: center; }
.core__mark { position: relative; width: 104px; height: 104px; }
.core__mark .egc-mark { width: 100%; height: 100%; }
.core__mark::after { content: ''; position: absolute; inset: -14px; border-radius: 50%; border: 1px dashed rgba(180, 248, 214, .2); }
.core__path { font: 600 14px var(--f-mono); color: var(--text); }
.core small { font: 500 11px/1.4 var(--f-mono); color: var(--text-3); max-width: 18ch; }
.core .dcard { margin-top: 6px; }
.wire { display: none; }
@media (min-width: 900px) {
  .wire { display: block; position: absolute; top: 50%; height: 2px; width: 34px; background: var(--line-strong); overflow: hidden; }
  .wire--a { left: -2px; } .wire--b { right: -2px; }
  .wire::after { content: ''; position: absolute; inset: 0; width: 40%; background: var(--mint-400); translate: -110% 0; }
}
@media (max-width: 899px) { .win { min-height: 0; } }

/* demo states — JS adds .on-N for every step reached; .cur-N for the current step */
.demo .at { opacity: 0; transform: translateY(10px); transition: opacity .6s var(--ease-out), transform .6s var(--ease-out); }
.demo.on-1 .at1, .demo.on-2 .at2, .demo.on-3 .at3, .demo.on-4 .at4, .demo.on-5 .at5 { opacity: 1; transform: none; }
.demo .until3 { transition: opacity .5s var(--ease-out); }
.demo.on-3 .until3 { display: none; }
.demo.on-2 .win--a { opacity: .5; filter: saturate(.3); }
.demo .win--b { opacity: .45; }
.demo.on-3 .win--b { opacity: 1; box-shadow: inset 0 0 0 1px rgba(61, 246, 155, .35), 0 30px 60px -30px rgba(0, 0, 0, .9); }
.demo.cur-1 .win--a { box-shadow: inset 0 0 0 1px rgba(61, 246, 155, .35), 0 30px 60px -30px rgba(0, 0, 0, .9); }
.demo.cur-2 .core__mark, .demo.cur-4 .core__mark { animation: corePulse 1.4s var(--ease-out); }
@keyframes corePulse { 0% { transform: scale(1); } 40% { transform: scale(1.08); } 100% { transform: scale(1); } }
.demo.cur-2 .wire--a::after, .demo.cur-4 .wire--b::after { animation: wire 1.1s var(--ease-in-out) 2; }
@keyframes wire { to { translate: 260% 0; } }
.demo.cur-5 .progress i, .demo.on-5:not(.playing) .progress i { animation: fill 3s var(--ease-in-out) forwards; }
@keyframes fill { to { width: 72%; } }

.demo__steps { display: grid; border-top: 1px solid var(--line); }
@media (min-width: 900px) { .demo__steps { grid-template-columns: repeat(5, minmax(0, 1fr)); } }
.demo__steps li + li { border-top: 1px solid var(--line); }
@media (min-width: 900px) { .demo__steps li + li { border-top: 0; border-left: 1px solid var(--line); } }
.step {
  position: relative; display: grid; gap: 6px; width: 100%; height: 100%; padding: 18px 18px 20px; border: 0; background: transparent; text-align: left; cursor: pointer;
  color: var(--text-3); transition: color var(--d-base), background-color var(--d-fast);
}
.step:hover { background: rgba(244, 246, 245, .03); color: var(--text-2); }
.step__n { font: 500 12px var(--f-mono); }
.step__t { font-size: 15px; font-weight: 700; line-height: 1.3; color: inherit; }
.step__d { font-size: 13.5px; line-height: 1.5; color: var(--text-3); display: none; }
.step__bar { position: absolute; left: 0; right: 0; top: 0; height: 2px; background: transparent; }
.step__bar i { display: block; height: 100%; width: 0; background: var(--mint-400); }
.step[aria-current='step'] { color: var(--text); }
.step[aria-current='step'] .step__n { color: var(--mint-400); }
.step[aria-current='step'] .step__d { display: block; }
.step.done .step__bar i { width: 100%; background: rgba(61, 246, 155, .4); }
@media (min-width: 900px) { .step__d { display: block; } }

/* ---------- features -------------------------------------------------------- */
.fx { background: var(--ink-950); border-top: 1px solid var(--line); }
.fx::before { content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none; background: radial-gradient(45% 40% at 15% 35%, rgba(14, 122, 72, .22), transparent 70%); }
.fx__layout { display: grid; gap: var(--s-6); }
.fx__visual { display: none; }
.fitem { position: relative; display: grid; gap: var(--s-5); padding: var(--s-6) 0; border-top: 1px solid var(--line); transition: opacity var(--d-slow) var(--ease-out); }
.fitem:last-child { border-bottom: 1px solid var(--line); }
.fitem__num { display: flex; align-items: center; gap: var(--s-3); font: 500 13px var(--f-mono); color: var(--mint-400); }
.fitem__num .egc-mark { width: 34px; height: 34px; }
.fitem__num span { color: var(--text-3); }
.fitem h3 { margin: var(--s-3) 0 var(--s-2); font-size: clamp(24px, 2.4vw, 34px); font-weight: 800; line-height: 1.08; letter-spacing: -.035em; text-wrap: balance; }
.fitem__short { color: var(--text-2); max-width: 34em; }
.fitem details { margin-top: var(--s-4); border-radius: var(--radius-sm); box-shadow: inset 0 0 0 1px var(--line); }
.fitem summary {
  display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); min-height: 44px; padding: 0 14px; cursor: pointer; list-style: none;
  font: 500 13px var(--f-mono); color: var(--text-2); transition: color var(--d-fast);
}
.fitem summary::-webkit-details-marker { display: none; }
.fitem summary:hover { color: var(--text); }
.fitem summary i { position: relative; width: 12px; height: 12px; flex: none; }
.fitem summary i::before, .fitem summary i::after { content: ''; position: absolute; left: 0; top: 50%; width: 12px; height: 1.5px; background: currentColor; translate: 0 -50%; transition: rotate var(--d-base) var(--ease-out); }
.fitem summary i::after { rotate: 90deg; }
.fitem details[open] summary i::after { rotate: 0deg; }
.fitem__more { padding: 0 14px 14px; display: grid; gap: 10px; font-size: 15px; color: var(--text-2); overflow: hidden; }
.fitem__proof { padding: 10px 12px; border-radius: 8px; background: rgba(244, 246, 245, .035); font: 500 12.5px/1.75 var(--f-mono); color: var(--text-3); overflow-wrap: anywhere; }
.fitem__proof b { color: var(--mint-300); font-weight: 500; }
.fitem__caveat { font-size: 14px; color: var(--text-3); padding-left: 12px; border-left: 2px solid rgba(255, 154, 134, .5); }
.fitem__more .link-arrow { justify-self: start; }
/* mini visual */
.viz { position: relative; min-width: 0; min-height: 168px; border-radius: var(--radius-md); background: linear-gradient(180deg, rgba(17, 22, 20, .9), rgba(10, 13, 12, .9)); box-shadow: inset 0 0 0 1px var(--line); padding: 30px 14px 16px; overflow: hidden; display: grid; align-content: center; }
.viz__label { position: absolute; left: 14px; top: 12px; font: 500 10.5px var(--f-mono); letter-spacing: .12em; text-transform: uppercase; color: var(--text-3); }
.chip { display: inline-flex; align-items: center; gap: 6px; padding: 7px 10px; border-radius: 8px; font: 500 12px/1.2 var(--f-mono); background: rgba(244, 246, 245, .06); color: var(--text-2); white-space: nowrap; }
.chip--ok { background: rgba(61, 246, 155, .12); color: var(--mint-400); }
.chip--no { background: rgba(255, 154, 134, .12); color: var(--coral); }
/* memory */
.v-mem { display: grid; grid-template-columns: auto minmax(14px, 1fr) auto minmax(14px, 1fr) auto; align-items: center; gap: 6px; margin-top: 10px; }
.v-mem .chip, .v-mesh .chip { font-size: 10.5px; padding: 6px 8px; }
.v-mem__track { position: relative; height: 1px; background: var(--line-strong); }
.v-mem__track i { position: absolute; top: -3px; left: 0; width: 7px; height: 7px; border-radius: 50%; background: var(--mint-400); box-shadow: 0 0 10px var(--mint-400); opacity: 0; }
.v-mem__vault { display: grid; justify-items: center; gap: 4px; font: 600 12px var(--f-mono); }
.v-mem__vault .egc-mark { width: 36px; height: 36px; }
.v-mem__lab { display: flex; justify-content: space-between; margin-top: 12px; font: 500 11px var(--f-mono); color: var(--text-3); }
.in-view .v-mem__track--a i { animation: travel 3.6s var(--ease-in-out) infinite; }
.in-view .v-mem__track--b i { animation: travel 3.6s var(--ease-in-out) 1.8s infinite; }
@keyframes travel { 0% { left: 0; opacity: 0; } 10% { opacity: 1; } 45% { left: calc(100% - 7px); opacity: 1; } 55%, 100% { left: calc(100% - 7px); opacity: 0; } }
/* mesh */
.v-mesh { position: relative; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; margin-top: 10px; }
.v-mesh::before { content: ''; position: absolute; left: 16%; right: 16%; top: 19px; height: 1px; background: var(--line-strong); }
.v-mesh__bus { position: absolute; left: 16%; right: 16%; top: 16px; height: 7px; pointer-events: none; }
.v-mesh__bus i { position: absolute; top: 0; width: 7px; height: 7px; border-radius: 50%; background: var(--mint-400); box-shadow: 0 0 10px var(--mint-400); opacity: 0; }
.in-view .v-mesh__bus i:nth-child(1) { animation: busR 3s var(--ease-in-out) infinite; }
.in-view .v-mesh__bus i:nth-child(2) { animation: busL 3s var(--ease-in-out) 1.5s infinite; }
@keyframes busR { 0% { left: 0; opacity: 0; } 15% { opacity: 1; } 85% { opacity: 1; } 100% { left: calc(100% - 7px); opacity: 0; } }
@keyframes busL { 0% { left: calc(100% - 7px); opacity: 0; } 15% { opacity: 1; } 85% { opacity: 1; } 100% { left: 0; opacity: 0; } }
.v-node { position: relative; display: grid; justify-items: center; gap: 8px; text-align: center; }
.v-node > b { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--ink-800); box-shadow: inset 0 0 0 1px var(--line-strong); font: 600 12px var(--f-mono); color: var(--text); }
.v-node > span { font-size: 12.5px; font-weight: 600; }
.v-node .chip { font-size: 10px; padding: 5px 6px; white-space: normal; text-align: center; justify-content: center; overflow-wrap: anywhere; max-width: 100%; }
.v-node > span { max-width: 100%; overflow-wrap: anywhere; }
/* guardian */
.v-guard { display: grid; gap: 8px; margin-top: 14px; }
.v-guard__row { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 8px 10px; border-radius: 8px; background: rgba(244, 246, 245, .035); font: 500 12px/1.3 var(--f-mono); color: var(--text-2); min-width: 0; }
.v-guard__row code { background: none; padding: 0; color: inherit; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
.v-guard__row .chip { flex: none; }
.in-view .v-guard__row .chip { animation: verdict 4s var(--ease-out) infinite; }
.in-view .v-guard__row:nth-child(2) .chip { animation-delay: .6s; }
.in-view .v-guard__row:nth-child(3) .chip { animation-delay: 1.2s; }
@keyframes verdict { 0%, 8% { opacity: 0; transform: translateX(8px); } 18%, 88% { opacity: 1; transform: none; } 100% { opacity: 0; } }
/* crusher */
.v-crush { display: grid; gap: 10px; margin-top: 14px; }
.v-crush__row { display: grid; grid-template-columns: 54px minmax(0, 1fr) 56px; align-items: center; gap: 10px; font: 500 11px var(--f-mono); color: var(--text-3); }
.v-crush__bar { height: 12px; border-radius: 4px; background: rgba(244, 246, 245, .28); transform-origin: left; }
.v-crush__row--after .v-crush__bar { width: 4.9%; background: var(--mint-400); }
.v-crush__row b { color: var(--text-2); font-weight: 500; text-align: right; }
.v-crush__row--after b { color: var(--mint-400); }
.v-crush__lines { display: grid; gap: 3px; padding: 8px; border-radius: 6px; background: rgba(244, 246, 245, .03); }
.v-crush__lines i { display: block; height: 3px; border-radius: 2px; background: rgba(244, 246, 245, .14); transform-origin: left; }
.v-crush__lines i.err { background: var(--coral); }
.in-view .v-crush__lines i:not(.err) { animation: squash 4s var(--ease-in-out) infinite; }
@keyframes squash { 0%, 25% { transform: scaleX(1); opacity: 1; } 60%, 85% { transform: scaleX(.06); opacity: .25; } 100% { transform: scaleX(1); opacity: 1; } }
.v-crush__keep { font: 500 11px var(--f-mono); color: var(--coral); }

@media (min-width: 768px) { .fitem { grid-template-columns: minmax(0, 1fr) minmax(0, 340px); column-gap: var(--s-6); align-items: start; } }
@media (min-width: 1024px) {
  .fx__layout { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); column-gap: var(--s-8); }
  .fx__visual { display: block; }
  .fx__sticky { position: sticky; top: calc(var(--hdr-h) + 40px); display: flex; flex-direction: column; gap: var(--s-5); }
  .fx__markwrap { position: relative; width: min(100%, 380px); aspect-ratio: 1; }
  .fx__markwrap .egc-mark { position: absolute; inset: 8%; width: 84%; height: 84%; filter: drop-shadow(0 30px 50px rgba(0, 0, 0, .5)); }
  .fx__markwrap .egc-mark__petal { transition: opacity var(--d-slow) var(--ease-out), transform var(--d-slow) var(--ease-out); transform-box: view-box; transform-origin: 240px 240px; }
  .fx__markwrap[data-active] .egc-mark__petal { opacity: .2; }
  .fx__markwrap[data-active='1'] .egc-mark__petal--1, .fx__markwrap[data-active='2'] .egc-mark__petal--2,
  .fx__markwrap[data-active='3'] .egc-mark__petal--3, .fx__markwrap[data-active='4'] .egc-mark__petal--4 { opacity: 1; }
  .fx__markwrap[data-active='1'] .egc-mark__petal--1 { transform: translate(0, -8px); }
  .fx__markwrap[data-active='2'] .egc-mark__petal--2 { transform: translate(8px, 0); }
  .fx__markwrap[data-active='3'] .egc-mark__petal--3 { transform: translate(0, 8px); }
  .fx__markwrap[data-active='4'] .egc-mark__petal--4 { transform: translate(-8px, 0); }
  .fx__ring { position: absolute; inset: 0; border-radius: 50%; box-shadow: inset 0 0 0 1px var(--line-strong); }
  .fx__ring--2 { inset: -8%; box-shadow: none; border: 1px dashed rgba(180, 248, 214, .14); }
  .fx__counter { display: flex; align-items: baseline; gap: var(--s-3); font: 500 13px var(--f-mono); color: var(--text-3); }
  .fx__counter b { font: 800 56px/1 var(--f-sans); letter-spacing: -.05em; color: var(--text); }
  .fx__counter-name { color: var(--mint-400); }
  .fitem__num .egc-mark { display: none; }
  .fx__list[data-active] .fitem { opacity: .55; }
  .fx__list[data-active] .fitem.is-active { opacity: 1; }
  .fx__list[data-active] .fitem:hover, .fx__list[data-active] .fitem:focus-within { opacity: 1; }
}
.fitem__num .egc-mark__petal { opacity: .22; }
.fitem[data-f='1'] .fitem__num .egc-mark__petal--1, .fitem[data-f='2'] .fitem__num .egc-mark__petal--2,
.fitem[data-f='3'] .fitem__num .egc-mark__petal--3, .fitem[data-f='4'] .fitem__num .egc-mark__petal--4 { opacity: 1; }

/* ---------- integrations ---------------------------------------------------- */
.int { background: var(--ink-900); border-top: 1px solid var(--line); }
.int__block + .int__block { margin-top: clamp(48px, 6vw, 88px); }
.int__bhead { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--s-3); margin-bottom: var(--s-5); }
.int__bhead h3 { font-size: clamp(22px, 2vw, 28px); font-weight: 800; letter-spacing: -.03em; }
.int__bhead h3 span + span { font: 500 14px var(--f-mono); color: var(--text-3); letter-spacing: 0; margin-left: 8px; }
.tgrid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
@media (min-width: 768px) { .tgrid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
.tgrid > li { border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
.tgrid > li[hidden] { display: none; }
.tile {
  position: relative; display: grid; grid-template-columns: 28px minmax(0, 1fr); align-items: center; column-gap: 12px; row-gap: 2px; width: 100%; height: 100%;
  min-height: 84px; padding: 16px; border: 0; background: transparent; text-align: left; cursor: pointer; transition: background-color var(--d-fast);
}
.tile img { grid-row: span 2; width: 22px; height: 22px; filter: invert(1); opacity: .7; transition: opacity var(--d-fast), transform var(--d-base) var(--ease-out); }
.tile b { font-size: 16px; font-weight: 700; letter-spacing: -.015em; line-height: 1.2; }
.tile small { font: 500 11.5px var(--f-mono); color: var(--text-3); }
.tile::after { content: ''; position: absolute; inset: 0; box-shadow: inset 0 0 0 1px transparent; transition: box-shadow var(--d-fast); pointer-events: none; }
.tile:hover { background: rgba(244, 246, 245, .035); }
.tile:hover img { opacity: 1; transform: scale(1.08); }
.tile[aria-pressed='true'] { background: rgba(61, 246, 155, .07); }
.tile[aria-pressed='true']::after { box-shadow: inset 0 0 0 1px rgba(61, 246, 155, .5); }
.tile[aria-pressed='true'] small { color: var(--mint-400); }
.tile:focus-visible { outline-offset: -3px; }
.tile--link { cursor: pointer; color: var(--mint-400); }
.tile--link b { color: var(--mint-400); }
.tgrid--prov .tile { cursor: default; min-height: 64px; }
.tgrid--prov .tile:hover { background: transparent; }
.int__more { margin-top: var(--s-4); display: flex; flex-wrap: wrap; gap: var(--s-3); align-items: center; }
.idetail {
  margin-top: var(--s-4); display: grid; gap: var(--s-4); padding: 20px; border-radius: var(--radius-md); background: rgba(244, 246, 245, .03); box-shadow: inset 0 0 0 1px var(--line);
}
.idetail__head { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 14px; }
.idetail__head img { width: 26px; height: 26px; filter: invert(1); }
.idetail__head h4 { margin: 0; font-size: 22px; font-weight: 800; letter-spacing: -.03em; }
.idetail__flag { padding: 5px 10px; border-radius: 999px; font: 500 11.5px var(--f-mono); background: rgba(61, 246, 155, .12); color: var(--mint-400); }
.idetail__flag[data-kind='community'] { background: rgba(244, 246, 245, .07); color: var(--text-2); }
.idetail__kinds { display: grid; gap: 8px; }
.idetail__kinds li { display: flex; gap: 10px; font-size: 15px; color: var(--text-2); }
.idetail__kinds li::before { content: ''; flex: none; width: 6px; height: 6px; margin-top: .6em; border-radius: 50%; background: var(--mint-400); }
.idetail__note { font-size: 14px; color: var(--text-3); }
.idetail.is-swap { animation: swapIn .45s var(--ease-out); }
@keyframes swapIn { from { opacity: .3; transform: translateY(6px); } to { opacity: 1; transform: none; } }
@media (min-width: 900px) { .idetail { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); align-items: start; column-gap: var(--s-7); } }

/* ---------- efficiency ------------------------------------------------------ */
.eff { background: radial-gradient(70% 60% at 85% 20%, rgba(14, 122, 72, .28), transparent 70%), var(--ink-950); border-top: 1px solid var(--line); }
.eff__grid { display: grid; gap: var(--s-7); }
.eff__hero { display: grid; gap: var(--s-4); align-content: start; }
.eff__bigrow { display: flex; align-items: flex-end; gap: var(--s-4); flex-wrap: wrap; margin-top: var(--s-4); }
.eff__big {
  font-weight: 800; line-height: .8; letter-spacing: -.07em; font-size: clamp(120px, 20vw, 300px);
  background: linear-gradient(180deg, var(--mint-200) 0%, var(--mint-400) 45%, var(--green-600) 100%); -webkit-background-clip: text; background-clip: text; color: transparent;
}
.eff__big span { font-size: .5em; letter-spacing: -.04em; }
.eff__est { display: inline-flex; align-items: center; gap: 8px; margin-bottom: .6em; padding: 6px 12px; border-radius: 999px; box-shadow: inset 0 0 0 1px var(--line-strong); font: 500 12px/1.2 var(--f-mono); color: var(--text-2); }
.eff__est::before { content: '≈'; color: var(--mint-400); }
.eff__cap { font-size: clamp(22px, 2.2vw, 30px); font-weight: 700; letter-spacing: -.03em; line-height: 1.15; max-width: 15em; }
.metric { padding: 20px 0 22px; border-top: 1px solid var(--line); }
.metric:last-child { border-bottom: 1px solid var(--line); }
.metric__label { margin-bottom: 12px; font-size: 16px; font-weight: 600; }
.metric__rows { display: grid; gap: 8px; }
.bar { display: grid; grid-template-columns: 96px minmax(0, 1fr) 18ch; align-items: center; gap: var(--s-3); font: 500 12px var(--f-mono); color: var(--text-3); }
.bar__track { position: relative; height: 12px; border-radius: 999px; background: rgba(244, 246, 245, .05); overflow: hidden; }
.bar__fill { position: absolute; inset: 0 auto 0 0; width: var(--w); border-radius: inherit; background: rgba(244, 246, 245, .3); transform-origin: left; }
.bar--with .bar__fill { background: linear-gradient(90deg, var(--green-600), var(--mint-400)); }
.bar__zero { position: absolute; left: 0; top: 1px; bottom: 1px; width: 2px; background: var(--mint-400); }
.bar__val { color: var(--text-2); text-align: right; }
.bar--with .bar__val { color: var(--mint-400); }
.eff__note { margin-top: var(--s-4); font-size: 14px; color: var(--text-3); max-width: 46em; }
@media (min-width: 1024px) { .eff__grid { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); column-gap: var(--s-9); align-items: center; } }
@media (max-width: 559px) { .bar { grid-template-columns: 78px minmax(0, 1fr); } .bar__val { grid-column: 2; text-align: left; } }

/* ---------- privacy (paper) ------------------------------------------------- */
.prv { background: var(--paper); color: var(--paper-ink); }
.prv .eyebrow { color: #56615C; }
.prv .eyebrow b { color: var(--green-700); }
.prv .h-section em { color: var(--green-700); }
.prv :focus-visible { outline-color: var(--green-700); }
.vault { display: grid; gap: var(--s-7); }
.vault__path { font-family: var(--f-mono); font-weight: 500; letter-spacing: -.06em; line-height: .9; font-size: clamp(72px, 12vw, 190px); margin-top: var(--s-4); }
.vault__path span { color: var(--green-700); }
.specs li { display: grid; gap: 4px; padding: 18px 0; border-top: 1px solid rgba(13, 16, 15, .12); }
.specs li:last-child { border-bottom: 1px solid rgba(13, 16, 15, .12); }
.specs .k { font: 500 12px var(--f-mono); color: #5E6964; letter-spacing: .06em; text-transform: uppercase; }
.specs .v { font-size: 18px; font-weight: 600; letter-spacing: -.015em; }
.specs .v small { display: block; margin-top: 2px; font-size: 15px; font-weight: 400; color: #4D5853; letter-spacing: 0; }
.proofs { margin-top: var(--s-5); display: flex; flex-wrap: wrap; gap: 8px; }
.proofs a { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 16px; border-radius: 999px; box-shadow: inset 0 0 0 1px rgba(13, 16, 15, .2); font-size: 14px; font-weight: 600; transition: background-color var(--d-fast), box-shadow var(--d-fast); }
.proofs a::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: var(--green-600); }
.proofs a:hover { background: #fff; box-shadow: inset 0 0 0 1px rgba(13, 16, 15, .45); }
@media (min-width: 768px) { .specs li { grid-template-columns: 170px minmax(0, 1fr); gap: var(--s-5); align-items: baseline; } }
@media (min-width: 1024px) { .vault { grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); column-gap: var(--s-8); align-items: start; } }

/* ---------- install --------------------------------------------------------- */
.ins { background: linear-gradient(180deg, var(--ink-950), var(--green-950) 120%); overflow: hidden; }
.ins::before { content: ''; position: absolute; z-index: -1; left: 50%; bottom: -40%; width: 120vw; aspect-ratio: 2; translate: -50% 0; background: radial-gradient(closest-side, rgba(18, 163, 95, .4), transparent); pointer-events: none; }
.ins__grid { display: grid; gap: var(--s-7); }
.steps { margin-top: var(--s-7); counter-reset: st; display: grid; gap: var(--s-5); }
.steps li { display: grid; grid-template-columns: 44px minmax(0, 1fr); gap: var(--s-4); }
.steps li::before { counter-increment: st; content: counter(st, decimal-leading-zero); display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; box-shadow: inset 0 0 0 1px var(--line-strong); font: 500 13px var(--f-mono); color: var(--mint-400); }
.steps h3 { margin: 8px 0 4px; font-size: 19px; font-weight: 700; letter-spacing: -.02em; }
.steps p { color: var(--text-2); font-size: 16px; }
.term { border-radius: var(--radius-lg); overflow: hidden; background: rgba(13, 16, 15, .9); box-shadow: inset 0 0 0 1px var(--line-strong), 0 50px 100px -40px rgba(0, 0, 0, .9); }
.term__tabs { display: flex; gap: 4px; padding: 10px; border-bottom: 1px solid var(--line); overflow-x: auto; scrollbar-width: none; }
.term__tabs::-webkit-scrollbar { display: none; }
.term__tab { flex: none; min-height: 40px; padding: 0 14px; border: 0; border-radius: 999px; background: transparent; color: var(--text-3); font: 500 13px var(--f-mono); cursor: pointer; transition: background-color var(--d-fast), color var(--d-fast); }
.term__tab:hover { color: var(--text); background: rgba(244, 246, 245, .05); }
.term__tab[aria-selected='true'] { background: rgba(61, 246, 155, .12); color: var(--mint-400); }
.term__tab small { margin-left: 6px; font-size: 10px; opacity: .75; }
.term__panel { padding: 22px 22px 18px; }
.term__panel.is-in { animation: swapIn .4s var(--ease-out); }
.term__note { margin-bottom: 14px; font-size: 14px; color: var(--text-3); }
.term__note a { color: var(--mint-400); text-decoration: underline; text-underline-offset: 3px; }
.term pre { margin: 0; white-space: pre-wrap; overflow-wrap: anywhere; font: 500 14px/1.9 var(--f-mono); color: var(--text); }
.term pre .p { color: var(--mint-400); user-select: none; }
.term pre .c { color: var(--text-3); }
.term pre .ok { color: var(--mint-400); }
.term__bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 14px 12px 22px; border-top: 1px solid var(--line); }
.term__status { flex: 1 1 100%; order: 3; min-height: 1.4em; font: 500 12px var(--f-mono); color: var(--mint-400); }
@media (min-width: 640px) { .term__status { flex: 1; order: 0; } }
@media (min-width: 1024px) { .ins__grid { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); column-gap: var(--s-9); align-items: center; } }

/* ---------- faq ------------------------------------------------------------- */
.faq { background: var(--ink-950); border-top: 1px solid var(--line); }
.faq__grid { display: grid; gap: var(--s-7); }
.faq details { border-top: 1px solid var(--line); }
.faq details:last-child { border-bottom: 1px solid var(--line); }
.faq summary { display: flex; align-items: center; justify-content: space-between; gap: var(--s-5); min-height: 72px; padding: 16px 0; cursor: pointer; list-style: none; font-size: clamp(17px, 1.5vw, 21px); font-weight: 600; letter-spacing: -.02em; transition: color var(--d-fast); }
.faq summary::-webkit-details-marker { display: none; }
.faq summary:hover { color: var(--mint-300); }
.faq summary i { position: relative; flex: none; width: 36px; height: 36px; border-radius: 50%; box-shadow: inset 0 0 0 1px var(--line-strong); transition: background-color var(--d-base) var(--ease-out); }
.faq summary i::before, .faq summary i::after { content: ''; position: absolute; left: 50%; top: 50%; width: 12px; height: 1.5px; background: currentColor; translate: -50% -50%; }
.faq summary i::after { rotate: 90deg; transition: rotate var(--d-base) var(--ease-out); }
.faq details[open] summary i { background: var(--mint-400); color: var(--ink-950); box-shadow: none; }
.faq details[open] summary i::after { rotate: 0deg; }
.faq .ans { overflow: hidden; }
.faq .ans p { padding: 0 56px 24px 0; color: var(--text-2); max-width: 46em; }
@media (min-width: 1024px) { .faq__grid { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); column-gap: var(--s-9); } .faq__aside { position: sticky; top: calc(var(--hdr-h) + 40px); align-self: start; } }
@media (max-width: 559px) { .faq .ans p { padding-right: 0; } }

/* ---------- closing --------------------------------------------------------- */
.closing { position: relative; overflow: hidden; padding-block: clamp(104px, 13vw, 200px); background: radial-gradient(60% 80% at 72% 50%, rgba(18, 163, 95, .48), rgba(10, 13, 12, 0) 70%), var(--green-950); }
.closing__mark { position: absolute; z-index: 0; width: min(46vw, 660px); right: -12vw; top: 50%; translate: 0 -50%; }
.closing__mark .egc-mark { width: 100%; height: auto; }
.closing h2 { position: relative; z-index: 1; font-weight: 800; letter-spacing: -.055em; line-height: .9; font-size: clamp(52px, 8.4vw, 144px); }
.closing h2 span, .closing h2 em { display: block; }
.closing h2 em { font-style: normal; color: var(--mint-400); }
.closing__row { position: relative; z-index: 1; margin-top: var(--s-7); display: flex; flex-wrap: wrap; gap: var(--s-3); align-items: center; }
.closing__en { position: relative; z-index: 1; margin-top: var(--s-6); font: 500 13px var(--f-mono); color: var(--text-3); }
@media (max-width: 767px) {
  .closing__mark { width: 80vw; right: -36vw; top: 8%; translate: 0 0; opacity: .3; }
  .closing__row { flex-direction: column; align-items: stretch; }
  .closing__row .cmd { width: 100%; }
}

/* ---------- footer + community --------------------------------------------- */
.ftr { background: var(--ink-950); border-top: 1px solid var(--line); padding: var(--s-7) 0 calc(var(--s-6) + env(safe-area-inset-bottom, 0px)); font-size: 15px; }
.comm { display: grid; gap: var(--s-5); padding-bottom: var(--s-7); margin-bottom: var(--s-7); border-bottom: 1px solid var(--line); }
.comm__title { font-size: clamp(22px, 2.2vw, 30px); font-weight: 800; letter-spacing: -.03em; line-height: 1.1; max-width: 16em; }
.channels { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0; border-top: 1px solid var(--line); }
.channels a { display: flex; align-items: center; justify-content: space-between; gap: 10px; min-height: 64px; padding: 12px 4px; border-bottom: 1px solid var(--line); transition: color var(--d-fast), padding-left var(--d-base) var(--ease-out); }
.channels b { display: block; font-size: 17px; font-weight: 700; }
.channels small { display: block; font-size: 13px; color: var(--text-3); }
.channels svg { flex: none; color: var(--text-3); transition: transform var(--d-base) var(--ease-out), color var(--d-fast); }
.channels a:hover { color: var(--mint-400); padding-left: 8px; }
.channels a:hover svg { transform: rotate(-45deg); color: var(--mint-400); }
.support { display: grid; gap: var(--s-4); padding: 22px; border-radius: var(--radius-md); background: linear-gradient(150deg, #0F7A45 0%, #0A4F2F 70%, #083A24 100%); }
.support p { color: rgba(244, 246, 245, .88); font-size: 15px; }
.support__btns { display: flex; flex-wrap: wrap; gap: 8px; }
.support .btn { --bg: var(--paper); min-height: 44px; font-size: 14px; padding: 4px 4px 4px 18px; }
.support .btn .btn__icon { width: 36px; height: 36px; }
.support .btn:hover { background: #fff; }
.support .btn--ghost { --bg: transparent; --fg: #fff; padding: 4px 18px; box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .35); }
.support .btn--ghost:hover { background: rgba(255, 255, 255, .1); }
.backers { display: flex; flex-wrap: wrap; gap: 8px 20px; font-size: 13px; color: rgba(244, 246, 245, .8); }
.backers > div { display: grid; gap: 2px; }
.backers b { font: 500 10.5px var(--f-mono); letter-spacing: .1em; text-transform: uppercase; color: rgba(244, 246, 245, .6); }
.backers a { display: inline-flex; align-items: center; gap: 8px; min-height: 40px; font-weight: 600; color: #fff; }
.backers img { width: 28px; height: 28px; border-radius: 50%; background: #fff; object-fit: cover; }
@media (min-width: 1024px) { .comm { grid-template-columns: minmax(0, 3fr) minmax(0, 5fr) minmax(0, 4fr); column-gap: var(--s-7); align-items: start; } }
@media (max-width: 479px) { .channels { grid-template-columns: 1fr; } }
.ftr__grid { display: grid; gap: var(--s-6); grid-template-columns: 1fr 1fr; }
.ftr__brand { grid-column: 1 / -1; }
.ftr__brand p { margin-top: var(--s-3); color: var(--text-3); max-width: 22em; font-size: 14px; }
.ftr h2 { margin-bottom: var(--s-3); font: 500 12px var(--f-mono); letter-spacing: .12em; text-transform: uppercase; color: var(--text-3); }
.ftr li a { display: inline-flex; align-items: center; min-height: 40px; color: var(--text-2); transition: color var(--d-fast); }
.ftr li a:hover { color: var(--mint-400); }
.ftr__bottom { margin-top: var(--s-7); padding-top: var(--s-5); border-top: 1px solid var(--line); display: flex; flex-wrap: wrap; gap: 8px 24px; justify-content: space-between; align-items: center; font-size: 13px; color: var(--text-3); }
.ftr__bottom a { text-decoration: underline; text-decoration-color: var(--line-strong); text-underline-offset: 3px; }
.ftr__bottom a:hover { color: var(--text); }
@media (min-width: 900px) { .ftr__grid { grid-template-columns: 2fr 1fr 1fr 1fr; } .ftr__brand { grid-column: auto; } }

/* ==========================================================================
   Motion (opt-in via html.js, only without reduced motion)
   ========================================================================== */
@keyframes rise { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: none; } }
@keyframes revealUp { from { clip-path: inset(0 0 100% 0); transform: translateY(16%); } to { clip-path: inset(-20% -5% -20% -5%); transform: none; } }
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
@keyframes petalIn { from { opacity: 0; transform: scale(.3) rotate(-35deg); } to { opacity: 1; transform: none; } }
@keyframes coreIn { 0% { opacity: 0; transform: scale(0); } 70% { transform: scale(1.25); } 100% { opacity: 1; transform: none; } }
@keyframes drawRing { from { stroke-dashoffset: var(--len); } to { stroke-dashoffset: 0; } }
@keyframes spin { to { transform: rotate(360deg); } }

@media (prefers-reduced-motion: no-preference) {
  html.js .i-eyebrow { animation: rise .8s var(--ease-out) .05s both; }
  html.js .i-l1 { animation: revealUp 1.1s var(--ease-out) .15s both; }
  html.js .i-l2 { animation: revealUp 1s var(--ease-out) .5s both; }
  html.js .i-ui > * { animation: rise .9s var(--ease-out) both; }
  html.js .i-ui > :nth-child(1) { animation-delay: .9s; }
  html.js .i-ui > :nth-child(2) { animation-delay: 1.02s; }
  html.js .i-ui > :nth-child(3) { animation-delay: 1.14s; }
  html.js .hero__glow { animation: fadeIn 1.6s var(--ease-out) both; }
  html.js .hero__cap { animation: fadeIn 1s var(--ease-out) 1.5s both; }
  html.js .hero__mark .egc-mark__petal { transform-box: view-box; transform-origin: 240px 240px; animation: petalIn 1.2s var(--ease-out) both; }
  html.js .hero__mark .egc-mark__petal--1 { animation-delay: .35s; }
  html.js .hero__mark .egc-mark__petal--2 { animation-delay: .43s; }
  html.js .hero__mark .egc-mark__petal--3 { animation-delay: .51s; }
  html.js .hero__mark .egc-mark__petal--4 { animation-delay: .59s; }
  html.js .hero__mark .egc-mark__core { transform-box: view-box; transform-origin: 240px 240px; animation: coreIn .7s var(--ease-out) 1.05s both; }
  html.js .hero__mark .egc-mark__body { transform-box: view-box; transform-origin: 240px 240px; animation: spin 120s linear 1.8s infinite; }
  html.js .hero__orbits circle { stroke-dasharray: var(--len) var(--len); animation: drawRing 1.8s var(--ease-in-out) .7s both; }
  html.js .hero__orbits .o-dash { stroke-dasharray: 2 9; animation: fadeIn 1.4s ease 1.1s both; }
  html.js .hero__orbits .o-spin { transform-box: view-box; transform-origin: 50% 50%; animation: spin 160s linear infinite reverse; }

  /* reveals: visible by default; JS marks only below-the-fold elements as pending */
  html.js .rv { transition: opacity .9s var(--ease-out), transform .9s var(--ease-out); transition-delay: var(--rd, 0s); }
  html.js .rv.is-pending { opacity: 0; transform: translateY(28px); }
  html.js .h-section.rv { transition: opacity 1s var(--ease-out), transform 1.1s var(--ease-out), letter-spacing 1.2s var(--ease-out); }
  html.js .h-section.rv.is-pending { opacity: 0; transform: translateY(.4em); letter-spacing: -.02em; }
  html.js .bar__fill { transition: transform 1.3s var(--ease-out); transition-delay: var(--rd, 0s); }
  html.js .metric.is-pending .bar__fill { transform: scaleX(0); }
  html.js .metric .bar--with .bar__fill { transition-delay: calc(var(--rd, 0s) + .25s); }
}
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation-duration: 1ms !important; animation-iteration-count: 1 !important; transition-duration: 1ms !important; scroll-behavior: auto !important; }
  html { scroll-behavior: auto; }
  .hero__stage-inner, .hero__orbits, .hero__l1, .hero__glow { translate: none !important; }
  .v-mem__track i, .v-mesh__bus i { display: none; }
}

