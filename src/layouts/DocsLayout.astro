---
import Base from './Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  current?: string;
  toc?: { id: string; label: string }[];
}

import { getBase } from '../utils/base.ts';
const { title, description, current, toc } = Astro.props;
const base = getBase();

const sections = [
  {
    label: 'Getting Started',
    links: [
      { href: `${base}get-started`, label: 'Installation', id: 'get-started' },
      { href: `${base}features`, label: 'Features', id: 'features' },
    ],
  },
  {
    label: 'MCP Servers',
    links: [
      { href: `${base}docs/memory`, label: 'egc-memory', id: 'memory' },
      { href: `${base}docs/guardian`, label: 'egc-guardian', id: 'guardian' },
      { href: `${base}docs/mcp`, label: 'Overview', id: 'mcp' },
    ],
  },
  {
    label: 'Integrations',
    links: [
      { href: `${base}integrations`, label: 'All 21 tools', id: 'integrations' },
    ],
  },
  {
    label: 'Reference',
    links: [
      { href: `${base}docs/architecture`, label: 'Architecture', id: 'architecture' },
      { href: `${base}docs/security`, label: 'Security', id: 'security' },
      { href: `${base}docs/cli`, label: 'CLI Reference', id: 'cli' },
      { href: `${base}docs/faq`, label: 'FAQ', id: 'faq' },
      { href: 'https://github.com/Fmarzochi/EGC/blob/main/docs/VISION.md', label: 'Vision', id: 'vision', external: true },
    ],
  },
  {
    label: 'Community',
    links: [
      { href: 'https://discord.gg/FmXbgUmdmM', label: 'Discord', id: 'discord', external: true },
      { href: 'https://github.com/Fmarzochi/EGC/blob/main/.github/CONTRIBUTING.md', label: 'Contributing', id: 'contributing', external: true },
      { href: 'https://github.com/Fmarzochi/EGC/releases', label: 'Releases', id: 'releases', external: true },
    ],
  },
  {
    label: 'Legal',
    links: [
      { href: `${base}privacy`, label: 'Privacy Policy', id: 'privacy', external: false },
    ],
  },
];
const docOrder = [
  { id: 'get-started', label: 'Installation', href: 'get-started' },
  { id: 'features', label: 'Features', href: 'features' },
  { id: 'memory', label: 'egc-memory', href: 'docs/memory' },
  { id: 'guardian', label: 'egc-guardian', href: 'docs/guardian' },
  { id: 'mcp', label: 'MCP Servers', href: 'docs/mcp' },
  { id: 'integrations', label: 'Integrations', href: 'integrations' },
  { id: 'architecture', label: 'Architecture', href: 'docs/architecture' },
  { id: 'security', label: 'Security', href: 'docs/security' },
  { id: 'cli', label: 'CLI Reference', href: 'docs/cli' },
  { id: 'faq', label: 'FAQ', href: 'docs/faq' },
];
const currentIndex = docOrder.findIndex(page => page.id === current);
const previous = currentIndex > 0 ? docOrder[currentIndex - 1] : null;
const next = currentIndex >= 0 ? docOrder[currentIndex + 1] : null;
---

<Base title={`${title} - EGC Docs`} description={description}>
  <div class="bg-[#0A0D0C] text-[#F4F6F5] min-h-screen">
    <Navbar />

    <!-- Mobile Sidebar Backdrop -->
    <div
      id="docs-sidebar-backdrop"
      class="md:hidden fixed inset-0 z-40 bg-black/70 backdrop-blur-sm opacity-0 pointer-events-none invisible transition-all duration-300"
      aria-hidden="true"
    ></div>

    <div class="docs-shell mx-auto px-4 sm:px-6 lg:px-8">
      <div class="docs-mobile-bar md:hidden">
        <button
          id="docs-sidebar-toggle"
          type="button"
          aria-label="Open docs menu"
          aria-expanded="false"
          aria-controls="docs-sidebar"
          class="docs-mobile-toggle"
        >
          <svg id="docs-sidebar-icon-open" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" /></svg>
          <svg id="docs-sidebar-icon-close" class="w-4 h-4 hidden" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
          <span>Topics</span>
        </button>
        <nav class="docs-mobile-links" aria-label="Documentation quick navigation">
          {docOrder.map(page => <a href={`${base}${page.href}`} aria-current={current === page.id ? 'page' : undefined}>{page.label}</a>)}
        </nav>
      </div>
      <div class="docs-grid py-6 md:py-10 min-h-[calc(100vh-4rem)]">

        <!-- Sidebar -->
        <aside
          id="docs-sidebar"
          tabindex="-1"
          class="fixed md:relative inset-y-0 left-0 z-40 w-72 md:w-full shrink-0 bg-[#0D100F] md:bg-transparent border-r border-[rgba(226,240,233,0.09)] transform -translate-x-full md:translate-x-0 invisible md:visible pointer-events-none md:pointer-events-auto transition-transform duration-300 ease-in-out overflow-y-auto md:overflow-visible"
        >
          <div class="sticky top-0 md:top-24 pt-16 md:pt-0 pb-8 px-5 md:px-0 md:pr-4">
            <!-- Mobile sidebar header -->
            <div class="md:hidden flex items-center justify-between mb-6 pb-3 border-b border-[rgba(226,240,233,0.09)]">
              <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-[#3DF69B]"></span>
                <span class="text-sm font-bold text-[#F4F6F5]">Documentation</span>
              </div>
              <button
                id="docs-sidebar-close"
                type="button"
                aria-label="Close docs menu"
                class="p-2 min-w-[40px] min-h-[40px] flex items-center justify-center rounded-lg text-[#8E9E96] hover:text-[#F4F6F5] hover:bg-white/[0.05] active:scale-95 transition-all"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </button>
            </div>

            {sections.map(section => (
              <div class="mb-6">
                <p class="mb-2 px-3 font-mono text-[11px] font-semibold uppercase tracking-[0.14em] text-[#8E9E96]">{section.label}</p>
                <ul class="space-y-1">
                  {section.links.map(link => (
                    <li>
                      <a
                        href={link.href}
                        target={link.external ? '_blank' : undefined}
                        rel={link.external ? 'noopener noreferrer' : undefined}
                        aria-label={link.external ? `${link.label} (opens in new tab)` : undefined}
                        aria-current={current === link.id ? 'page' : undefined}
                        class={`flex items-center justify-between px-3 py-2 min-h-[40px] rounded-lg text-sm transition-colors duration-150 ${
                          current === link.id
                            ? 'text-[#3DF69B] bg-[#18B669]/10 border border-transparent font-semibold'
                            : 'text-[#8E9E96] border border-transparent hover:text-[#F4F6F5] hover:bg-white/[0.04]'
                        }`}
                      >
                        <span>{link.label}</span>
                        {link.external && (
                          <svg class="w-3.5 h-3.5 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                          </svg>
                        )}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </aside>

        <!-- Main Content -->
        <main id="main-content" class="min-w-0 w-full docs-content py-2">
          <slot />
          {(previous || next) && <nav class="docs-pagination" aria-label="Documentation pages">
            {previous && <a href={`${base}${previous.href}`} rel="prev"><span>← Previous</span><strong>{previous.label}</strong></a>}
            {next && <a href={`${base}${next.href}`} rel="next"><span>Next →</span><strong>{next.label}</strong></a>}
          </nav>}
        </main>

        <!-- On This Page (Table of Contents) -->
          <aside class="docs-toc hidden xl:block pl-5 border-l border-[rgba(226,240,233,0.08)]">
            <div class="sticky top-24 pt-2">
              <h4 class="font-mono text-[11px] font-semibold uppercase tracking-[0.18em] text-[#8E9E96] mb-3">On this page</h4>
              <nav class="space-y-1" aria-label="On this page" data-generated={toc?.length ? undefined : 'true'}>
                {toc?.map(item => (
                  <a
                    href={`#${item.id}`}
                    class="block py-2 pl-3 border-l border-[rgba(226,240,233,0.12)] text-sm text-[#AABBB0] hover:text-[#3DF69B] hover:border-[#3DF69B] transition-colors"
                  >
                    {item.label}
                  </a>
                ))}
              </nav>
              {current === 'memory' && <div class="mt-8 p-3.5 rounded-xl bg-[#102018] border border-[#23402d]">
                <span class="font-mono text-[10px] font-bold uppercase tracking-[0.15em] text-[#3DF69B]">QUICK TIP</span>
                <p class="text-xs text-[#aac7b5] mt-1.5 leading-relaxed">
                  State is encrypted per project branch at <code>~/.egc</code>.
                </p>
              </div>}
            </div>
          </aside>

      </div>
    </div>

    <Footer />
  </div>
</Base>

<style is:global>
  .docs-shell { max-width: 1480px; font-family: Inter, ui-sans-serif, system-ui, sans-serif; }
  .docs-grid { display: grid; grid-template-columns: 208px minmax(0, 1fr); gap: clamp(24px, 3vw, 48px); }
  @media (min-width: 1280px) { .docs-grid { grid-template-columns: 208px minmax(0, 1fr) 176px; } }
  @media (max-width: 767px) { .docs-grid { display: block; } }
  .docs-shell a[aria-current="page"] { background: #103322; color: #3df69b; border-color: transparent; box-shadow: inset 2px 0 #3df69b; border-radius: 8px; }
  .docs-mobile-bar { display: flex; align-items: center; gap: 8px; padding-top: 18px; min-width: 0; }
  .docs-mobile-toggle { display: inline-flex; align-items: center; justify-content: center; gap: 6px; flex: none; min-height: 40px; padding: 0 12px; border: 1px solid #31523e; border-radius: 8px; background: #123527; color: #3df69b; font: 600 12px Inter, sans-serif; cursor: pointer; }
  .docs-mobile-links { display: flex; gap: 5px; min-width: 0; overflow-x: auto; scrollbar-width: thin; }
  .docs-mobile-links a { flex: none; display: inline-flex; align-items: center; min-height: 40px; padding: 0 12px; border-radius: 8px; color: #92a49a; font-size: 12px; white-space: nowrap; }
  .docs-mobile-links a:hover { background: #17241c; color: #e4f4e8; }
  @media (min-width: 768px) { .docs-mobile-bar { display: none; } }
  .docs-content h1, .docs-content h2, .docs-content h3 { font-family: Inter, ui-sans-serif, system-ui, sans-serif !important; }
  .docs-content { max-width: 76ch; margin-inline: auto; font-size: 1rem; line-height: 1.7; }
  .docs-content > :first-child { margin-top: 0; }
  .docs-content > section { margin-bottom: 3.75rem; scroll-margin-top: 6rem; }
  .docs-content > section:last-of-type { margin-bottom: 0; }
  .docs-content > section + section { padding-top: 1rem; }
  .docs-content > section h2 { font-size: clamp(1.35rem, 2vw, 1.65rem) !important; line-height: 1.3; margin-bottom: 1rem; }
  .docs-content > section h3 { font-size: 1.1rem; line-height: 1.4; }
  .docs-content p { line-height: 1.7; }
  .docs-content code { overflow-wrap: anywhere; }
  .docs-content pre code { overflow-wrap: normal; }
  .docs-content .hero { padding: 9px 0 30px; margin-bottom: 0; border-bottom: 1px solid #25312b; }
  .docs-content .hero h1 { font-size: clamp(32px, 3.5vw, 46px) !important; letter-spacing: -.045em !important; line-height: 1.15 !important; }
  .docs-content .hero .lead { color: #a8b9ad; max-width: 720px; }
  .docs-content .section { padding-top: 28px; scroll-margin-top: 100px; }
  .docs-content .section h2 { font-size: 22px !important; letter-spacing: -.035em !important; }
  .docs-content .feature, .docs-content .tool, .docs-content .snippet { border-color: #25312b; }
  .docs-content .tool[open] { border-color: #3a8058; }
  .docs-toc a { border-left-color: #253a2d; }
  .docs-pagination { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; margin-top: 40px; padding-top: 24px; border-top: 1px solid #25312b; }
  .docs-pagination a { display: flex; flex-direction: column; gap: 5px; min-height: 72px; padding: 12px 0; text-decoration: none !important; }
  .docs-pagination a[rel="next"] { grid-column: 2; text-align: right; }
  .docs-pagination a:hover strong { color: #3df69b; }
  .docs-pagination span { color: #92a49a; font: 11px 'JetBrains Mono', monospace; text-transform: uppercase; letter-spacing: .08em; }
  .docs-pagination strong { color: #edf5ef; font-size: 14px; }
  .docs-code-wrapper { position: relative; min-width: 0; margin: 1.25rem 0; }
  .docs-code-wrapper pre { margin: 0 !important; padding-top: 3.1rem !important; }
  .docs-copy-code { position: absolute; top: 10px; right: 12px; z-index: 1; background: #19281e; color: #3df69b; border: 1px solid #31523e; border-radius: 7px; min-height: 32px; padding: 4px 10px; font: 12px 'JetBrains Mono', monospace; cursor: pointer; }
  .docs-copy-code:hover { border-color: #3df69b; }
  @media (max-width: 1020px) { .docs-grid { gap: 24px; } }
  @media (max-width: 767px) { .docs-pagination { margin-top: 32px; } .docs-content { max-width: 100%; } }
  /* Docs content: ensure code blocks, tables and cards match brand identity */
  .docs-content pre {
    background-color: #070A09 !important;
    border: 1px solid rgba(226, 240, 233, 0.09) !important;
    border-radius: 14px !important;
    padding: 1.25rem 1.5rem !important;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    max-width: 100%;
    color: #E2E8E4 !important;
    font-family: 'JetBrains Mono', monospace !important;
    font-size: 0.875rem !important;
    margin: 1.25rem 0 !important;
  }

  .docs-content table {
    width: 100%;
    max-width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    border: 1px solid rgba(226, 240, 233, 0.09);
    border-radius: 12px;
    overflow: hidden;
  }

  .docs-content th {
    background-color: #0D100F;
    border-bottom: 1px solid rgba(226, 240, 233, 0.12);
    color: #F4F6F5;
    font-weight: 600;
    padding: 0.75rem 1rem;
  }

  .docs-content td {
    border-bottom: 1px solid rgba(226, 240, 233, 0.06);
    color: #B9C8BE;
    padding: 0.75rem 1rem;
  }

  .docs-content img {
    max-width: 100%;
    height: auto;
    border-radius: 12px;
  }

  .docs-content h1 {
    color: #F4F6F5 !important;
    font-weight: 800 !important;
    letter-spacing: -0.03em !important;
    font-family: 'Plus Jakarta Sans', sans-serif !important;
  }

  .docs-content h2,
  .docs-content h3 {
    color: #F4F6F5 !important;
    font-weight: 700 !important;
    letter-spacing: -0.02em !important;
    font-family: 'Plus Jakarta Sans', sans-serif !important;
  }

  .docs-content a:not([class*="btn"]):not([class*="button"]):not([class*="tile"]) {
    color: #3DF69B;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.15s ease;
  }

  .docs-content a:not([class*="btn"]):not([class*="button"]):not([class*="tile"]):hover {
    color: #72F7B6;
  }

  .docs-content :is(a, button, summary):focus-visible,
  .docs-toc a:focus-visible,
  #docs-sidebar a:focus-visible,
  .docs-content .table-scroll:focus-visible { outline: 2px solid #3df69b; outline-offset: 3px; }
  .docs-content .table-scroll { overflow-x: auto; max-width: 100%; }
  .docs-content .table-scroll table { margin: 0; }
  .docs-content .editorial-list { border-top: 1px solid #25312b; }
  .docs-content .editorial-list > * { border-bottom: 1px solid #25312b; padding: 1rem 0; }
  .docs-content .editorial-list p { margin-top: .35rem; color: #b9c8be; }
  .docs-content .install-step { position: relative; }
  .docs-content .install-step::before { content: attr(data-step); color: #3df69b; font: 600 .78rem 'JetBrains Mono', monospace; display: block; margin-bottom: .6rem; letter-spacing: .08em; }
  /* Flex + container queries reproduce the old auto-fit(205px) columns but center an incomplete last row. */
  .docs-content .integrations-list { container-type: inline-size; display: flex; flex-wrap: wrap; justify-content: center; column-gap: 22px; border-top: 1px solid #25312b; }
  .docs-content .integrations-list a { flex: 0 0 100%; min-width: 0; border-bottom: 1px solid #25312b; min-height: 64px; }
  @container (min-width: 432px) { .docs-content .integrations-list a { flex-basis: calc((100% - 22px) / 2); } }
  @container (min-width: 659px) { .docs-content .integrations-list a { flex-basis: calc((100% - 44px) / 3); } }
  @container (min-width: 886px) { .docs-content .integrations-list a { flex-basis: calc((100% - 66px) / 4); } }
  .docs-content .integrations-list a:hover { background: #101a14; }
  .docs-content .method-jump { display: flex; flex-wrap: wrap; gap: .45rem 1rem; padding: .7rem 0 1.3rem; border-top: 1px solid #25312b; border-bottom: 1px solid #25312b; }
  .docs-content .method-jump a { font-size: .875rem; }
  .docs-content .method-group-heading { margin: 2.1rem 0 .65rem; padding-bottom: .55rem; border-bottom: 1px solid #25312b; font-size: 1rem !important; scroll-margin-top: 6rem; }
  .docs-content .method-group-heading:first-child { margin-top: .5rem; }
  .docs-content .architecture-figure { margin: 1.5rem 0 0; }
  .docs-content .architecture-scroll { overflow-x: auto; padding: 1rem; background: #0d1611; border: 1px solid #294331; border-radius: 12px; }
  .docs-content .architecture-scroll:focus-visible { outline: 2px solid #3df69b; outline-offset: 3px; }
  .docs-content .architecture-figure img { display: block; width: 100%; height: auto; max-height: 560px; object-fit: contain; }
  .docs-content .architecture-figure figcaption { margin-top: .8rem; font-size: .875rem; color: #b9c8be; }
  .docs-content .architecture-scroll-hint { display: none; }
  @media (max-width: 639px) { .docs-content .architecture-scroll-hint { display: block; margin-bottom: .5rem; color: #b9c8be; font-size: .875rem; } .docs-content .architecture-figure img { width: 560px; max-width: none; } }

  /* Responsive headings */
  @media (max-width: 767px) {
    .docs-content h1 {
      font-size: 1.75rem;
      line-height: 2.2rem;
    }
    .docs-content h2 {
      font-size: 1.35rem;
      line-height: 1.8rem;
    }
  }
  @media (prefers-reduced-motion: reduce) { .docs-shell *, .docs-shell *::before, .docs-shell *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; animation-duration: .01ms !important; } }

  /* Lock body scroll when sidebar is open on mobile */
  body.docs-sidebar-open {
    overflow: hidden;
  }

  /* Visual Lab Components */
  .eyebrow {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 700;
    font-size: 11px;
    line-height: 1.6;
    color: #3DF69B;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 14px;
  }

  .pill {
    border: 1px solid #264d38;
    background: #10251b;
    color: #8fe8b4;
    font-size: 11px;
    padding: 3px 10px;
    border-radius: 30px;
    font-family: 'JetBrains Mono', monospace;
  }

  /* Same columns as the old auto-fit(200px) grid, with an incomplete last row centered. */
  .featuregrid {
    container-type: inline-size;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin: 18px 0;
  }
  .featuregrid > * { flex: 0 0 100%; min-width: 0; }
  @container (min-width: 412px) { .featuregrid > * { flex-basis: calc((100% - 12px) / 2); } }
  @container (min-width: 624px) { .featuregrid > * { flex-basis: calc((100% - 24px) / 3); } }
  @container (min-width: 836px) { .featuregrid > * { flex-basis: calc((100% - 36px) / 4); } }

  .feature {
    padding: 20px;
    background: #111915;
    border: 1px solid rgba(226, 240, 233, 0.09);
    border-radius: 14px;
    transition: border-color .22s ease, background .22s ease;
  }

  .feature:hover {
    border-color: #3a8058;
    background: #132219;
  }

  .feature .ico {
    font-size: 20px;
    margin-bottom: 8px;
    color: #3DF69B;
  }

  .feature strong {
    display: block;
    font-size: 14px;
    color: #F4F6F5;
  }

  .feature p {
    color: #8E9E96;
    font-size: 14px;
    margin: 6px 0 0;
    line-height: 1.5;
  }

  .snippet {
    background: #111915;
    border: 1px solid rgba(226, 240, 233, 0.09);
    border-radius: 14px;
    overflow: hidden;
    margin: 18px 0;
  }

  .snippettop {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 16px;
    border-bottom: 1px solid rgba(226, 240, 233, 0.09);
    color: #8E9E96;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
  }

  .copy-btn {
    background: #19281e;
    color: #3DF69B;
    border: 1px solid #31523e;
    border-radius: 7px;
    min-height: 32px;
    padding: 4px 10px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    cursor: pointer;
    transition: all .15s ease;
  }

  .copy-btn:hover {
    background: #233b2c;
    border-color: #3DF69B;
  }

  .snippet pre {
    white-space: pre !important;
    word-break: normal !important;
    overflow-x: auto;
    font-family: 'JetBrains Mono', monospace !important;
    font-size: 12px !important;
    line-height: 1.9 !important;
    color: #c5e6ce !important;
    padding: 15px 18px !important;
    margin: 0 !important;
    background: transparent !important;
    border: none !important;
    border-radius: 0 !important;
  }

  .tools {
    display: grid;
    gap: 11px;
    margin: 18px 0;
  }

  .tool {
    background: #111915;
    border: 1px solid rgba(226, 240, 233, 0.09);
    border-radius: 14px;
    overflow: hidden;
    transition: border-color .22s ease, background .22s ease;
  }

  .tool:hover {
    border-color: rgba(61, 246, 155, 0.3);
    background: #132219;
  }

  .tool summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 16px 20px;
    user-select: none;
  }

  .tool summary::-webkit-details-marker {
    display: none;
  }

  .tool summary strong {
    color: #d6f7e3;
    font-family: 'JetBrains Mono', monospace;
    font-size: 14px;
    font-weight: 600;
  }

  .tool summary small {
    display: block;
    color: #8E9E96;
    font-size: 12px;
    margin-top: 4px;
  }

  .tool summary .arrow {
    color: #3DF69B;
    transition: transform .2s ease;
    font-size: 14px;
    flex-shrink: 0;
  }

  .tool[open] summary .arrow {
    transform: rotate(180deg);
  }

  .tool .detail {
    border-top: 1px solid rgba(226, 240, 233, 0.09);
    padding: 16px 20px;
    color: #b1c0b6;
    font-size: 13px;
    line-height: 1.6;
    background: rgba(0, 0, 0, 0.2);
  }
</style>

<script>
  function setupDocsContent() {
    const content = document.querySelector<HTMLElement>('.docs-content');
    if (!content || content.dataset.enhanced === 'true') return;
    content.dataset.enhanced = 'true';
    document.querySelector<HTMLElement>('.docs-mobile-links [aria-current="page"]')?.scrollIntoView({ block: 'nearest', inline: 'center' });
    const toc = document.querySelector<HTMLElement>('.docs-toc');
    const tocNav = toc?.querySelector<HTMLElement>('nav[data-generated="true"]');
    if (tocNav) {
      const headings = Array.from(content.querySelectorAll<HTMLElement>('h2'));
      if (headings.length < 2 && toc) toc.style.display = 'none';
      else {
        for (const heading of headings) {
          if (!heading.id) {
            const slug = heading.textContent?.trim().toLowerCase().normalize('NFKD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || 'section';
            let id = slug;
            let suffix = 2;
            while (document.getElementById(id)) id = `${slug}-${suffix++}`;
            heading.id = id;
          }
          const link = document.createElement('a');
          link.href = `#${heading.id}`;
          link.className = 'block py-1.5 pl-3 border-l border-[rgba(226,240,233,0.12)] text-xs text-[#8E9E96] hover:text-[#3DF69B] hover:border-[#3DF69B] transition-colors';
          link.textContent = heading.textContent?.trim() || heading.id;
          tocNav.appendChild(link);
        }
      }
    }
    for (const pre of content.querySelectorAll<HTMLPreElement>('pre')) {
      if (pre.closest('.snippet') || pre.closest('.docs-code-wrapper')) continue;
      const wrapper = document.createElement('div');
      wrapper.className = 'docs-code-wrapper';
      pre.parentNode?.insertBefore(wrapper, pre);
      wrapper.appendChild(pre);
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'docs-copy-code';
      button.textContent = 'Copy';
      button.setAttribute('aria-label', 'Copy code');
      button.setAttribute('aria-live', 'polite');
      wrapper.appendChild(button);
    }
  }
  document.addEventListener('astro:page-load', setupDocsContent);
  document.addEventListener('DOMContentLoaded', setupDocsContent);
  function setupDocsSidebar() {
    const toggleBtn = document.getElementById('docs-sidebar-toggle');
    const closeBtn = document.getElementById('docs-sidebar-close');
    const sidebar = document.getElementById('docs-sidebar');
    const backdrop = document.getElementById('docs-sidebar-backdrop');
    const iconOpen = document.getElementById('docs-sidebar-icon-open');
    const iconClose = document.getElementById('docs-sidebar-icon-close');
    if (!toggleBtn || !sidebar || toggleBtn.dataset.sidebarInitialized === 'true') return;
    toggleBtn.dataset.sidebarInitialized = 'true';
    let backgroundState: { element: HTMLElement; inert: string | null; ariaHidden: string | null }[] = [];

    function isolateBackground() {
      const allowed = [sidebar, toggleBtn, backdrop].filter((element): element is HTMLElement => element instanceof HTMLElement);
      function isolate(parent: Element) {
        for (const child of parent.children) {
          if (!(child instanceof HTMLElement) || child.tagName === 'SCRIPT' || child.tagName === 'STYLE' || allowed.includes(child)) continue;
          if (allowed.some(element => child.contains(element))) {
            isolate(child);
          } else {
            backgroundState.push({ element: child, inert: child.getAttribute('inert'), ariaHidden: child.getAttribute('aria-hidden') });
            child.setAttribute('inert', '');
            child.setAttribute('aria-hidden', 'true');
          }
        }
      }
      isolate(document.body);
    }

    function restoreBackground() {
      for (const { element, inert, ariaHidden } of backgroundState) {
        if (inert === null) element.removeAttribute('inert');
        else element.setAttribute('inert', inert);
        if (ariaHidden === null) element.removeAttribute('aria-hidden');
        else element.setAttribute('aria-hidden', ariaHidden);
      }
      backgroundState = [];
    }

    function openSidebar() {
      sidebar?.classList.remove('-translate-x-full');
      sidebar?.classList.add('translate-x-0');
      sidebar?.classList.remove('invisible', 'pointer-events-none');
      sidebar?.classList.add('visible', 'pointer-events-auto');
      sidebar?.setAttribute('role', 'dialog');
      sidebar?.setAttribute('aria-modal', 'true');
      sidebar?.setAttribute('aria-label', 'Documentation navigation');
      backdrop?.classList.remove('opacity-0', 'pointer-events-none', 'invisible');
      backdrop?.classList.add('opacity-100', 'pointer-events-auto', 'visible');
      iconOpen?.classList.add('hidden');
      iconClose?.classList.remove('hidden');
      toggleBtn?.setAttribute('aria-expanded', 'true');
      toggleBtn?.setAttribute('aria-label', 'Close docs menu');
      document.body.classList.add('docs-sidebar-open');
      sidebar?.focus();
      isolateBackground();
      setTimeout(() => {
        if (toggleBtn?.getAttribute('aria-expanded') === 'true' && document.activeElement === sidebar) {
          sidebar?.querySelector<HTMLElement>('a')?.focus();
        }
      }, 0);
    }

    function closeSidebar(restoreFocus = false) {
      restoreBackground();
      sidebar?.classList.add('-translate-x-full');
      sidebar?.classList.remove('translate-x-0');
      sidebar?.classList.add('invisible', 'pointer-events-none');
      sidebar?.classList.remove('visible', 'pointer-events-auto');
      sidebar?.removeAttribute('role');
      sidebar?.removeAttribute('aria-modal');
      sidebar?.removeAttribute('aria-label');
      backdrop?.classList.add('opacity-0', 'pointer-events-none', 'invisible');
      backdrop?.classList.remove('opacity-100', 'pointer-events-auto', 'visible');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      toggleBtn?.setAttribute('aria-expanded', 'false');
      toggleBtn?.setAttribute('aria-label', 'Open docs menu');
      document.body.classList.remove('docs-sidebar-open');
      if (restoreFocus) toggleBtn?.focus();
    }

    toggleBtn?.addEventListener('click', () => {
      const isOpen = toggleBtn.getAttribute('aria-expanded') === 'true';
      if (isOpen) {
        closeSidebar(true);
      } else {
        openSidebar();
      }
    });

    closeBtn?.addEventListener('click', () => closeSidebar(true));
    backdrop?.addEventListener('click', () => closeSidebar(true));

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggleBtn?.getAttribute('aria-expanded') === 'true') {
        closeSidebar(true);
      }
      if (e.key === 'Tab' && toggleBtn?.getAttribute('aria-expanded') === 'true') {
        const focusables = Array.from(sidebar?.querySelectorAll<HTMLElement>('button, a') ?? []);
        if (focusables.length === 0) return;
        if (document.activeElement === sidebar) {
          e.preventDefault();
          (e.shiftKey ? focusables[focusables.length - 1] : focusables[0]).focus();
        } else if (e.shiftKey && document.activeElement === focusables[0]) {
          e.preventDefault();
          focusables[focusables.length - 1].focus();
        } else if (!e.shiftKey && document.activeElement === focusables[focusables.length - 1]) {
          e.preventDefault();
          focusables[0].focus();
        }
      }
    });

    sidebar?.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        closeSidebar(true);
      });
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth >= 768 && toggleBtn?.getAttribute('aria-expanded') === 'true') {
        closeSidebar();
      } else if (window.innerWidth < 768 && sidebar?.contains(document.activeElement) && toggleBtn?.getAttribute('aria-expanded') === 'false') {
        toggleBtn?.focus();
      }
    });
  }

  document.addEventListener('astro:page-load', setupDocsSidebar);
  document.addEventListener('DOMContentLoaded', setupDocsSidebar);

    // Clipboard copy helper
    document.addEventListener('click', async (e) => {
      const btn = (e.target as HTMLElement).closest('.copy-btn, .docs-copy-code');
      if (!btn) return;
      const source = btn.getAttribute('data-copy') || btn.parentElement?.querySelector('pre')?.textContent || '';
      const text = btn.closest('.install-panel') ? source.replace(/^(?:\$|PS>)\s?/gm, '') : source;
      if (!text) return;
      const orig = btn.textContent;
      try {
        if (navigator.clipboard?.writeText) await navigator.clipboard.writeText(text);
        else {
          const field = document.createElement('textarea');
          field.value = text;
          field.style.position = 'fixed';
          field.style.opacity = '0';
          document.body.appendChild(field);
          field.select();
          const copied = document.execCommand('copy');
          field.remove();
          if (!copied) throw new Error('Clipboard unavailable');
        }
        btn.textContent = 'Copied ✓';
        btn.setAttribute('aria-label', 'Code copied');
      } catch {
        btn.textContent = 'Copy failed';
        btn.setAttribute('aria-label', 'Copy failed');
      }
      setTimeout(() => { btn.textContent = orig; btn.setAttribute('aria-label', 'Copy code'); }, 1500);
    });
</script>
