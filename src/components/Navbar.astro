---
import { getBase } from '../utils/base.ts';
import Icon from './Icon.astro';
const base = getBase();

const navLinks = [
  { href: `${base}`, label: 'Home' },
  { href: `${base}features`, label: 'Features' },
  { href: `${base}integrations`, label: 'Integrations' },
  { href: `${base}docs/memory`, label: 'Docs' },
  { href: `${base}contributors`, label: 'Hall of Fame' },
  { href: 'https://github.com/Fmarzochi/EGC', label: 'GitHub', external: true },
];
---

<header id="site-header" class="sticky top-0 z-50 w-full border-b border-[rgba(226,240,233,0.09)] bg-[#0A0D0C]/90 backdrop-blur-md transition-transform duration-300 transform translate-y-0">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">

      <!-- Logo + brand -->
      <div class="flex items-center gap-3 shrink-0">
        <a href={base} class="flex items-center gap-2.5 min-h-[44px] group focus:outline-none focus-visible:ring-2 focus-visible:ring-[#3DF69B] rounded-md">
          <svg class="shrink-0" viewBox="0 0 480 480" width="28" height="28" aria-hidden="true" focusable="false">
            <defs>
              <linearGradient id="m-nav-p" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#B4F8D6"/>
                <stop offset=".46" stop-color="#4FF3A3"/>
                <stop offset="1" stop-color="#17A862"/>
              </linearGradient>
              <filter id="m-nav-e" x="-20%" y="-20%" width="140%" height="140%">
                <feDropShadow dx="0" dy="0" stdDeviation="7" flood-color="#04361F" flood-opacity=".42"/>
              </filter>
              <clipPath id="m-nav-q">
                <rect x="0" y="0" width="240" height="240"/>
              </clipPath>
            </defs>
            <g filter="url(#m-nav-e)">
              <circle cx="240" cy="130" r="100" fill="url(#m-nav-p)"/>
              <circle cx="350" cy="240" r="100" fill="url(#m-nav-p)"/>
              <circle cx="240" cy="350" r="100" fill="url(#m-nav-p)"/>
              <circle cx="130" cy="240" r="100" fill="url(#m-nav-p)"/>
              <g clip-path="url(#m-nav-q)"><circle cx="240" cy="130" r="100" fill="url(#m-nav-p)"/></g>
            </g>
            <circle cx="240" cy="240" r="29" fill="#05231A"/>
          </svg>
          <span class="font-extrabold text-xl tracking-tight text-[#F4F6F5] whitespace-nowrap">EGC</span>
        </a>
      </div>

      <!-- Desktop nav -->
      <nav class="hidden md:flex items-center gap-2" aria-label="Main navigation">
        {navLinks.map(link => (
          <a
            href={link.href}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener noreferrer' : undefined}
            aria-label={link.external ? `${link.label} (opens in new tab)` : undefined}
            class="px-3.5 py-1.5 rounded-full text-sm font-medium text-[#8E9E96] hover:text-[#3DF69B] hover:bg-white/[0.04] transition-colors duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#3DF69B]"
          >
            {link.label}
            {link.external && (
              <Icon name="external" size={12} class="inline-block ml-1 opacity-60" />
            )}
          </a>
        ))}
      </nav>

      <!-- Right side: CTA button + mobile hamburger -->
      <div class="flex items-center gap-3">
        <!-- Community links (desktop) -->
        <a
          href="https://discord.gg/FmXbgUmdmM"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Discord (opens in new tab)"
          class="hidden md:inline-flex items-center justify-center w-8 h-8 rounded-full border border-white/[0.08] bg-white/[0.02] text-[#8E9E96] hover:text-[#F4F6F5] hover:border-white/20 hover:bg-white/[0.06] transition-colors duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#3DF69B]"
        >
          <Icon name="discord" size={15} />
        </a>

        <!-- Official Brand CTA Button (Pill) -->
        <a
          href={`${base}get-started`}
          class="hidden sm:inline-flex items-center gap-2.5 min-h-[40px] pl-4 pr-1 rounded-full bg-[#FFFFFF] hover:bg-[#F4F6F5] text-[#06210F] font-bold text-xs transition-transform active:scale-[0.98] shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-[#3DF69B]"
        >
          <span>Get EGC</span>
          <span class="w-7 h-7 rounded-full bg-[#18B669] inline-flex items-center justify-center shrink-0">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2.6" stroke-linecap="round" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6"></path>
            </svg>
          </span>
        </a>

        <!-- Hamburger button (mobile only) -->
        <button
          id="mobile-menu-btn"
          type="button"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="md:hidden p-2.5 min-w-[44px] min-h-[44px] flex flex-col items-center justify-center gap-[5px] rounded-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-[#3DF69B] active:scale-95 transition-all duration-150"
        >
          <span class="block w-6 h-[2px] bg-[#F4F6F5] rounded-full transition-all duration-300 origin-center line-1"></span>
          <span class="block w-6 h-[2px] bg-[#F4F6F5] rounded-full transition-all duration-300 line-2"></span>
          <span class="block w-6 h-[2px] bg-[#F4F6F5] rounded-full transition-all duration-300 origin-center line-3"></span>
        </button>
      </div>
    </div>
  </div>
</header>

<!-- Backdrop overlay -->
<div
  id="mobile-backdrop"
  class="fixed inset-0 bg-black/70 backdrop-blur-sm z-[-1] opacity-0 pointer-events-none invisible transition-opacity duration-300 md:hidden"
  aria-hidden="true"
></div>

<!-- Mobile menu panel -->
<div
  id="mobile-menu"
  class="md:hidden fixed inset-0 top-[64px] border-t border-[rgba(226,240,233,0.09)] bg-[#0A0D0C] overflow-y-auto transition-all duration-300 ease-in-out opacity-0 pointer-events-none invisible z-40"
>
  <nav class="flex flex-col gap-2 px-6 py-8" aria-label="Mobile navigation">
    {navLinks.map((link, i) => (
      <a
        href={link.href}
        target={link.external ? '_blank' : undefined}
        rel={link.external ? 'noopener noreferrer' : undefined}
        aria-label={link.external ? `${link.label} (opens in new tab)` : undefined}
        class:list={[
          'mobile-nav-link flex items-center justify-between min-h-[48px] px-4 py-3 rounded-lg text-base font-medium text-[#F4F6F5] hover:text-[#3DF69B] hover:bg-white/[0.04] active:scale-[0.98] transition-all duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#3DF69B]',
          `mobile-nav-link-${i}`,
        ]}
      >
        <span>{link.label}</span>
        {link.external && (
          <Icon name="external" size={16} class="opacity-50" />
        )}
      </a>
    ))}

    <!-- Get EGC CTA in mobile menu -->
    <div class="mt-6 pt-6 border-t border-[rgba(226,240,233,0.09)] flex flex-col gap-3">
      <a
        href={`${base}get-started`}
        class="mobile-nav-link flex items-center justify-between min-h-[48px] px-6 py-2.5 rounded-full bg-[#FFFFFF] text-[#06210F] text-sm font-bold active:scale-[0.98] transition-all duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#3DF69B]"
      >
        <span>Get EGC</span>
        <span class="w-7 h-7 rounded-full bg-[#18B669] inline-flex items-center justify-center shrink-0">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2.6" stroke-linecap="round" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </span>
      </a>

      <a
        href="https://github.com/Fmarzochi/EGC"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Star on GitHub (opens in new tab)"
        class="mobile-nav-link flex items-center justify-center gap-2 min-h-[44px] px-4 py-2.5 rounded-full border border-white/20 bg-white/[0.04] text-[#F4F6F5] text-sm font-semibold hover:bg-white/10 active:scale-[0.98] transition-all duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#3DF69B]"
      >
        <Icon name="github" size={16} />
        GitHub
      </a>
    </div>
  </nav>
</div>

<script>
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const backdrop = document.getElementById('mobile-backdrop');

  function openMenu() {
    mobileMenuBtn?.setAttribute('aria-expanded', 'true');
    mobileMenuBtn?.setAttribute('aria-label', 'Close menu');
    mobileMenu?.classList.remove('opacity-0', 'pointer-events-none', 'invisible');
    mobileMenu?.classList.add('opacity-100', 'pointer-events-auto', 'visible');
    backdrop?.classList.remove('opacity-0', 'pointer-events-none', 'invisible');
    backdrop?.classList.add('opacity-100', 'pointer-events-auto', 'visible');
    document.body.style.overflow = 'hidden';

    const links = mobileMenu?.querySelectorAll('.mobile-nav-link');
    links?.forEach((link, i) => {
      const el = link as HTMLElement;
      el.style.opacity = '0';
      el.style.transform = 'translateY(-8px)';
      setTimeout(() => {
        el.style.transition = 'opacity 0.2s ease, transform 0.2s ease';
        el.style.opacity = '1';
        el.style.transform = 'translateY(0)';
      }, 50 + i * 40);
    });
  }

  function closeMenu() {
    mobileMenuBtn?.setAttribute('aria-expanded', 'false');
    mobileMenuBtn?.setAttribute('aria-label', 'Open menu');
    mobileMenu?.classList.add('opacity-0', 'pointer-events-none', 'invisible');
    mobileMenu?.classList.remove('opacity-100', 'pointer-events-auto', 'visible');
    backdrop?.classList.add('opacity-0', 'pointer-events-none', 'invisible');
    backdrop?.classList.remove('opacity-100', 'pointer-events-auto', 'visible');
    document.body.style.overflow = '';
  }

  function isMenuOpen(): boolean {
    return mobileMenuBtn?.getAttribute('aria-expanded') === 'true';
  }

  mobileMenuBtn?.addEventListener('click', () => {
    if (isMenuOpen()) {
      closeMenu();
    } else {
      openMenu();
    }
  });

  backdrop?.addEventListener('click', closeMenu);

  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      closeMenu();
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isMenuOpen()) {
      closeMenu();
      mobileMenuBtn?.focus();
    }
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth >= 768 && isMenuOpen()) {
      closeMenu();
    }
  });

  let lastScrollY = window.scrollY;
  let scrollTimeout: ReturnType<typeof setTimeout> | undefined;
  const header = document.getElementById('site-header');

  if (header) {
    window.addEventListener('scroll', () => {
      const currentScrollY = window.scrollY;

      if (scrollTimeout) clearTimeout(scrollTimeout);

      if (isMenuOpen()) {
        lastScrollY = currentScrollY;
        return;
      }

      if (currentScrollY > 64) {
        if (currentScrollY > lastScrollY) {
          header.classList.add('-translate-y-full');
          header.classList.remove('translate-y-0');
        } else {
          header.classList.add('translate-y-0');
          header.classList.remove('-translate-y-full');
        }
      } else {
        header.classList.add('translate-y-0');
        header.classList.remove('-translate-y-full');
      }

      lastScrollY = currentScrollY;

      scrollTimeout = setTimeout(() => {
        header.classList.add('translate-y-0');
        header.classList.remove('-translate-y-full');
      }, 250);
    }, { passive: true });
  }
</script>

<style>
  #mobile-menu-btn[aria-expanded="true"] .line-1 {
    transform: translateY(7px) rotate(45deg);
  }
  #mobile-menu-btn[aria-expanded="true"] .line-2 {
    opacity: 0;
  }
  #mobile-menu-btn[aria-expanded="true"] .line-3 {
    transform: translateY(-7px) rotate(-45deg);
  }

  #mobile-menu {
    z-index: 40;
  }
  #mobile-backdrop {
    z-index: 30;
  }
</style>
